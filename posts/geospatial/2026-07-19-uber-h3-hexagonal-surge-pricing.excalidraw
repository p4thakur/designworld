      "link": null,
      "locked": false,
      "text": "ROW 2 — THE FIX: A HEX GRID BUILT FOR UNIFORM NEIGHBORS",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW 2 — THE FIX: A HEX GRID BUILT FOR UNIFORM NEIGHBORS",

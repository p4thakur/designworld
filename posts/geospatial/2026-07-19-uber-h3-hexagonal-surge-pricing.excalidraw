      "link": null,
      "locked": false,
      "text": "THE HIERARCHY\n\nH3: 16 resolutions, each child cell ~1/7 the area of its parent. Edge length runs ~1,108km (res 0) down to under a meter (res 15).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b2",
      "originalText": "THE HIERARCHY\n\nH3: 16 resolutions, each child cell ~1/7 the area of its parent. Edge length runs ~1,108km (res 0) down to under a meter (res 15).",
      "lineHeight": 1.3
    },

      "boundElements": null,
      "updated": 1752969600000,
      "link": null,
      "locked": false,
      "text": "ONE SHAPE, ONE DISTANCE\n\nHexagons are the only regular tiling where every neighbor shares an edge, at the same distance. 6 neighbors, 1 distance, no diagonals.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b1",
      "originalText": "ONE SHAPE, ONE DISTANCE\n\nHexagons are the only regular tiling where every neighbor shares an edge, at the same distance. 6 neighbors, 1 distance, no diagonals.",
      "lineHeight": 1.3
    },

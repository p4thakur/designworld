      "updated": 1752969600000,
      "link": null,
      "locked": false,
      "text": "THE EDGE EFFECT\n\nA rider 40m from a zone line could pay double the person next to them. Drivers idled inside the high-price zone instead of crossing for a normal fare.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b2",
      "originalText": "THE EDGE EFFECT\n\nA rider 40m from a zone line could pay double the person next to them. Drivers idled inside the high-price zone instead of crossing for a normal fare.",
      "lineHeight": 1.3
    },

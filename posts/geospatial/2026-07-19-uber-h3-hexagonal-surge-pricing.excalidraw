      "link": null,
      "locked": false,
      "text": "THE CONSEQUENCE\n\nCan't smoothly interpolate a price across neighbors when the neighbor distance depends on which of 8 directions you look. Boundaries stay hard.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b4",
      "originalText": "THE CONSEQUENCE\n\nCan't smoothly interpolate a price across neighbors when the neighbor distance depends on which of 8 directions you look. Boundaries stay hard.",
      "lineHeight": 1.3
    },

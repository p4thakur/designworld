      "updated": 1752969600000,
      "link": null,
      "locked": false,
      "text": "THE ZONE MAP\n\nPre-H3, Uber priced surge by geofenced city zones. A rider's multiplier was a polygon lookup: which zone are you standing in.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b1",
      "originalText": "THE ZONE MAP\n\nPre-H3, Uber priced surge by geofenced city zones. A rider's multiplier was a polygon lookup: which zone are you standing in.",
      "lineHeight": 1.3
    },

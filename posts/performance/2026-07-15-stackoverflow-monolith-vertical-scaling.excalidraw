    {
      "id": "t_right",
      "type": "text",
      "x": 640,
      "y": 116,
      "width": 510,
      "height": 148,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752537600000,
      "link": null,
      "locked": false,
      "text": "WHAT STACK OVERFLOW ACTUALLY BUILT\n\nOne monolith, one app pool, running the entire Q&A network.\nOn-prem hardware, specced per job — SQL boxes with NVMe and\n384-768GB RAM, web tier at 64GB RAM and 12 cores each.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "WHAT STACK OVERFLOW ACTUALLY BUILT\n\nOne monolith, one app pool, running the entire Q&A network.\nOn-prem hardware, specced per job — SQL boxes with NVMe and\n384-768GB RAM, web tier at 64GB RAM and 12 cores each.",
      "lineHeight": 1.3
    },

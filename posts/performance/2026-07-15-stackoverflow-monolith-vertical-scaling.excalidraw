      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752537600000,
      "link": null,
      "locked": false,
      "text": "TRAFFIC — ONE DAY, NINE WEB SERVERS (FEB 9, 2016)\n209.4M HTTP requests · 66.3M page loads · 504.8M SQL queries · 5.8B Redis hits · 17.2M Elasticsearch searches\nQuestion pages rendered server-side in 22.71ms average.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "TRAFFIC — ONE DAY, NINE WEB SERVERS (FEB 9, 2016)\n209.4M HTTP requests · 66.3M page loads · 504.8M SQL queries · 5.8B Redis hits · 17.2M Elasticsearch searches\nQuestion pages rendered server-side in 22.71ms average.",
      "lineHeight": 1.3
    },
    {

    {
      "id": "t_left",
      "type": "text",
      "x": 50,
      "y": 116,
      "width": 510,
      "height": 148,
      "angle": 0,
      "strokeColor": "#164e63",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752537600000,
      "link": null,
      "locked": false,
      "text": "THE DEFAULT PLAYBOOK\n\nBreak the monolith into microservices. Move to the cloud. Scale out\nhorizontally as traffic grows. Add nodes when a server nears its ceiling.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "THE DEFAULT PLAYBOOK\n\nBreak the monolith into microservices. Move to the cloud. Scale out\nhorizontally as traffic grows. Add nodes when a server nears its ceiling.",
      "lineHeight": 1.3
    },
    {

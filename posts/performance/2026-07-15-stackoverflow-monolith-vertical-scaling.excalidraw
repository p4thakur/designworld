    {
      "id": "t_capacity",
      "type": "text",
      "x": 50,
      "y": 435,
      "width": 1100,
      "height": 70,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752537600000,
      "link": null,
      "locked": false,
      "text": "THE CAPACITY THAT WAS NEVER USED\nSQL servers: 5-10% CPU, almost always. Redis: ~160 billion ops/month, under 2% CPU per instance.\nThe bottleneck horizontal scaling and microservices exist to solve never actually showed up.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "THE CAPACITY THAT WAS NEVER USED\nSQL servers: 5-10% CPU, almost always. Redis: ~160 billion ops/month, under 2% CPU per instance.\nThe bottleneck horizontal scaling and microservices exist to solve never actually showed up.",
      "lineHeight": 1.3
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 540,
      "width": 1140,
      "height": 50,
      "angle": 0,
      "strokeColor": "#44403c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752537600000,
      "link": null,
      "locked": false,
      "text": "Microservices and cloud autoscaling solve real problems — team autonomy, isolated deploys, bursty load. Stack\nOverflow didn't have those problems. It had predictable traffic and engineers who measured the ceiling first.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Microservices and cloud autoscaling solve real problems — team autonomy, isolated deploys, bursty load. Stack\nOverflow didn't have those problems. It had predictable traffic and engineers who measured the ceiling first.",
      "lineHeight": 1.2
    }
  ],

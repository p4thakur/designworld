    {
      "id": "t_stats",
      "type": "text",
      "x": 50,
      "y": 315,
      "width": 1100,
      "height": 70,
      "angle": 0,
      "strokeColor": "#701a75",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,

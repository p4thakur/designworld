    {
      "id": "callout-text-1",
      "type": "text",
      "x": 65,
      "y": 445,
      "width": 1030,
      "height": 100,
      "angle": 0,
      "strokeColor": "#0b3d6b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Ruby's own MJIT compiles a whole method once, for the general case, it barely helped real Rails apps.\nA typical Rails method gets called with a dozen different argument shapes across one request, so\nMJIT's single guess keeps missing. YJIT compiles small blocks lazily, one specialized version per\nshape actually seen at runtime, so it never has to guess ahead of time.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ruby's own MJIT compiles a whole method once, for the general case, it barely helped real Rails apps.\nA typical Rails method gets called with a dozen different argument shapes across one request, so\nMJIT's single guess keeps missing. YJIT compiles small blocks lazily, one specialized version per\nshape actually seen at runtime, so it never has to guess ahead of time.",
      "lineHeight": 1.25
    },

      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "what Shopify built\n\nYJIT: a JIT compiler\nliving inside CRuby\n\nLazy Basic Block Versioning\ncompiles per-block, per-type\nonly the shapes actually seen\nat runtime get compiled",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "what Shopify built\n\nYJIT: a JIT compiler\nliving inside CRuby\n\nLazy Basic Block Versioning\ncompiles per-block, per-type\nonly the shapes actually seen\nat runtime get compiled",
      "lineHeight": 1.25
    },

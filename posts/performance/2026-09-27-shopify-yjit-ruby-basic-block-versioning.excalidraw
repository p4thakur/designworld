      "updated": 1,
      "link": null,
      "locked": false,
      "text": "the \"obvious\" fix\n\nRewrite the hot path\nin Go, Rust, or Java\n\n+ new runtime to operate\n+ rewrite years of Rails code\n+ lose Ruby's gem ecosystem",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",

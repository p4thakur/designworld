      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785456000000,
      "link": null,
      "locked": false,
      "text": "Feb 2013 — how a shared-nothing router mesh that scaled perfectly well also drifted into statistically random dispatch",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Feb 2013 — how a shared-nothing router mesh that scaled perfectly well also drifted into statistically random dispatch",
      "lineHeight": 1.25

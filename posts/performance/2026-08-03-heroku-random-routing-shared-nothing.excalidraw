    },
    {
      "id": "e_caption",
      "type": "text",
      "x": 40,
      "y": 548,
      "width": 1120,
      "height": 80,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785456000000,
      "link": null,
      "locked": false,
      "text": "Router 12 and Router 47 have never exchanged a message about Dyno B's queue. Each independently sees it as\nidle right now, so both dispatch in the same instant. Dyno A and Dyno C, actually idle, get nothing. With enough\nindependent routers deciding this way, the aggregate outcome converges to statistically random placement —\nno matter how \"intelligent\" any single router's local logic is.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Router 12 and Router 47 have never exchanged a message about Dyno B's queue. Each independently sees it as idle right now, so both dispatch in the same instant. Dyno A and Dyno C, actually idle, get nothing. With enough independent routers deciding this way, the aggregate outcome converges to statistically random placement — no matter how \"intelligent\" any single router's local logic is.",
      "lineHeight": 1.35
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 40,
      "y": 638,
      "width": 1120,
      "height": 55,
      "angle": 0,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785456000000,
      "link": null,
      "locked": false,
      "text": "Heroku's dynos ran single-threaded Unicorn: one request at a time. A request that lands behind a 15-second request\ntakes 15.1 seconds to finish, even with an idle dyno two racks over. Oren Teich, Heroku GM, Feb 2013: \"We failed to\nexplain how our product works. We failed to help our customers scale. We failed our community at large.\"",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Heroku's dynos ran single-threaded Unicorn: one request at a time. A request that lands behind a 15-second request takes 15.1 seconds to finish, even with an idle dyno two racks over. Oren Teich, Heroku GM, Feb 2013: \"We failed to explain how our product works. We failed to help our customers scale. We failed our community at large.\"",
      "lineHeight": 1.3
    }
  ],

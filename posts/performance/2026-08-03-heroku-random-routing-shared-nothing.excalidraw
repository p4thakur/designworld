      "updated": 1785456000000,
      "link": null,
      "locked": false,
      "text": "Heroku Sold \"Intelligent Routing\" for Three Years After It Quietly Became Random",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Heroku Sold \"Intelligent Routing\" for Three Years After It Quietly Became Random",
      "lineHeight": 1.25
    },
    {

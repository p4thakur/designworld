    {
      "id": "e_narrative",
      "type": "text",
      "x": 40,
      "y": 195,
      "width": 1120,
      "height": 100,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785456000000,
      "link": null,
      "locked": false,
      "text": "2007-2009 — few routers; each one's local view of dyno state is close enough to the whole fleet's truth. Routing is genuinely idle-aware.\n2010 — the router fleet grows with traffic, but no shared queue-state is added between nodes. Routing quietly drifts toward random, undocumented.\nFeb 2013 — Rap Genius's \"Heroku's Ugly Secret\" goes viral; GM Oren Teich admits it publicly.\nRouter 2.0, later — keep-alive connections and AZ-aware bias cut overhead. The routers still don't share queue depth.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2007-2009 — few routers; each one's local view of dyno state is close enough to the whole fleet's truth. Routing is genuinely idle-aware.\n2010 — the router fleet grows with traffic, but no shared queue-state is added between nodes. Routing quietly drifts toward random, undocumented.\nFeb 2013 — Rap Genius's \"Heroku's Ugly Secret\" goes viral; GM Oren Teich admits it publicly.\nRouter 2.0, later — keep-alive connections and AZ-aware bias cut overhead. The routers still don't share queue depth.",
      "lineHeight": 1.35
    },

    {
      "id": "e17",
      "type": "text",
      "x": 78,
      "y": 452,
      "width": 523.6,
      "height": 85.0,
      "angle": 0,
      "strokeColor": "#44403c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 17,
      "version": 1,
      "versionNonce": 17,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why 64 MiB?  free() finds a chunk's arena with one mask:\n  heap = PTR_ALIGN_DOWN(ptr, 64 MiB)\nNo table, no lock. The alignment that makes free() cheap\nis the same thing that inflates VSZ.",
      "originalText": "Why 64 MiB?  free() finds a chunk's arena with one mask:\n  heap = PTR_ALIGN_DOWN(ptr, 64 MiB)\nNo table, no lock. The alignment that makes free() cheap\nis the same thing that inflates VSZ.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "id": "e18",
      "type": "text",
      "x": 800,
      "y": 470,
      "width": 316.8,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#92400e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 18,
      "version": 1,
      "versionNonce": 18,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Nothing was designed wrong.\nThe way we count memory changed.",
      "originalText": "Nothing was designed wrong.\nThe way we count memory changed.",

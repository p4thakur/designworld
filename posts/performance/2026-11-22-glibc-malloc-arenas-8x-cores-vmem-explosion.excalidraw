      "updated": 1,
      "link": null,
      "locked": false,
      "text": "cores read from\n/sys/devices/system/cpu/online\n\n2-CPU pod, 64-core host\n-> 512-arena cap\n(quota is ignored)",
      "originalText": "cores read from\n/sys/devices/system/cpu/online\n\n2-CPU pod, 64-core host\n-> 512-arena cap\n(quota is ignored)",

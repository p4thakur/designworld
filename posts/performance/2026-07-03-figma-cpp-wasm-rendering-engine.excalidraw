      "updated": 1751500800000,
      "link": null,
      "locked": false,
      "text": "WASM parses ~20x faster than asm.js. Browsers cache the native translation, so a second load has virtually\nno load time. Download size barely changed — the win was parse/compile time, not bytes over the wire.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "b_callout",
      "originalText": "WASM parses ~20x faster than asm.js. Browsers cache the native translation, so a second load has virtually\nno load time. Download size barely changed — the win was parse/compile time, not bytes over the wire.",
      "lineHeight": 1.3
    },

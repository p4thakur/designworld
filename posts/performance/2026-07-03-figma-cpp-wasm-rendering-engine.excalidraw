      "link": null,
      "locked": false,
      "text": "2D Canvas API\nFaster than the DOM, but no built-in\nGPU compositing, blending, or tiling.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_l2",
      "originalText": "2D Canvas API\nFaster than the DOM, but no built-in\nGPU compositing, blending, or tiling.",
      "lineHeight": 1.3
    },

      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752796800000,
      "link": null,
      "locked": false,
      "text": "THE DESIGN\n\nKetama consistent hash: hash space split into large contiguous buckets, one per memcached host. Key → host is deterministic.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b1",
      "originalText": "THE DESIGN\n\nKetama consistent hash: hash space split into large contiguous buckets, one per memcached host. Key → host is deterministic.",
      "lineHeight": 1.3
    },

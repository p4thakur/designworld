      "updated": 1752796800000,
      "link": null,
      "locked": false,
      "text": "THE HOT KEY\n\nSame guarantee, now a liability: one listing's cached page data gets hit hard enough alone to saturate memcached01's NIC.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b3",
      "originalText": "THE HOT KEY\n\nSame guarantee, now a liability: one listing's cached page data gets hit hard enough alone to saturate memcached01's NIC.",
      "lineHeight": 1.3
    },

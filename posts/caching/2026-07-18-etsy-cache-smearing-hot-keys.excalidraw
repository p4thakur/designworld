      "link": null,
      "locked": false,
      "text": "Etsy's Cache Smearing: When Consistent Hashing's Best Feature Becomes the Bottleneck",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Etsy's Cache Smearing: When Consistent Hashing's Best Feature Becomes the Bottleneck",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 54,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

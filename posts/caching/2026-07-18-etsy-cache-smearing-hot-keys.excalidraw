    {
      "id": "r1_t1",
      "type": "text",
      "x": 42,
      "y": 126,
      "width": 236,
      "height": 124,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

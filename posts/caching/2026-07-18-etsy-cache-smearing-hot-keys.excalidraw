      "updated": 1752796800000,
      "link": null,
      "locked": false,
      "text": "RESULT\n\nHot value's read volume splits across up to 16 hosts. No single host carries more than its share.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b4",
      "originalText": "RESULT\n\nHot value's read volume splits across up to 16 hosts. No single host carries more than its share.",
      "lineHeight": 1.3
    },
    {

      "locked": false,
      "text": "ROW 1 — THE MECHANISM, AND WHERE IT SILENTLY BREAKS",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW 1 — THE MECHANISM, AND WHERE IT SILENTLY BREAKS",

      "boundElements": null,
      "updated": 1752796800000,
      "link": null,
      "locked": false,
      "text": "THE PROMISE\n\nResize the pool and only the keys in the changed host's slice remap. No mass rehash, no stampede. Years of painless scaling.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b2",
      "originalText": "THE PROMISE\n\nResize the pool and only the keys in the changed host's slice remap. No mass rehash, no stampede. Years of painless scaling.",
      "lineHeight": 1.3
    },

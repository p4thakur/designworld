      "locked": false,
      "text": "REDISTRIBUTE\n\nSame Ketama hash, untouched, now applied to up to 16 different key strings — each lands on a different host.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b3",
      "originalText": "REDISTRIBUTE\n\nSame Ketama hash, untouched, now applied to up to 16 different key strings — each lands on a different host.",
      "lineHeight": 1.3
    },

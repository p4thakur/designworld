      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752796800000,
      "link": null,
      "locked": false,
      "text": "1 key → 1 host, always  ·  memcached01 hit 960 Mbps on a 1 Gbps NIC  ·  fix: 1 key → 16 keys",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 key → 1 host, always  ·  memcached01 hit 960 Mbps on a 1 Gbps NIC  ·  fix: 1 key → 16 keys",
      "lineHeight": 1.25
    },

    {
      "id": "t_mech",
      "type": "text",
      "x": 50,
      "y": 495,
      "width": 1090,
      "height": 92,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

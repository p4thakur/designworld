      "boundElements": null,
      "updated": 1752796800000,
      "link": null,
      "locked": false,
      "text": "THE SPIKE\n\nOutbound > 800Mbps: p90 latency 5ms → 35ms. NIC saturates near 960Mbps (1Gbps card): latency > 200ms.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b4",
      "originalText": "THE SPIKE\n\nOutbound > 800Mbps: p90 latency 5ms → 35ms. NIC saturates near 960Mbps (1Gbps card): latency > 200ms.",
      "lineHeight": 1.3
    },

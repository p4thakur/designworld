   "link": null,
   "locked": false,
   "text": "24 GB instance -> page table = 24 GB / 4 kB x 8 B = 48 MB\ncopied by the main thread on every BGSAVE or AOF rewrite.\nEnable transparent huge pages and COW can touch almost all memory.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 20,
   "containerId": null,
   "originalText": "24 GB instance -> page table = 24 GB / 4 kB x 8 B = 48 MB\ncopied by the main thread on every BGSAVE or AOF rewrite.\nEnable transparent huge pages and COW can touch almost all memory.",
   "lineHeight": 1.25
  }

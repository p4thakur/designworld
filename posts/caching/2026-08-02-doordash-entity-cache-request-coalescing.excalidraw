      "boundElements": null,
      "updated": 1754092800000,
      "link": null,
      "locked": false,
      "text": "STEP 3\nALL of them independently call Upstream Service X at once — thundering herd hits an already-struggling service",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "STEP 3\nALL of them independently call Upstream Service X at once — thundering herd hits an already-struggling service",
      "lineHeight": 1.3
    },
    {
      "id": "b_after3",
      "type": "rectangle",
      "x": 620,

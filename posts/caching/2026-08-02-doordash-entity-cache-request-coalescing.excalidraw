      "updated": 1754092800000,
      "link": null,
      "locked": false,
      "text": "DoorDash's Caches Kept Missing at the Same Moment. The Fix Wasn't a Bigger Cache.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DoorDash's Caches Kept Missing at the Same Moment. The Fix Wasn't a Bigger Cache.",
      "lineHeight": 1.25
    },

      "updated": 1754092800000,
      "link": null,
      "locked": false,
      "text": "STEP 2\nFirst miss takes a single-flight lock — every other concurrent request for that entity WAITS on that one in-flight call",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "STEP 2\nFirst miss takes a single-flight lock — every other concurrent request for that entity WAITS on that one in-flight call",
      "lineHeight": 1.3
    },

      "text": "STEP 2\n100 other pods hit the SAME TTL window — all miss the same entity within the same breath",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "STEP 2\n100 other pods hit the SAME TTL window — all miss the same entity within the same breath",

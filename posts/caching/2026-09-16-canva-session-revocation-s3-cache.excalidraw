      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pods binary-search small, pre-sorted\n16-byte record chunks straight from S3.\nMySQL read replicas: down to 2,\nkept only for redundancy.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pods binary-search small, pre-sorted\n16-byte record chunks straight from S3.\nMySQL read replicas: down to 2,\nkept only for redundancy.",

      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2016 — PELIKAN\nUNIFIES THEM\n\nTwemcache (reads) + Redis/\nNighthawk (structure) = two\nstacks, two bug classes. Fix:\none modular, lock-free\nframework.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2016 — PELIKAN\nUNIFIES THEM\n\nTwemcache (reads) + Redis/\nNighthawk (structure) = two\nstacks, two bug classes. Fix:\none modular, lock-free\nframework.",
      "lineHeight": 1.25
    },
    {

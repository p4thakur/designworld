      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Twitter's Cache Handled 2 Trillion Queries a Day. It Was Still Solving the Wrong Problem.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Twitter's Cache Handled 2 Trillion Queries a Day. It Was Still Solving the Wrong Problem.",
      "lineHeight": 1.25
    },

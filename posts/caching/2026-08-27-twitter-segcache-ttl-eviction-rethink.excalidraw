      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Nobody had gotten Memcached \"wrong.\" The industry had just spent three decades answering a question\nTwitter's actual production traffic wasn't really asking.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nobody had gotten Memcached \"wrong.\" The industry had just spent three decades answering a question\nTwitter's actual production traffic wasn't really asking.",

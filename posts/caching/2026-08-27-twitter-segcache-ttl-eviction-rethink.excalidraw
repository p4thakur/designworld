      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2020 — THE\nUNCOMFORTABLE TRUTH\n\nCache team analyzes traces\nfrom hundreds of its own live\nclusters. Eviction algorithm\nchoice barely matters — TTL\nexpires objects first.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2020 — THE\nUNCOMFORTABLE TRUTH\n\nCache team analyzes traces\nfrom hundreds of its own live\nclusters. Eviction algorithm\nchoice barely matters — TTL\nexpires objects first.",
      "lineHeight": 1.25
    },

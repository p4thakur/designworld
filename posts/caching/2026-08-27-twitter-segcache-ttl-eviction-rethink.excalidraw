    {
      "id": "stat-text",
      "type": "text",
      "x": 60,
      "y": 393,
      "width": 1060,
      "height": 84,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE NUMBERS: 5 bytes of metadata per object — a 91% cut vs. Memcached. Up to 60% less memory on\nsmall-object, TTL-heavy workloads. Comparable throughput to Twitter's existing production cache, with\nbetter write scalability.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE NUMBERS: 5 bytes of metadata per object — a 91% cut vs. Memcached. Up to 60% less memory on\nsmall-object, TTL-heavy workloads. Comparable throughput to Twitter's existing production cache, with\nbetter write scalability.",
      "lineHeight": 1.25
    },

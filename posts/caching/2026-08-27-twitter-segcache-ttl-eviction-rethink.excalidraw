      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2012 — TWEMCACHE\nIS BORN\n\nTwitter forks Memcached.\nHundreds of servers, 20TB+\ndata, 30+ services, ~2\ntrillion queries a day.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2012 — TWEMCACHE\nIS BORN\n\nTwitter forks Memcached.\nHundreds of servers, 20TB+\ndata, 30+ services, ~2\ntrillion queries a day.",
      "lineHeight": 1.25
    },

      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2021 — SEGCACHE\nSHIPS\n\nObjects grouped by creation/\nexpiration time into shared\nsegments. 5 bytes metadata/\nobject. NSDI Community\nAward.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",

    {
      "id": "text1",
      "type": "text",
      "x": 80,
      "y": 116,
      "width": 300,
      "height": 190,
      "angle": 0,
      "strokeColor": "#d9480f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SET-ASSOCIATIVE\n(Facebook's existing\nphoto cache design)\n\nWrites object direct\nto its slot\n\nLow DRAM overhead\n\nBUT flash writes in\nmulti-KB pages:\n~40x more bytes\nwritten than a\n100-byte object needs",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SET-ASSOCIATIVE\n(Facebook's existing\nphoto cache design)\n\nWrites object direct\nto its slot\n\nLow DRAM overhead\n\nBUT flash writes in\nmulti-KB pages:\n~40x more bytes\nwritten than a\n100-byte object needs",
      "lineHeight": 1.25
    },
    {
      "id": "box2",
      "type": "rectangle",
      "x": 460,
      "y": 100,
      "width": 340,
      "height": 220,

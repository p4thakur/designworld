    },
    {
      "id": "text2",
      "type": "text",
      "x": 480,
      "y": 116,
      "width": 300,
      "height": 190,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "LOG-STRUCTURED\n\nBatches writes\nsequentially onto flash\n\nNear-optimal flash\nwrite volume\n\nBUT needs 1 DRAM\nindex entry per object\n\nAt billions of tiny\nobjects, the index\ncosts more DRAM than\nflash was meant to save",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LOG-STRUCTURED\n\nBatches writes\nsequentially onto flash\n\nNear-optimal flash\nwrite volume\n\nBUT needs 1 DRAM\nindex entry per object\n\nAt billions of tiny\nobjects, the index\ncosts more DRAM than\nflash was meant to save",
      "lineHeight": 1.25
    },

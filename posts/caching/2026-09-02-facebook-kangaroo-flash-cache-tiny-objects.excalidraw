      "link": null,
      "locked": false,
      "text": "Facebook: Caching a 100-Byte Object Without Wasting DRAM or Flash",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Facebook: Caching a 100-Byte Object Without Wasting DRAM or Flash",
      "lineHeight": 1.25
    },
    {
      "id": "box1",
      "type": "rectangle",
      "x": 60,
      "y": 100,

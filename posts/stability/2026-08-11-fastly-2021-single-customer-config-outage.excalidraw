      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "One Customer Made a Completely Normal Config Change. It Broke 85% of Fastly's Network in a Minute.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One Customer Made a Completely Normal Config Change. It Broke 85% of Fastly's Network in a Minute.",
      "lineHeight": 1.25
    },
    {

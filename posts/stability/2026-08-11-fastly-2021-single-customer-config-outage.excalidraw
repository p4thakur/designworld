      "boundElements": null,
      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "Fastly's propagation system does exactly its job: pushes the change to the global edge fleet, fast. 85% of the network starts returning errors within about a minute.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fastly's propagation system does exactly its job: pushes the change to the global edge fleet, fast. 85% of the network starts returning errors within about a minute.",
      "lineHeight": 1.25
    },

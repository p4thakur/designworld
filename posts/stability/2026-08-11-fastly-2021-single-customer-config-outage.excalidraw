      "isDeleted": false,
      "boundElements": null,
      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "Fastly's own postmortem: a dormant bug from a deployment 27 days earlier, tripped by an ordinary, legitimate customer action \u2014 not a mistake, not an attack",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fastly's own postmortem: a dormant bug from a deployment 27 days earlier, tripped by an ordinary, legitimate customer action \u2014 not a mistake, not an attack",
      "lineHeight": 1.25
    },

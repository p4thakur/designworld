      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "May 12, 2021. A routine software deployment ships. It quietly introduces a bug in how one category of customer configuration gets validated during compilation. No test exercises that path.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "May 12, 2021. A routine software deployment ships. It quietly introduces a bug in how one category of customer configuration gets validated during compilation. No test exercises that path.",
      "lineHeight": 1.25
    },

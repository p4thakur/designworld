      "boundElements": null,
      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "27 days pass. Nothing triggers it. Deploys keep shipping, customers keep changing configs. The bug just needs one specific, ordinary combination it hasn't seen yet.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "27 days pass. Nothing triggers it. Deploys keep shipping, customers keep changing configs. The bug just needs one specific, ordinary combination it hasn't seen yet.",
      "lineHeight": 1.25
    },

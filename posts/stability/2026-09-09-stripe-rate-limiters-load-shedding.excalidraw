      "updated": 1,
      "link": null,
      "locked": false,
      "text": "CONCURRENCY LIMITER\nPer account\n\nMax 100 in-flight\nrequests. Redis\nsorted set — add ID\non start, remove\non finish.\n\nSolves: many slow\nrequests at once.",
      "fontSize": 13,
      "fontFamily": 1,

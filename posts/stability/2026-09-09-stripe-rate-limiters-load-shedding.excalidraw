      "updated": 1,
      "link": null,
      "locked": false,
      "text": "⚡ UTILIZATION SHEDDER\nThe dangerous one\n\nDead zone: 0.7–0.8\nutilization.\n28s delay before\nshedding starts.\nRamp capped at\n1/120th per second.\n\nReact faster and\nthe shedder itself\nstarts oscillating.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚡ UTILIZATION SHEDDER\nThe dangerous one\n\nDead zone: 0.7–0.8\nutilization.\n28s delay before\nshedding starts.\nRamp capped at\n1/120th per second.\n\nReact faster and\nthe shedder itself\nstarts oscillating.",
      "lineHeight": 1.25
    },

      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WHAT RAN INSTEAD\nApril 5, 2022, 07:38 UTC\n\nInput: a list of site_id\nMode: permanently-delete\n(hard, no undo)\n\nSame API took both ID\ntypes and trusted the\ncaller — no check that\nthe list matched the mode.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHAT RAN INSTEAD\nApril 5, 2022, 07:38 UTC\n\nInput: a list of site_id\nMode: permanently-delete\n(hard, no undo)\n\nSame API took both ID\ntypes and trusted the\ncaller — no check that\nthe list matched the mode.",
      "lineHeight": 1.25
    },

      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "23 MINUTES\n07:38 – 08:01 UTC\n\n883 full Jira/Confluence\nCloud sites deleted\noutright.\n\n775 paying customers\nlocked out instantly.\n~400 orgs' data actually\nerased, not just access.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "23 MINUTES\n07:38 – 08:01 UTC\n\n883 full Jira/Confluence\nCloud sites deleted\noutright.\n\n775 paying customers\nlocked out instantly.\n~400 orgs' data actually\nerased, not just access.",
      "lineHeight": 1.25
    },
    {

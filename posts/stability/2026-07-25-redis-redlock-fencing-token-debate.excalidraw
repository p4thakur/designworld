      "boundElements": null,
      "updated": 1753401600000,
      "link": null,
      "locked": false,
      "text": "T+0.1s\nCLIENT 1 FREEZES\n\nStop-the-world GC pause, ~30s. No CPU, no network, no idea time is passing.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T+0.1s\nCLIENT 1 FREEZES\n\nStop-the-world GC pause, ~30s. No CPU, no network, no idea time is passing.",
      "lineHeight": 1.25
    },

      "updated": 1753401600000,
      "link": null,
      "locked": false,
      "text": "T+10s\nLEASE EXPIRES\n\nClient 1's TTL lapses on the Redis side while it's still frozen. The key is now free.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T+10s\nLEASE EXPIRES\n\nClient 1's TTL lapses on the Redis side while it's still frozen. The key is now free.",
      "lineHeight": 1.25
    },

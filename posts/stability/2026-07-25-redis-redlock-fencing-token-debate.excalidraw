      "link": null,
      "locked": false,
      "text": "T+10.2s\nCLIENT 2 ACQUIRES\n\nSees the key free, wins its own majority, starts writing to the shared resource.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",

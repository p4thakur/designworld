      "boundElements": null,
      "updated": 1753401600000,
      "link": null,
      "locked": false,
      "text": "T+0s\nCLIENT 1 ACQUIRES\n\nRequests the lock on 5 independent Redis masters. Wins majority, 3 of 5. 10s TTL lease starts.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "T+0s\nCLIENT 1 ACQUIRES\n\nRequests the lock on 5 independent Redis masters. Wins majority, 3 of 5. 10s TTL lease starts.",
      "lineHeight": 1.25
    },

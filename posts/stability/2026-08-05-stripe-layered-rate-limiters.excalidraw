    {
      "id": "e_head3",
      "type": "text",
      "x": 902,
      "y": 110,
      "width": 241,
      "height": 40,
      "angle": 0,
      "strokeColor": "#b91c1c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785715200000,
      "link": null,
      "locked": false,
      "text": "LAYER 4 \u2014 WORKER UTILIZATION\nSHEDDER (global)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LAYER 4 \u2014 WORKER UTILIZATION\nSHEDDER (global)",
      "lineHeight": 1.25
    },
    {
      "id": "e_body3",
      "type": "text",
      "x": 902,
      "y": 158,
      "width": 241,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785715200000,
      "link": null,
      "locked": false,
      "text": "Probabilistic shed based on\nactual worker utilization.\n\n0.7 = good, 0.8 = bad.\n\nRamps drop probability 0%\u2192\n100% over 92s (28s grace,\nfull shed by 120s) \u2014 a hard\ncutoff at one number\noscillates; a ramp damps it.",
      "fontSize": 11.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Probabilistic shed based on\nactual worker utilization.\n\n0.7 = good, 0.8 = bad.\n\nRamps drop probability 0%\u2192\n100% over 92s (28s grace,\nfull shed by 120s) \u2014 a hard\ncutoff at one number\noscillates; a ramp damps it.",
      "lineHeight": 1.25
    },

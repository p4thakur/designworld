    },
    {
      "id": "e_head1",
      "type": "text",
      "x": 322,
      "y": 110,
      "width": 241,
      "height": 40,
      "angle": 0,
      "strokeColor": "#7e22ce",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785715200000,
      "link": null,
      "locked": false,
      "text": "LAYER 2 \u2014 CONCURRENCY CAP\n(per API key)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LAYER 2 \u2014 CONCURRENCY CAP\n(per API key)",
      "lineHeight": 1.25
    },
    {
      "id": "e_body1",
      "type": "text",
      "x": 322,
      "y": 158,
      "width": 241,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785715200000,
      "link": null,
      "locked": false,
      "text": "Redis sorted set: request ID\n\u2192 start timestamp.\n\nCardinality = requests running\nnow for this key. Cap: 100.\n\nBefore checking cap, script\nevicts entries >60s old \u2014\na crashed request can't leak\na slot forever.",
      "fontSize": 11.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis sorted set: request ID\n\u2192 start timestamp.\n\nCardinality = requests running\nnow for this key. Cap: 100.\n\nBefore checking cap, script\nevicts entries >60s old \u2014\na crashed request can't leak\na slot forever.",
      "lineHeight": 1.25
    },
    {

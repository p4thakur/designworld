      "updated": 1785715200000,
      "link": null,
      "locked": false,
      "text": "LAYER 3 \u2014 FLEET LOAD SHEDDER\n(global)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LAYER 3 \u2014 FLEET LOAD SHEDDER\n(global)",
      "lineHeight": 1.25
    },
    {
      "id": "e_body2",
      "type": "text",
      "x": 612,
      "y": 158,
      "width": 241,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785715200000,
      "link": null,
      "locked": false,
      "text": "Same sorted-set mechanism,\nbut ONE shared key instead\nof one per customer.\n\nCatches: many tenants each\nindividually fine, collectively\ntoo much for the fleet.\n\nPast aggregate cap \u2192 503.",
      "fontSize": 11.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same sorted-set mechanism,\nbut ONE shared key instead\nof one per customer.\n\nCatches: many tenants each\nindividually fine, collectively\ntoo much for the fleet.\n\nPast aggregate cap \u2192 503.",
      "lineHeight": 1.25
    },

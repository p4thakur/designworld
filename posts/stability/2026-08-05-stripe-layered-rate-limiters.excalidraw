      "locked": false,
      "text": "reject path: 503 Service Unavailable (fleet-wide shedding)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "reject path: 503 Service Unavailable (fleet-wide shedding)",

      "updated": 1786239001904,
      "link": null,
      "locked": false,
      "text": "GitLab Had Five Ways to Never Lose Its Database. On Jan 31, 2017, Four Weren't Working.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GitLab Had Five Ways to Never Lose Its Database. On Jan 31, 2017, Four Weren't Working.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 54,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786239001904,
      "link": null,
      "locked": false,
      "text": "The wipe-and-resync of a lagging Postgres replica hit the primary by mistake — and only then did anyone discover which backups were real",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The wipe-and-resync of a lagging Postgres replica hit the primary by mistake — and only then did anyone discover which backups were real",
      "lineHeight": 1.25
    },

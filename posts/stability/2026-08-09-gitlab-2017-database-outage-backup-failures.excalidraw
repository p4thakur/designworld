      "updated": 1786239001904,
      "link": null,
      "locked": false,
      "text": "Manual resync: wipe the secondary's data dir. Engineer runs it on what they believe is the secondary. It's the primary. ~300GB deleted.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Manual resync: wipe the secondary's data dir. Engineer runs it on what they believe is the secondary. It's the primary. ~300GB deleted.",
      "lineHeight": 1.25
    },

      "updated": 1786239001904,
      "link": null,
      "locked": false,
      "text": "Replication lag builds under load. No WAL archiving — primary recycles log segments the secondary hasn't consumed yet.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Replication lag builds under load. No WAL archiving — primary recycles log segments the secondary hasn't consumed yet.",
      "lineHeight": 1.25
    },

      "updated": 1752451200000,
      "link": null,
      "locked": false,
      "text": "Monzo Scaled Cassandra the Way It Always Had. This Time the New Servers Served Money They Didn't Have.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Monzo Scaled Cassandra the Way It Always Had. This Time the New Servers Served Money They Didn't Have.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 56,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752451200000,
      "link": null,
      "locked": false,
      "text": "July 29, 2019 — a routine 6-node scale-up on a 21-node Cassandra cluster (RF3, quorum reads) exposed a bug in auto_bootstrap",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "July 29, 2019 — a routine 6-node scale-up on a 21-node Cassandra cluster (RF3, quorum reads) exposed a bug in auto_bootstrap",
      "lineHeight": 1.25
    },

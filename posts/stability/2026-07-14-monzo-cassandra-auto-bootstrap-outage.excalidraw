    {
      "id": "b_callout",
      "type": "rectangle",
      "x": 30,
      "y": 300,
      "width": 1140,
      "height": 110,
      "angle": 0,
      "strokeColor": "#9d174d",
      "backgroundColor": "#fdf2f8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",

      "link": null,
      "locked": false,
      "text": "commit-wait: hold the\nresult until TT.now()\n.earliest > s",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "commit-wait: hold the result until TT.now().earliest > s",

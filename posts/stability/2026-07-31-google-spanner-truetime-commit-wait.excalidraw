      "boundElements": null,
      "updated": 1785456000000,
      "link": null,
      "locked": false,
      "text": "Each drop = a time-master poll, every 30s. Drift between polls (~200μs/s) rebuilds the sawtooth.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each drop = a time-master poll, every 30s. Drift between polls (~200μs/s) rebuilds the sawtooth.",

  "elements": [
    {
      "id": "e_title",
      "type": "text",
      "x": 30, "y": 18, "width": 1140, "height": 50,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "text": "Datadog Rebuilt Its Log Storage Twice. The Third Rewrite Traded a Slower Median for a Faster Tail.",
      "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Datadog Rebuilt Its Log Storage Twice. The Third Rewrite Traded a Slower Median for a Faster Tail.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30, "y": 68, "width": 1140, "height": 20,
      "angle": 0, "strokeColor": "#555555", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "text": "Datadog's own engineering blog: two generations of multi-tenant clusters hit isolation and cardinality limits before Husky unbundled storage from compute entirely",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Datadog's own engineering blog: two generations of multi-tenant clusters hit isolation and cardinality limits before Husky unbundled storage from compute entirely",
      "lineHeight": 1.25
    },
    {
      "id": "e_p1_label",
      "type": "text",
      "x": 60, "y": 106, "width": 900, "height": 20,
      "angle": 0, "strokeColor": "#334155", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "text": "THREE GENERATIONS OF DATADOG'S LOG STORAGE",
      "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "THREE GENERATIONS OF DATADOG'S LOG STORAGE",
      "lineHeight": 1.25
    },
    {
      "id": "e_gen1",
      "type": "rectangle",
      "x": 60, "y": 136, "width": 330, "height": 170,
      "angle": 0, "strokeColor": "#57534e", "backgroundColor": "#e7e5e4",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false
    },
    {
      "id": "e_gen1_t",
      "type": "text",
      "x": 76, "y": 148, "width": 298, "height": 146,
      "angle": 0, "strokeColor": "#44403c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "text": "GEN 1 — SHARED CLUSTER\n\nElasticsearch-like, multi-tenant. Storage and compute live on the same nodes. One noisy tenant streaming high-cardinality data degrades every neighbor sharing its cluster. Rebalancing to fix it often makes it worse.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "GEN 1 — SHARED CLUSTER\n\nElasticsearch-like, multi-tenant. Storage and compute live on the same nodes. One noisy tenant streaming high-cardinality data degrades every neighbor sharing its cluster. Rebalancing to fix it often makes it worse.",
      "lineHeight": 1.3
    },
    {
      "id": "e_a1",
      "type": "arrow",
      "x": 390, "y": 221.0, "width": 30, "height": 0,
      "angle": 0, "strokeColor": "#78716c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 2 }, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "points": [[0, 0], [30, 0]], "lastCommittedPoint": [30, 0],
      "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle"
    },
    {
      "id": "e_gen2",
      "type": "rectangle",
      "x": 420, "y": 136, "width": 330, "height": 170,
      "angle": 0, "strokeColor": "#0e7490", "backgroundColor": "#cffafe",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false
    },
    {
      "id": "e_gen2_t",
      "type": "text",
      "x": 436, "y": 148, "width": 298, "height": 146,
      "angle": 0, "strokeColor": "#155e75", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "text": "GEN 2 — SHARD ROUTER\n\nTenants isolated onto dedicated shards by rolling 5-minute volume. Cascading failures mostly stop. But no hot/cold split, and high-cardinality fields like stack traces and UUIDs stay expensive.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "GEN 2 — SHARD ROUTER\n\nTenants isolated onto dedicated shards by rolling 5-minute volume. Cascading failures mostly stop. But no hot/cold split, and high-cardinality fields like stack traces and UUIDs stay expensive.",
      "lineHeight": 1.3
    },
    {
      "id": "e_a2",
      "type": "arrow",
      "x": 750, "y": 221.0, "width": 30, "height": 0,
      "angle": 0, "strokeColor": "#78716c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 2 }, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "points": [[0, 0], [30, 0]], "lastCommittedPoint": [30, 0],
      "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle"
    },
    {
      "id": "e_gen3",
      "type": "rectangle",
      "x": 780, "y": 136, "width": 340, "height": 170,
      "angle": 0, "strokeColor": "#047857", "backgroundColor": "#d1fae5",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false
    },
    {
      "id": "e_gen3_t",
      "type": "text",
      "x": 796, "y": 148, "width": 308, "height": 146,
      "angle": 0, "strokeColor": "#065f46", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "text": "GEN 3 — HUSKY\n\nUnbundled column store on top of S3. FoundationDB holds metadata for consistent file visibility. Writers and readers never talk directly. Isolation becomes a query-time slice, not an ingestion-time one. 1.5 years to first migrated product.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "GEN 3 — HUSKY\n\nUnbundled column store on top of S3. FoundationDB holds metadata for consistent file visibility. Writers and readers never talk directly. Isolation becomes a query-time slice, not an ingestion-time one. 1.5 years to first migrated product.",
      "lineHeight": 1.3
    },
    {

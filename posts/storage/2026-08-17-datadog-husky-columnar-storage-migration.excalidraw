    {
      "id": "e_footer_t",
      "type": "text",
      "x": 74, "y": 550, "width": 1052, "height": 94,
      "angle": 0, "strokeColor": "#5b21b6", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786940000000, "link": null, "locked": false,
      "text": "Result: median query latency rose a few hundred milliseconds on Husky — remote object storage loses to local SSD in the common case. In exchange, p99 fell to 257ms. \"Datadog chose a slower median to buy a dramatically shorter tail — the opposite of what most teams protect when a migration threatens the common case.\"",
      "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Result: median query latency rose a few hundred milliseconds on Husky — remote object storage loses to local SSD in the common case. In exchange, p99 fell to 257ms. \"Datadog chose a slower median to buy a dramatically shorter tail — the opposite of what most teams protect when a migration threatens the common case.\"",
      "lineHeight": 1.3
    }

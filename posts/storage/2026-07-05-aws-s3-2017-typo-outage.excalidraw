      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "INDEX + PLACEMENT DOWN\nMetadata/location (index) and\nnew-storage allocation (placement)\nsubsystems fail. Neither fully\nrestarted in years — safety\nchecks on metadata integrity\ntake longer than expected.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_3",
      "originalText": "INDEX + PLACEMENT DOWN\nMetadata/location (index) and\nnew-storage allocation (placement)\nsubsystems fail. Neither fully\nrestarted in years — safety\nchecks on metadata integrity\ntake longer than expected.",
      "lineHeight": 1.2
    },

      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "BLIND SPOT\nAWS's own status\ndashboard is served\nfrom S3 — in the same\ndead region. Can't\nupdate for ~2 hours.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_4",
      "originalText": "BLIND SPOT\nAWS's own status\ndashboard is served\nfrom S3 — in the same\ndead region. Can't\nupdate for ~2 hours.",
      "lineHeight": 1.2

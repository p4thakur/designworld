      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "Quora, Medium, Slack, Trello, Docker, Imgur, GitHub, and the SEC's filings system all spent the afternoon degraded or dark.\nCyence estimated S&P 500 companies alone lost $150M — from one mistyped parameter.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quora, Medium, Slack, Trello, Docker, Imgur, GitHub, and the SEC's filings system all spent the afternoon degraded or dark.\nCyence estimated S&P 500 companies alone lost $150M — from one mistyped parameter.",
      "lineHeight": 1.25
    },

      "locked": false,
      "text": "~4 HOURS LATER\nS3 fully restored.\nCapacity tool now\nremoves servers\nslower, with a floor.\nDashboard now spans\nregions.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_5",
      "originalText": "~4 HOURS LATER\nS3 fully restored.\nCapacity tool now\nremoves servers\nslower, with a floor.\nDashboard now spans\nregions.",
      "lineHeight": 1.2
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 315,
      "width": 1140,
      "height": 50,
      "angle": 0,
      "strokeColor": "#868e96",

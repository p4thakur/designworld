      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752192000000,
      "link": null,
      "locked": false,
      "text": "THE INDUSTRY DEFAULT (pre-2009)\n\nReliable storage means buying it: an\nEMC SAN, a NetApp filer, or renting\nAmazon S3. Enterprise chassis,\nenterprise support contracts,\nenterprise margins.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "THE INDUSTRY DEFAULT (pre-2009)\n\nReliable storage means buying it: an\nEMC SAN, a NetApp filer, or renting\nAmazon S3. Enterprise chassis,\nenterprise support contracts,\nenterprise margins.",
      "lineHeight": 1.2
    },

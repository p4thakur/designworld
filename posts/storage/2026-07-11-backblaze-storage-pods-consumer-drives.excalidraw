    },
    {
      "id": "t_4",
      "type": "text",
      "x": 50,
      "y": 520,
      "width": 1100,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752192000000,
      "link": null,
      "locked": false,
      "text": "THE SECOND TEST (2013): ENTERPRISE DRIVES\nA vendor pushed Backblaze toward pricier \"enterprise\" drives, promising fewer failures. Backblaze filled one full pod with\nthem and ran it next to the consumer fleet. Result: the enterprise drives failed MORE often. The premium bought a label, not reliability.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "THE SECOND TEST (2013): ENTERPRISE DRIVES\nA vendor pushed Backblaze toward pricier \"enterprise\" drives, promising fewer failures. Backblaze filled one full pod with\nthem and ran it next to the consumer fleet. Result: the enterprise drives failed MORE often. The premium bought a label, not reliability.",
      "lineHeight": 1.35
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 660,
      "width": 1140,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752192000000,
      "link": null,
      "locked": false,
      "text": "We default to paying for the enterprise label because checking it ourselves feels like too much work. Backblaze ran the numbers\non the box, then ran the numbers on the drives. Cheaper won both times — because they checked instead of assumed.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We default to paying for the enterprise label because checking it ourselves feels like too much work. Backblaze ran the numbers\non the box, then ran the numbers on the drives. Cheaper won both times — because they checked instead of assumed.",
      "lineHeight": 1.2
    }

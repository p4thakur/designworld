      "locked": false,
      "text": "Backblaze Tested Two Storage Assumptions. The Enterprise Premium Lost Both Times.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Backblaze Tested Two Storage Assumptions. The Enterprise Premium Lost Both Times.",
      "lineHeight": 1.25
    },
    {

      "boundElements": null,
      "updated": 1752192000000,
      "link": null,
      "locked": false,
      "text": "Sept 2009: 67TB storage pod, $7,867 in parts  ·  2013: a full pod of \"enterprise\" drives fails more than the consumer fleet",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sept 2009: 67TB storage pod, $7,867 in parts  ·  2013: a full pod of \"enterprise\" drives fails more than the consumer fleet",
      "lineHeight": 1.25
    },

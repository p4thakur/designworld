    },
    {
      "id": "callout-text-1",
      "type": "text",
      "x": 65,
      "y": 488,
      "width": 1030,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1b5e26",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The part that isn't on most architecture diagrams: Spokes never elects a leader.\nEvery write is its own election - the proxy proposes an order, all replicas vote,\nand any replica on the losing side is marked unhealthy until it's repaired and resynced.\n2 of 3 replicas must agree to commit (3 of 5, for larger sets). No standing authority - ever.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The part that isn't on most architecture diagrams: Spokes never elects a leader.\nEvery write is its own election - the proxy proposes an order, all replicas vote,\nand any replica on the losing side is marked unhealthy until it's repaired and resynced.\n2 of 3 replicas must agree to commit (3 of 5, for larger sets). No standing authority - ever.",
      "lineHeight": 1.3
    },

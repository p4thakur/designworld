      "locked": false
    },
    {
      "id": "after-text-1",
      "type": "text",
      "x": 65,
      "y": 313,
      "width": 1030,
      "height": 115,
      "angle": 0,
      "strokeColor": "#0b4a86",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "After: Spokes (originally named DGit - renamed, too easy to misread as \"git\")\n3 independent copies per repo, on 3 different servers, synced over git's own protocol\n\nLose any single server -> the repository is still fully readable and\nwritable on the other two. No disk mirroring involved at all.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After: Spokes (originally named DGit - renamed, too easy to misread as \"git\")\n3 independent copies per repo, on 3 different servers, synced over git's own protocol\n\nLose any single server -> the repository is still fully readable and\nwritable on the other two. No disk mirroring involved at all.",
      "lineHeight": 1.3
    },
    {
      "id": "callout-rect-1",
      "type": "rectangle",
      "x": 40,
      "y": 470,

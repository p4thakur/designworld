      "updated": 1,
      "link": null,
      "locked": false,
      "text": "GitHub repo replication: one copy on a cable (before) vs. a vote on every push (Spokes)",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GitHub repo replication: one copy on a cable (before) vs. a vote on every push (Spokes)",
      "lineHeight": 1.25
    },
    {
      "id": "before-rect-1",
      "type": "rectangle",
      "x": 40,
      "y": 90,
      "width": 1080,
      "height": 150,

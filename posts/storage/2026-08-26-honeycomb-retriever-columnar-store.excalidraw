      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Everyone Says Never Build Your Own Database. Honeycomb's Product Runs on One.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Everyone Says Never Build Your Own Database. Honeycomb's Product Runs on One.",
      "lineHeight": 1.25
    },
    {

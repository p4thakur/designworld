      "locked": false
    },
    {
      "id": "reversal-text",
      "type": "text",
      "x": 60,
      "y": 538,
      "width": 1080,
      "height": 124,
      "angle": 0,
      "strokeColor": "#0f5750",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE REVERSAL THAT PROVES THE POINT: years later, keeping every customer's raw events on NVMe forever\ngot expensive — so Honeycomb added \"Secondary Storage\": compress cold data, ship it to S3, rehydrate\nthrough Lambda on query. But once that felt slow, they didn't just accept whatever speed S3 gave them —\ngzip → LZ4 cut file reads ~3x, and the read path was rewritten to manually reclaim memory instead of\nleaning on garbage collection, because GC and decompression — not the network — turned out to be the\nreal tax.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE REVERSAL THAT PROVES THE POINT: years later, keeping every customer's raw events on NVMe forever\ngot expensive — so Honeycomb added \"Secondary Storage\": compress cold data, ship it to S3, rehydrate\nthrough Lambda on query. But once that felt slow, they didn't just accept whatever speed S3 gave them —\ngzip → LZ4 cut file reads ~3x, and the read path was rewritten to manually reclaim memory instead of\nleaning on garbage collection, because GC and decompression — not the network — turned out to be the\nreal tax.",
      "lineHeight": 1.25
    },
    {

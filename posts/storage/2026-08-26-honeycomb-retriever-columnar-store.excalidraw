      "locked": false
    },
    {
      "id": "text2",
      "type": "text",
      "x": 660,
      "y": 148,
      "width": 480,
      "height": 124,
      "angle": 0,
      "strokeColor": "#312e81",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WHAT HONEYCOMB BUILT: Retriever —\nmodeled on Facebook's Scuba. Events\non DISK, not memory. One file per\nCOLUMN, not per row — a query\ntouching 5 fields never reads the\nother 95.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHAT HONEYCOMB BUILT: Retriever —\nmodeled on Facebook's Scuba. Events\non DISK, not memory. One file per\nCOLUMN, not per row — a query\ntouching 5 fields never reads the\nother 95.",
      "lineHeight": 1.25
    },
    {
      "id": "d2-label",
      "type": "text",
      "x": 40,
      "y": 310,
      "width": 500,
      "height": 28,
      "angle": 0,
      "strokeColor": "#7a4d0b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "DECISION 2 — THE STORAGE LAYER",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DECISION 2 — THE STORAGE LAYER",
      "lineHeight": 1.25
    },
    {
      "id": "box3",
      "type": "rectangle",
      "x": 40,
      "y": 350,
      "width": 520,
      "height": 150,
      "angle": 0,
      "strokeColor": "#996a13",
      "backgroundColor": "#fff3bf",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {"type": 3},
      "boundElements": [],
      "updated": 1,

      "updated": 1,
      "link": null,
      "locked": false,
      "text": "DECISION 1 — THE DATABASE",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DECISION 1 — THE DATABASE",
      "lineHeight": 1.25
    },
    {

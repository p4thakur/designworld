      "locked": false
    },
    {
      "id": "text3",
      "type": "text",
      "x": 60,
      "y": 363,
      "width": 480,
      "height": 124,
      "angle": 0,
      "strokeColor": "#7a4d0b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "OBVIOUS PATH: decouple compute\nfrom storage — shared network\nstorage (EBS/S3), the standard\ncloud-native pattern for durability.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OBVIOUS PATH: decouple compute\nfrom storage — shared network\nstorage (EBS/S3), the standard\ncloud-native pattern for durability.",
      "lineHeight": 1.25
    },
    {
      "id": "box4",
      "type": "rectangle",
      "x": 640,
      "y": 350,
      "width": 520,
      "height": 150,
      "angle": 0,
      "strokeColor": "#3730a3",
      "backgroundColor": "#e0e7ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {"type": 3},
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "text4",
      "type": "text",
      "x": 660,
      "y": 363,
      "width": 480,
      "height": 124,
      "angle": 0,
      "strokeColor": "#312e81",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WHAT HONEYCOMB BUILT: local NVMe\ndisks only. Two redundant Retriever\nnodes each persist an independent\ncopy straight off Kafka. Durability =\nredundancy, not the storage layer.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHAT HONEYCOMB BUILT: local NVMe\ndisks only. Two redundant Retriever\nnodes each persist an independent\ncopy straight off Kafka. Durability =\nredundancy, not the storage layer.",
      "lineHeight": 1.25
    },
    {
      "id": "reversal-band",
      "type": "rectangle",
      "x": 40,
      "y": 525,
      "width": 1120,
      "height": 150,
      "angle": 0,
      "strokeColor": "#0f766e",
      "backgroundColor": "#ccfbf1",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {"type": 3},
      "boundElements": [],

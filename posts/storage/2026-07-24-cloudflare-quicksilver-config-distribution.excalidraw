    },
    {
      "id": "t_4",
      "type": "text",
      "x": 50,
      "y": 350,
      "width": 1100,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753315200000,
      "link": null,
      "locked": false,
      "text": "THE MECHANISM MATCH\nReads sit on every request's hot path across hundreds of thousands of servers that can never block on a lock — LMDB's\nsingle-writer, copy-on-write MVCC lets reads run lock-free straight off a memory map, no malloc, no copy. Writes are rare and\ntiny, so they flow one-way down a tree as a hash-chained, fsynced log: each entry hashes the one before it, so any node can\nlocally detect corruption or a missed update — no round trip to a central authority required.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "THE MECHANISM MATCH\nReads sit on every request's hot path across hundreds of thousands of servers that can never block on a lock — LMDB's\nsingle-writer, copy-on-write MVCC lets reads run lock-free straight off a memory map, no malloc, no copy. Writes are rare and\ntiny, so they flow one-way down a tree as a hash-chained, fsynced log: each entry hashes the one before it, so any node can\nlocally detect corruption or a missed update — no round trip to a central authority required.",
      "lineHeight": 1.35
    },
    {
      "id": "b_5",
      "type": "rectangle",
      "x": 30,
      "y": 490,
      "width": 1140,

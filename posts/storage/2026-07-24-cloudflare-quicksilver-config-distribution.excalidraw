    {
      "id": "t_1",
      "type": "text",
      "x": 45,
      "y": 120,
      "width": 325,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753315200000,
      "link": null,
      "locked": false,
      "text": "KYOTO TYCOON (pre-2020)\n\nOpen-source KV store. One\nphysical server as root of the\nreplication tree for the whole\nnetwork. Fine under a handful\nof locations; an operational and\nsecurity liability past a few\nhundred. Root node once\ndisappeared to faulty hardware.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "KYOTO TYCOON (pre-2020)\n\nOpen-source KV store. One\nphysical server as root of the\nreplication tree for the whole\nnetwork. Fine under a handful\nof locations; an operational and\nsecurity liability past a few\nhundred. Root node once\ndisappeared to faulty hardware.",
      "lineHeight": 1.2
    },

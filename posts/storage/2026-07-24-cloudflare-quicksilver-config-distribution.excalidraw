      "updated": 1753315200000,
      "link": null,
      "locked": false,
      "text": "Quicksilver: Cloudflare's Config Store Where Fast Replication Cuts Both Ways",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quicksilver: Cloudflare's Config Store Where Fast Replication Cuts Both Ways",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 56,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753315200000,
      "link": null,
      "locked": false,
      "text": "One root server -> LMDB on every box, hash-chained replication tree -> replica/proxy split as the dataset outgrew small colos",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One root server -> LMDB on every box, hash-chained replication tree -> replica/proxy split as the dataset outgrew small colos",
      "lineHeight": 1.25
    },
    {

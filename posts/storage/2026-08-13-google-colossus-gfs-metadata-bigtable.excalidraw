    {
      "id": "e_s4_t",
      "type": "text",
      "x": 896,
      "y": 160,
      "width": 234,
      "height": 134,
      "angle": 0,
      "strokeColor": "#0f766e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "Storing metadata in Bigtable let Colossus scale up by over 100x versus the largest GFS clusters. A single cluster now spans exabytes across tens of thousands of machines.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Storing metadata in Bigtable let Colossus scale up by over 100x versus the largest GFS clusters. A single cluster now spans exabytes across tens of thousands of machines.",
      "lineHeight": 1.25
    },

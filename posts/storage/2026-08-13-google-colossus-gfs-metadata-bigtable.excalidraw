      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "Google's File System Hit a Wall. The Fix Wasn't a Smarter Master \u2014 It Was a Database.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Google's File System Hit a Wall. The Fix Wasn't a Smarter Master \u2014 It Was a Database.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 68,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "Colossus, GFS's successor: metadata moved off a single master and into Bigtable, letting one cluster scale over 100x bigger",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Colossus, GFS's successor: metadata moved off a single master and into Bigtable, letting one cluster scale over 100x bigger",
      "lineHeight": 1.25
    },
    {
      "id": "e_p1_label",
      "type": "text",
      "x": 60,
      "y": 106,
      "width": 900,
      "height": 20,
      "angle": 0,
      "strokeColor": "#0f766e",

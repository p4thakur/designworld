      "isDeleted": false,
      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "THE SCALING WALL AND THE FIX",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE SCALING WALL AND THE FIX",
      "lineHeight": 1.25
    },
    {
      "id": "e_s1",
      "type": "rectangle",
      "x": 60,
      "y": 152,
      "width": 250,
      "height": 150,
      "angle": 0,

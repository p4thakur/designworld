    },
    {
      "id": "e_s1_t",
      "type": "text",
      "x": 68,
      "y": 160,
      "width": 234,
      "height": 134,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "GFS's single master held the entire namespace and ~64 bytes of metadata per 64MB chunk in RAM. Fine for a cluster of a few million files and hundreds of terabytes \u2014 the scale it was designed for in 2003.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GFS's single master held the entire namespace and ~64 bytes of metadata per 64MB chunk in RAM. Fine for a cluster of a few million files and hundreds of terabytes \u2014 the scale it was designed for in 2003.",
      "lineHeight": 1.25
    },
    {

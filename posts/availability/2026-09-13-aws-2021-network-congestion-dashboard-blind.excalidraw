      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The whole time: AWS's own monitoring degraded along with everything else. The Service Health\nDashboard's failover to its standby region ALSO routed through the same congested network --\nso the status page couldn't report the outage it was living through. Support ticketing broke too.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The whole time: AWS's own monitoring degraded along with everything else. The Service Health\nDashboard's failover to its standby region ALSO routed through the same congested network --\nso the status page couldn't report the outage it was living through. Support ticketing broke too.",
      "lineHeight": 1.25
    },

      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "AWS disables DNS automation, manually restores records. DNS itself is fixed roughly 3 hours after it started.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS disables DNS automation, manually restores records. DNS itself is fixed roughly 3 hours after it started.",
      "lineHeight": 1.25
    },

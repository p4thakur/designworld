      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "DynamoDB comes back; DWFM tries to re-lease the whole fleet at once. Timed-out requests get requeued, not dropped \u2014 arrival rate outpaces drain rate.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DynamoDB comes back; DWFM tries to re-lease the whole fleet at once. Timed-out requests get requeued, not dropped \u2014 arrival rate outpaces drain rate.",
      "lineHeight": 1.25
    },

      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "AWS Ran Two Robots to Keep DynamoDB's DNS Safe. One Was Late, and the Other Let It Erase the Address.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS Ran Two Robots to Keep DynamoDB's DNS Safe. One Was Late, and the Other Let It Erase the Address.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 68,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "A race condition between two DNS automation processes emptied dynamodb.us-east-1.amazonaws.com \u2014 and EC2 turned out to be one of DynamoDB's biggest customers",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A race condition between two DNS automation processes emptied dynamodb.us-east-1.amazonaws.com \u2014 and EC2 turned out to be one of DynamoDB's biggest customers",
      "lineHeight": 1.25
    },

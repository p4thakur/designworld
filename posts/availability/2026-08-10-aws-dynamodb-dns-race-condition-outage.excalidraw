      "boundElements": null,
      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "Engineers throttle incoming requests and selectively restart DWFM hosts to drain the queue. Leases mostly restored ~5:28am ET \u2014 12 hours after DNS itself was fixed.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Engineers throttle incoming requests and selectively restart DWFM hosts to drain the queue. Leases mostly restored ~5:28am ET \u2014 12 hours after DNS itself was fixed.",
      "lineHeight": 1.25
    },

      "updated": 1786240000000,
      "link": null,
      "locked": false,
      "text": "dynamodb.us-east-1.amazonaws.com resolves to zero IPs. Every client, including AWS's own control plane, gets an empty answer, not a timeout.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dynamodb.us-east-1.amazonaws.com resolves to zero IPs. Every client, including AWS's own control plane, gets an empty answer, not a timeout.",
      "lineHeight": 1.25
    },

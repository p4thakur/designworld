      "locked": false,
      "text": "Leases expire when checks fail. Healthy physical servers get marked unavailable for new EC2 launches \u2014 the machines were fine, the bookkeeping wasn't.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Leases expire when checks fail. Healthy physical servers get marked unavailable for new EC2 launches \u2014 the machines were fine, the bookkeeping wasn't.",
      "lineHeight": 1.25
    },

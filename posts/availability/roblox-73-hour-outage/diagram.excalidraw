      "locked": false,
      "text": "BoltDB freelist = flat array. Every append rewrites\nthe whole array to disk. Invisible at low write load.\nCatastrophic under Consul streaming pressure.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BoltDB freelist = flat array. Every append rewrites\nthe whole array to disk. Invisible at low write load.\nCatastrophic under Consul streaming pressure.",
      "lineHeight": 1.3
    },

    {
      "id": "text3",
      "type": "text",
      "x": 652,
      "y": 68,
      "width": 260,
      "height": 254,
      "angle": 0,
      "strokeColor": "#8b1a1a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",

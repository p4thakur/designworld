      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u26a1 JUN 12, 2025 \u2014 OUTAGE\n\nGCP's IAM stopped issuing\nauth tokens globally.\nKV's own config lived\ninside GCP.\n\n90.22% of KV requests\nfailed. Access, WARP,\nGateway, Turnstile\nwent down with it.\n\n2h 28m to full recovery.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u26a1 JUN 12, 2025 \u2014 OUTAGE\n\nGCP's IAM stopped issuing\nauth tokens globally.\nKV's own config lived\ninside GCP.\n\n90.22% of KV requests\nfailed. Access, WARP,\nGateway, Turnstile\nwent down with it.\n\n2h 28m to full recovery.",
      "lineHeight": 1.25
    },

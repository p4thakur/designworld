      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2018\nDUAL-CLOUD BY DESIGN\n\nWrite to 2 separate\ncloud storage backends\nat once. Race the reads.\n\nA provider outage =\nhigher latency,\nnot downtime.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2018\nDUAL-CLOUD BY DESIGN\n\nWrite to 2 separate\ncloud storage backends\nat once. Race the reads.\n\nA provider outage =\nhigher latency,\nnot downtime.",
      "lineHeight": 1.25

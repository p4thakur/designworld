      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "EARLY 2025\nSIMPLIFIED TO ONE\n\nHundreds of billions of\nkeys. Millions of req/s.\nRunning 2 providers in\nlockstep got expensive.\n\nDropped to a single\nprovider: Google Cloud.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EARLY 2025\nSIMPLIFIED TO ONE\n\nHundreds of billions of\nkeys. Millions of req/s.\nRunning 2 providers in\nlockstep got expensive.\n\nDropped to a single\nprovider: Google Cloud.",
      "lineHeight": 1.25
    },

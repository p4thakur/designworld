      "boundElements": null,
      "updated": 1752105600000,
      "link": null,
      "locked": false,
      "text": "Result: regex engine switched to one with a runtime guarantee (RE2 / Rust regex) instead of backtracking search.\nCPU protection reinstated. All 3,868 existing WAF Managed Rules hand-audited for the same failure shape.\nRoutine rule changes now get staged rollout like every other deploy — the instant global push stays reserved\nfor genuine active-attack emergencies.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_result",
      "originalText": "Result: regex engine switched to one with a runtime guarantee (RE2 / Rust regex) instead of backtracking search.\nCPU protection reinstated. All 3,868 existing WAF Managed Rules hand-audited for the same failure shape.\nRoutine rule changes now get staged rollout like every other deploy — the instant global push stays reserved\nfor genuine active-attack emergencies.",
      "lineHeight": 1.35
    }

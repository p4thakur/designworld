      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Load-tested for 5x. Real traffic: ~50x. Retry storm spikes volume to 20x the prior global peak.\nResult: Google Cloud's worldwide load-balancer capacity drops ~50% -- for every GCP customer, not just Niantic.\nFix: admission control to buy time, then jitter + truncated exponential backoff in the client, permanently.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Load-tested for 5x. Real traffic: ~50x. Retry storm spikes volume to 20x the prior global peak.\nResult: Google Cloud's worldwide load-balancer capacity drops ~50% -- for every GCP customer, not just Niantic.\nFix: admission control to buy time, then jitter + truncated exponential backoff in the client, permanently.",
      "lineHeight": 1.3
    }

    {
      "id": "blast-text",
      "type": "text",
      "x": 60,
      "y": 489,
      "width": 1120,
      "height": 72,
      "angle": 0,
      "strokeColor": "#8a1f1f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "CloudWatch — the tool used to diagnose outages — is itself downstream of Kinesis. The AWS status page\nupdate process also ran through Cognito. The manual fallback existed; nobody had rehearsed it enough to\nmove fast.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CloudWatch — the tool used to diagnose outages — is itself downstream of Kinesis. The AWS status page\nupdate process also ran through Cognito. The manual fallback existed; nobody had rehearsed it enough to\nmove fast.",
      "lineHeight": 1.3
    },

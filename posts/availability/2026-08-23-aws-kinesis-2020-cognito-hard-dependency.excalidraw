    {
      "id": "footer-text",
      "type": "text",
      "x": 60,
      "y": 614,
      "width": 1120,
      "height": 92,
      "angle": 0,
      "strokeColor": "#4c1d95",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE REFLECTION — \"Best-effort\" is a label a team puts on a call. It isn't a property the runtime enforces.\nThe dependency graph doesn't know what you called something — only what happens when it doesn't come\nback in time.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE REFLECTION — \"Best-effort\" is a label a team puts on a call. It isn't a property the runtime enforces.\nThe dependency graph doesn't know what you called something — only what happens when it doesn't come\nback in time.",
      "lineHeight": 1.3
    }
  ],

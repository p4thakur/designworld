    {
      "id": "callout-text",
      "type": "text",
      "x": 60,
      "y": 364,
      "width": 1120,
      "height": 72,
      "angle": 0,
      "strokeColor": "#7a4d0b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cognito's write to Kinesis was labeled best-effort usage reporting — but it ran synchronously in the login\npath. AWS's own summary called it an \"unrealized hard dependency.\" Nobody marked it critical, so nobody\nbuilt it to fail safely.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cognito's write to Kinesis was labeled best-effort usage reporting — but it ran synchronously in the login\npath. AWS's own summary called it an \"unrealized hard dependency.\" Nobody marked it critical, so nobody\nbuilt it to fail safely.",
      "lineHeight": 1.3
    },

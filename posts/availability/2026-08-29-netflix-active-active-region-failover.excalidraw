    {
      "id": "t1",
      "type": "text",
      "x": 58,
      "y": 151,
      "width": 244,
      "height": 248,
      "angle": 0,
      "strokeColor": "#991b1b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "An AWS engineer wipes\nstate data off a handful\nof ELBs at 12:24 PM.\nNetflix breaks for\nChristmas Eve. Fix\ndoesn't land until 5:40 AM\n— 17 hours later.\nEverything ran in one AWS\nregion: US-EAST-1.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An AWS engineer wipes\nstate data off a handful\nof ELBs at 12:24 PM.\nNetflix breaks for\nChristmas Eve. Fix\ndoesn't land until 5:40 AM\n— 17 hours later.\nEverything ran in one AWS\nregion: US-EAST-1.",
      "lineHeight": 1.25
    },
    {
      "id": "l2",
      "type": "text",
      "x": 355,
      "y": 100,
      "width": 280,
      "height": 28,
      "angle": 0,
      "strokeColor": "#1d4ed8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE FIX: ACTIVE-ACTIVE",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE FIX: ACTIVE-ACTIVE",
      "lineHeight": 1.25
    },
    {
      "id": "box2",

    {
      "id": "t3",
      "type": "text",
      "x": 688,
      "y": 151,
      "width": 244,
      "height": 248,
      "angle": 0,
      "strokeColor": "#6d28d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "An untested failover\npath is a hypothesis.\nNetflix built a tool that\nkills an entire AWS\nregion on purpose, in\nproduction, on a\nschedule — with real\ncustomers on it.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An untested failover\npath is a hypothesis.\nNetflix built a tool that\nkills an entire AWS\nregion on purpose, in\nproduction, on a\nschedule — with real\ncustomers on it.",
      "lineHeight": 1.25
    },

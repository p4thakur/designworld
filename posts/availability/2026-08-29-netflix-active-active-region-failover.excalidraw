      "locked": false,
      "text": "Netflix Broke on Christmas Eve 2012. So It Built a Machine to Break Itself on Purpose.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Netflix Broke on Christmas Eve 2012. So It Built a Machine to Break Itself on Purpose.",
      "lineHeight": 1.25
    },
    {

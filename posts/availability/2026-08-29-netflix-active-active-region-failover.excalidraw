    {
      "id": "detect-text",
      "type": "text",
      "x": 60,
      "y": 453,
      "width": 1185,
      "height": 84,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "DETECTION AND OWNERSHIP: Failure is caught by a business metric built for this — Stream Starts Per\nSecond, whether people can actually press play — not an infra dashboard first. The failover orchestration\nitself runs in Python, at a company built almost entirely on Java, maintained by a team of three engineers.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DETECTION AND OWNERSHIP: Failure is caught by a business metric built for this — Stream Starts Per\nSecond, whether people can actually press play — not an infra dashboard first. The failover orchestration\nitself runs in Python, at a company built almost entirely on Java, maintained by a team of three engineers.",
      "lineHeight": 1.25
    },
    {

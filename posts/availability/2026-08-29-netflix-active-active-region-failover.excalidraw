    {
      "id": "t4",
      "type": "text",
      "x": 1003,
      "y": 151,
      "width": 244,
      "height": 248,
      "angle": 0,
      "strokeColor": "#15803d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Manual failover: ~45 min,\n35 of them waiting for\nscale-up. Automated\nfailover now: 7 minutes\nflat, via pre-scaled\n'shadow clusters' in the\nhealthy region.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Manual failover: ~45 min,\n35 of them waiting for\nscale-up. Automated\nfailover now: 7 minutes\nflat, via pre-scaled\n'shadow clusters' in the\nhealthy region.",
      "lineHeight": 1.25
    },

    {
      "id": "t2",
      "type": "text",
      "x": 373,
      "y": 151,
      "width": 244,
      "height": 248,
      "angle": 0,
      "strokeColor": "#1d4ed8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Not a cold backup region.\nEvery region runs live\nproduction traffic at\nonce, so any region can\nabsorb the others' load\nwithout a cold start.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Not a cold backup region.\nEvery region runs live\nproduction traffic at\nonce, so any region can\nabsorb the others' load\nwithout a cold start.",
      "lineHeight": 1.25
    },
    {
      "id": "l3",
      "type": "text",
      "x": 670,

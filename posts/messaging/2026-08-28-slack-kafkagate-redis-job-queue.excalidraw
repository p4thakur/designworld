    {
      "id": "e_title",
      "type": "text",
      "x": 30, "y": 18, "width": 1140, "height": 50,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "Slack's Job Queue Could Take Jobs In. In 2016, It Also Stopped Letting Them Out.",
      "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Slack's Job Queue Could Take Jobs In. In 2016, It Also Stopped Letting Them Out.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30, "y": 68, "width": 1140, "height": 20,
      "angle": 0, "strokeColor": "#555555", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "How a Redis-only job queue got sealed shut in both directions at once, and why Kafkagate went in front of Redis instead of replacing it",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "containerId": null,
      "originalText": "How a Redis-only job queue got sealed shut in both directions at once, and why Kafkagate went in front of Redis instead of replacing it",
      "lineHeight": 1.25
    },
    {
      "id": "e_r1_label",
      "type": "text",
      "x": 60, "y": 106, "width": 1000, "height": 20,
      "angle": 0, "strokeColor": "#334155", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "BEFORE 2016 — REDIS IS THE ONLY COPY OF THE QUEUE",
      "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "BEFORE 2016 — REDIS IS THE ONLY COPY OF THE QUEUE",
      "lineHeight": 1.25
    },
    {
      "id": "e_r1b1",
      "type": "rectangle",
      "x": 60, "y": 136, "width": 350, "height": 170,
      "angle": 0, "strokeColor": "#475569", "backgroundColor": "#e2e8f0",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r1b1_t",
      "type": "text",
      "x": 76, "y": 148, "width": 318, "height": 146,
      "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "APP SERVERS\n\nUnfurl a link, send a notification, run a security check — each becomes a job. App servers enqueue it straight into Redis, picked by job type.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "APP SERVERS\n\nUnfurl a link, send a notification, run a security check — each becomes a job. App servers enqueue it straight into Redis, picked by job type.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r1a1",
      "type": "arrow",
      "x": 410, "y": 221.0, "width": 30, "height": 0,
      "angle": 0, "strokeColor": "#78716c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 2 }, "isDeleted": false,

      "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle"
    },
    {
      "id": "e_r1b2",
      "type": "rectangle",
      "x": 440, "y": 136, "width": 350, "height": 170,
      "angle": 0, "strokeColor": "#475569", "backgroundColor": "#e2e8f0",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r1b2_t",
      "type": "text",
      "x": 456, "y": 148, "width": 318, "height": 146,
      "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "REDIS — BACKLOG + DISPATCH\n\nOne store holds the whole backlog and the dispatch bookkeeping. ID-based dedup keeps duplicates out. Worked fine for years.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "REDIS — BACKLOG + DISPATCH\n\nOne store holds the whole backlog and the dispatch bookkeeping. ID-based dedup keeps duplicates out. Worked fine for years.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r1a2",
      "type": "arrow",
      "x": 790, "y": 221.0, "width": 30, "height": 0,
      "angle": 0, "strokeColor": "#78716c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 2 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "points": [[0, 0], [30, 0]], "lastCommittedPoint": [30, 0],
      "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle"
    },
    {
      "id": "e_r1b3",
      "type": "rectangle",
      "x": 820, "y": 136, "width": 350, "height": 170,
      "angle": 0, "strokeColor": "#475569", "backgroundColor": "#e2e8f0",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r1b3_t",
      "type": "text",
      "x": 836, "y": 148, "width": 318, "height": 146,
      "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "WORKER POOL\n\nWorkers poll Redis, dequeue a job, execute it. Simple loop — as long as dequeue always finds the memory it needs.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "WORKER POOL\n\nWorkers poll Redis, dequeue a job, execute it. Simple loop — as long as dequeue always finds the memory it needs.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r2_label",
      "type": "text",
      "x": 60, "y": 326, "width": 1000, "height": 20,
      "angle": 0, "strokeColor": "#9f1239", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "2016 — THE DOUBLE LOCKUP",
      "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "2016 — THE DOUBLE LOCKUP",
      "lineHeight": 1.25
    },
    {
      "id": "e_r2a",
      "type": "rectangle",
      "x": 60, "y": 356, "width": 520, "height": 170,
      "angle": 0, "strokeColor": "#be123c", "backgroundColor": "#ffe4e6",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r2a_t",
      "type": "text",
      "x": 76, "y": 368, "width": 488, "height": 146,
      "angle": 0, "strokeColor": "#881337", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "ENQUEUE FAILS (expected)\n\nA slowdown in the database layer ripples into job execution. Workers fall behind. Redis climbs to its configured memory ceiling — new jobs can't get in.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "ENQUEUE FAILS (expected)\n\nA slowdown in the database layer ripples into job execution. Workers fall behind. Redis climbs to its configured memory ceiling — new jobs can't get in.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r2b",
      "type": "rectangle",
      "x": 620, "y": 356, "width": 520, "height": 170,
      "angle": 0, "strokeColor": "#be123c", "backgroundColor": "#fecdd3",
      "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r2b_t",
      "type": "text",
      "x": 636, "y": 368, "width": 488, "height": 146,
      "angle": 0, "strokeColor": "#881337", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "DEQUEUE ALSO FAILS (the surprise)\n\nRemoving a job isn't free either — Redis must move it into a processing list before deleting it from the backlog. That move needs memory too. At zero free, dequeue stalls right alongside enqueue.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEQUEUE ALSO FAILS (the surprise)\n\nRemoving a job isn't free either — Redis must move it into a processing list before deleting it from the backlog. That move needs memory too. At zero free, dequeue stalls right alongside enqueue.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r2res",
      "type": "rectangle",
      "x": 60, "y": 546, "width": 1080, "height": 100,
      "angle": 0, "strokeColor": "#9f1239", "backgroundColor": "#fda4af",
      "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r2res_t",
      "type": "text",
      "x": 76, "y": 558, "width": 1048, "height": 76,
      "angle": 0, "strokeColor": "#4c0519", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "RESULT: the queue is sealed shut in both directions. Notifications, link unfurls, and security checks all go down with it — recovery needs manual intervention, not just waiting out the database slowdown.",
      "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "RESULT: the queue is sealed shut in both directions. Notifications, link unfurls, and security checks all go down with it — recovery needs manual intervention, not just waiting out the database slowdown.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r3_label",
      "type": "text",
      "x": 60, "y": 676, "width": 1080, "height": 20,
      "angle": 0, "strokeColor": "#0e7490", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "AFTER — KAFKA AS A DURABLE BUFFER, NOT A REDIS REPLACEMENT",
      "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "AFTER — KAFKA AS A DURABLE BUFFER, NOT A REDIS REPLACEMENT",
      "lineHeight": 1.25
    },
    {
      "id": "e_r3b1",
      "type": "rectangle",
      "x": 60, "y": 706, "width": 350, "height": 150,
      "angle": 0, "strokeColor": "#0e7490", "backgroundColor": "#cffafe",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r3b1_t",
      "type": "text",
      "x": 76, "y": 718, "width": 318, "height": 126,
      "angle": 0, "strokeColor": "#164e63", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "KAFKAGATE\n\nStateless Go service. One HTTP POST endpoint — topic, partition, payload — relayed into Kafka over the Sarama client.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "KAFKAGATE\n\nStateless Go service. One HTTP POST endpoint — topic, partition, payload — relayed into Kafka over the Sarama client.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r3a1",
      "type": "arrow",
      "x": 410, "y": 781.0, "width": 30, "height": 0,
      "angle": 0, "strokeColor": "#78716c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 2 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "points": [[0, 0], [30, 0]], "lastCommittedPoint": [30, 0],
      "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle"
    },
    {
      "id": "e_r3b2",
      "type": "rectangle",
      "x": 440, "y": 706, "width": 350, "height": 150,
      "angle": 0, "strokeColor": "#0e7490", "backgroundColor": "#cffafe",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r3b2_t",
      "type": "text",
      "x": 456, "y": 718, "width": 318, "height": 126,
      "angle": 0, "strokeColor": "#164e63", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "KAFKA — DURABLE BUFFER\n\nJobs land here first now, not Redis. A slow drain no longer means a full backlog with nowhere to go.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "KAFKA — DURABLE BUFFER\n\nJobs land here first now, not Redis. A slow drain no longer means a full backlog with nowhere to go.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r3a2",
      "type": "arrow",
      "x": 790, "y": 781.0, "width": 30, "height": 0,
      "angle": 0, "strokeColor": "#78716c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 2 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "points": [[0, 0], [30, 0]], "lastCommittedPoint": [30, 0],
      "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle"
    },
    {
      "id": "e_r3b3",
      "type": "rectangle",
      "x": 820, "y": 706, "width": 350, "height": 150,
      "angle": 0, "strokeColor": "#0e7490", "backgroundColor": "#cffafe",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_r3b3_t",
      "type": "text",
      "x": 836, "y": 718, "width": 318, "height": 126,
      "angle": 0, "strokeColor": "#164e63", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "JQRELAY -> REDIS -> WORKERS\n\nOne relay process per Kafka topic, self-healing if it dies, drains jobs back into Redis for workers to dequeue as before.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "JQRELAY -> REDIS -> WORKERS\n\nOne relay process per Kafka topic, self-healing if it dies, drains jobs back into Redis for workers to dequeue as before.",
      "lineHeight": 1.3
    },
    {
      "id": "e_footer",
      "type": "rectangle",
      "x": 60, "y": 886, "width": 1110, "height": 130,
      "angle": 0, "strokeColor": "#b45309", "backgroundColor": "#fde68a",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false
    },
    {
      "id": "e_footer_t",
      "type": "text",
      "x": 74, "y": 894, "width": 1082, "height": 114,
      "angle": 0, "strokeColor": "#78350f", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787180000000, "link": null, "locked": false,
      "text": "THE TRADEOFF THE FIX DIDN'T ERASE: Kafkagate acknowledges a job once the partition leader has it — not once it's replicated. Faster relay, with a small window where a leader failure before replication loses the job. At 33,000 jobs a second, Slack wasn't choosing between risk and no risk. Just which risk, and how much of it, for how much speed.",
      "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE TRADEOFF THE FIX DIDN'T ERASE: Kafkagate acknowledges a job once the partition leader has it — not once it's replicated. Faster relay, with a small window where a leader failure before replication loses the job. At 33,000 jobs a second, Slack wasn't choosing between risk and no risk. Just which risk, and how much of it, for how much speed.",
      "lineHeight": 1.3
    }
  ],

    {
      "id": "footer-text",
      "type": "text",
      "x": 60,
      "y": 568,
      "width": 1120,
      "height": 84,
      "angle": 0,
      "strokeColor": "#0f5750",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "~2 out of 3 fetch requests crossed an AZ boundary by default — roughly 50% of Grab's Kafka platform cost.\nThe fix costs nothing in durability: writes still go to the leader, only consumer reads redirect. Tradeoff: a\nfollower can lag its leader by a few ms, so rack-aware consumers read a slightly older copy of the log.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "~2 out of 3 fetch requests crossed an AZ boundary by default — roughly 50% of Grab's Kafka platform cost.\nThe fix costs nothing in durability: writes still go to the leader, only consumer reads redirect. Tradeoff: a\nfollower can lag its leader by a few ms, so rack-aware consumers read a slightly older copy of the log.",
      "lineHeight": 1.25
    }

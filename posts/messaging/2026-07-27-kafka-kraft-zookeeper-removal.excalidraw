      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "Kafka's Team Spent a Decade Tuning ZooKeeper. The Fix Was Deleting It.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kafka's Team Spent a Decade Tuning ZooKeeper. The Fix Was Deleting It.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 56,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "KIP-500 (2019) \u2192 KRaft marked production-ready in Kafka 3.3 (Oct 2022) \u2014 replacing an external, session-based coordination service with a Raft quorum embedded in Kafka itself",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KIP-500 (2019) \u2192 KRaft marked production-ready in Kafka 3.3 (Oct 2022) \u2014 replacing an external, session-based coordination service with a Raft quorum embedded in Kafka itself",
      "lineHeight": 1.25
    },
    {
      "id": "b_left",
      "type": "rectangle",
      "x": 30,

    },
    {
      "id": "t_left",
      "type": "text",
      "x": 50,
      "y": 112,
      "width": 480,
      "height": 196,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "ZOOKEEPER-BASED CONTROLLER (2011\u20132022)\n\n\u2022 Controller election via an ephemeral znode\n\u2022 On failover: reload the ENTIRE metadata\n  tree from ZK \u2014 every topic, partition,\n  replica assignment, in-sync-replica set\n\u2022 Watches are one-shot: re-arm, then fan\n  out a full UpdateMetadataRequest to\n  every broker, on every single change\n\nFAILOVER: 20+ MINUTES on large clusters",
      "fontSize": 13.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ZOOKEEPER-BASED CONTROLLER (2011\u20132022)\n\n\u2022 Controller election via an ephemeral znode\n\u2022 On failover: reload the ENTIRE metadata\n  tree from ZK \u2014 every topic, partition,\n  replica assignment, in-sync-replica set\n\u2022 Watches are one-shot: re-arm, then fan\n  out a full UpdateMetadataRequest to\n  every broker, on every single change\n\nFAILOVER: 20+ MINUTES on large clusters",
      "lineHeight": 1.25
    },
    {

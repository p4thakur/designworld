    {
      "id": "t_war",
      "type": "text",
      "x": 50,
      "y": 472,
      "width": 1100,
      "height": 88,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "WHAT ZK TUNING COULDN'T FIX\nKAFKA-6879: a ZooKeeper session expiration deadlocked the controller's own internal lock against its own\nexpiry-handling latch, leaving a \u201czombie\u201d controller \u2014 brokers kept fetching, but none ever got another\ndirective again, silently, until someone restarted it by hand.",
      "fontSize": 13.5,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "WHAT ZK TUNING COULDN'T FIX\nKAFKA-6879: a ZooKeeper session expiration deadlocked the controller's own internal lock against its own\nexpiry-handling latch, leaving a \u201czombie\u201d controller \u2014 brokers kept fetching, but none ever got another\ndirective again, silently, until someone restarted it by hand.",
      "lineHeight": 1.3
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 600,
      "width": 1140,
      "height": 50,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "Sometimes the slow thing isn't slow because it needs tuning. It's slow because your control plane's source\nof truth lives in somebody else's system.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sometimes the slow thing isn't slow because it needs tuning. It's slow because your control plane's source\nof truth lives in somebody else's system.",
      "lineHeight": 1.2
    }

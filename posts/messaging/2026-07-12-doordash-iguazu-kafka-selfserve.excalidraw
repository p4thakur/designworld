    {
      "id": "t_s1",
      "type": "text",
      "x": 44,
      "y": 120,
      "width": 164,
      "height": 242,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

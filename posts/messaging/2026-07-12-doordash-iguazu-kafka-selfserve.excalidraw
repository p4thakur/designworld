      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752278400000,
      "link": null,
      "locked": false,
      "text": "THE CONSOLIDATION\nOne HTTP Kafka\nproxy for every\nproducer. Flink fans\nout to Snowflake\n(S3 + Snowpipe),\nRedis, Chronosphere.\nProtobuf schemas\nchecked in CI.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_s2",
      "originalText": "THE CONSOLIDATION\nOne HTTP Kafka\nproxy for every\nproducer. Flink fans\nout to Snowflake\n(S3 + Snowpipe),\nRedis, Chronosphere.\nProtobuf schemas\nchecked in CI.",
      "lineHeight": 1.3
    },

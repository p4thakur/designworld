      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752278400000,
      "link": null,
      "locked": false,
      "text": "PRE-IGUAZU\nOne SQS or Kinesis\npipeline per event\ntype, each with its\nown hops. No shared\nobservability. Up to\na full day to reach\nSnowflake.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_s1",
      "originalText": "PRE-IGUAZU\nOne SQS or Kinesis\npipeline per event\ntype, each with its\nown hops. No shared\nobservability. Up to\na full day to reach\nSnowflake.",
      "lineHeight": 1.3
    },
    {

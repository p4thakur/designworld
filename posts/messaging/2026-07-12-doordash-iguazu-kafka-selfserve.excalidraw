      "updated": 1752278400000,
      "link": null,
      "locked": false,
      "text": "THE SCALE ACHIEVED\nHundreds of billions\nof events a day.\n99.99% delivery.\nLatency to Snowflake:\na day → a few\nminutes.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_s3",
      "originalText": "THE SCALE ACHIEVED\nHundreds of billions\nof events a day.\n99.99% delivery.\nLatency to Snowflake:\na day → a few\nminutes.",
      "lineHeight": 1.3
    },

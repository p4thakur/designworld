      "link": null,
      "locked": false,
      "text": "DoorDash's Event Platform Moves Hundreds of Billions of Events a Day. Its Bottleneck Was a GitHub Pull Request.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DoorDash's Event Platform Moves Hundreds of Billions of Events a Day. Its Bottleneck Was a GitHub Pull Request.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 54,
      "width": 1040,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752278400000,
      "link": null,
      "locked": false,
      "text": "Iguazu: SQS/Kinesis fragmentation → Kafka + Flink at scale, then the 2-day topic-approval chain that throttled onboarding anyway",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Iguazu: SQS/Kinesis fragmentation → Kafka + Flink at scale, then the 2-day topic-approval chain that throttled onboarding anyway",
      "lineHeight": 1.25
    },
    {

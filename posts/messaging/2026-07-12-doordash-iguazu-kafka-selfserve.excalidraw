    {
      "id": "t_result",
      "type": "text",
      "x": 46,
      "y": 418,
      "width": 1008,
      "height": 106,
      "angle": 0,
      "strokeColor": "#134e4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752278400000,
      "link": null,
      "locked": false,
      "text": "Result: topic onboarding fell from a 2-business-day guarantee to under an hour, often ~15 minutes — a 95% reduction.\nOn-call manual work dropped roughly 4 hours a week. The platform now self-serves about 100 new topics a week,\nzero approvals required. The system moving hundreds of billions of events a day wasn't throttled by Kafka.\nIt was throttled by a pull request, waiting for someone to click approve.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_result",
      "originalText": "Result: topic onboarding fell from a 2-business-day guarantee to under an hour, often ~15 minutes — a 95% reduction.\nOn-call manual work dropped roughly 4 hours a week. The platform now self-serves about 100 new topics a week,\nzero approvals required. The system moving hundreds of billions of events a day wasn't throttled by Kafka.\nIt was throttled by a pull request, waiting for someone to click approve.",
      "lineHeight": 1.35
    }
  ],

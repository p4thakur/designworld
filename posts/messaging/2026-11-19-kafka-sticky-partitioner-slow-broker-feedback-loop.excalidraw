      "locked": false,
      "id": "e16",
      "type": "text",
      "seed": 16,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "x": 60,
      "y": 495,
      "width": 598.4,
      "height": 148.8,
      "text": "fast broker: batch drained after linger -> new batch -> switch\n             (stint ends at a few KB)\nslow broker: in-flight slots full, batch waits -> fills to 16 KB\n             (stint ends only when the batch is full)\n\ntime spent on a partition ~ its broker's latency\n-> more records to the slow broker -> slower still",
      "originalText": "fast broker: batch drained after linger -> new batch -> switch\n             (stint ends at a few KB)\nslow broker: in-flight slots full, batch waits -> fills to 16 KB\n             (stint ends only when the batch is full)\n\ntime spent on a partition ~ its broker's latency\n-> more records to the slow broker -> slower still",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,

    { "id": "b4r", "type": "rectangle", "x": 660, "y": 470, "width": 480, "height": 90, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "#c5f6fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "b4rt", "type": "text", "x": 680, "y": 486, "width": 440, "height": 58, "angle": 0, "strokeColor": "#0b7285", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Executes the reassignment automatically\n— no human required unless something\nlooks genuinely unusual", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Executes the reassignment automatically\n— no human required unless something\nlooks genuinely unusual", "lineHeight": 1.25 },

    { "id": "twist", "type": "rectangle", "x": 60, "y": 600, "width": 1080, "height": 150, "angle": 0, "strokeColor": "#7048e8", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "twistt", "type": "text", "x": 90, "y": 620, "width": 1020, "height": 110, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "THE TWIST: automating balance didn't remove the hard part, it relocated it.\nA naive max-flow solution reached near-perfect leader balance on a topic — but proposed far more\npartition moves than the imbalance actually required. Balanced ≠ efficient. Pinterest added a\n\"shared residue\" mechanism to the flow graph just to stop it doing more work than the problem justified.", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "THE TWIST: automating balance didn't remove the hard part, it relocated it.\nA naive max-flow solution reached near-perfect leader balance on a topic — but proposed far more\npartition moves than the imbalance actually required. Balanced ≠ efficient. Pinterest added a\n\"shared residue\" mechanism to the flow graph just to stop it doing more work than the problem justified.", "lineHeight": 1.25 },

    { "id": "footnote", "type": "text", "x": 40, "y": 780, "width": 1160, "height": 60, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Pinterest Kafka: 3,000+ brokers across 50+ clusters in 3 AWS regions. Peak throughput: 40M+ msgs/sec,\n800B+ messages and 1.2PB moved per day. Broker failures: weekly, some weeks more than once a day.", "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Pinterest Kafka: 3,000+ brokers across 50+ clusters in 3 AWS regions. Peak throughput: 40M+ msgs/sec,\n800B+ messages and 1.2PB moved per day. Broker failures: weekly, some weeks more than once a day.", "lineHeight": 1.25 }

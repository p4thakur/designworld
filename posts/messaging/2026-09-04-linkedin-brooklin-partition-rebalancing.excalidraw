      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2022 — LOAD-AWARE\nASSIGNMENT\n\nAssign by measured\nthroughput, not count\n\nPredicts tasks\nneeded from real\nmetrics\n\nSpreads hot\npartitions apart\n\nSticky assignment:\nno cascades.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2022 — LOAD-AWARE\nASSIGNMENT\n\nAssign by measured\nthroughput, not count\n\nPredicts tasks\nneeded from real\nmetrics\n\nSpreads hot\npartitions apart\n\nSticky assignment:\nno cascades.",
      "lineHeight": 1.25
    },

      "updated": 1787000000000,
      "link": null,
      "locked": false,
      "text": "70M players on a masterless chat tier → all writes still hit ONE MySQL primary → timeouts on friend-list\nloads → Riak (masterless) + CRDT merge on next login. Some shards still run MySQL.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "70M players on a masterless chat tier → all writes still hit ONE MySQL primary → timeouts on friend-list loads → Riak (masterless) + CRDT merge on next login. Some shards still run MySQL.",
      "lineHeight": 1.25
    },

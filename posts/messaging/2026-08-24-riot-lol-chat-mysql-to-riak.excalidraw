    {
      "id": "e_footer_t",
      "type": "text",
      "x": 76,
      "y": 804,
      "width": 1048,
      "height": 76,
      "angle": 0,
      "strokeColor": "#5b21b6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787000000000,
      "link": null,
      "locked": false,
      "text": "No one was wrong for building this on a single MySQL writer. It was the right call for a chat system\nbefore it had 70 million concurrent rosters to protect. The tradeoffs didn't disappear when Riak came\nin — they moved from \"can the database survive\" to \"can the merge function reconcile two truths into one.\"",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No one was wrong for building this on a single MySQL writer. It was the right call for a chat system before it had 70 million concurrent rosters to protect. The tradeoffs didn't disappear when Riak came in — they moved from \"can the database survive\" to \"can the merge function reconcile two truths into one.\"",
      "lineHeight": 1.3
    }

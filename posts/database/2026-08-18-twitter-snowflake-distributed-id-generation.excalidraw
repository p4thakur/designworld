      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_r1b3_t",
      "type": "text",
      "x": 836, "y": 148, "width": 318, "height": 146,
      "angle": 0, "strokeColor": "#1e3a8a", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "\"EVERYTHING SINCE ID X\"\n\nClients paginate, stream, and look up mentions by id. Ordering is guaranteed for free, because the column only ever goes up.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"EVERYTHING SINCE ID X\"\n\nClients paginate, stream, and look up mentions by id. Ordering is guaranteed for free, because the column only ever goes up.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r2_label",
      "type": "text",
      "x": 60, "y": 326, "width": 900, "height": 20,
      "angle": 0, "strokeColor": "#334155", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "THREE FIXES CONSIDERED — ALL REJECTED",
      "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "THREE FIXES CONSIDERED — ALL REJECTED",
      "lineHeight": 1.25
    },
    {
      "id": "e_r2a",
      "type": "rectangle",
      "x": 60, "y": 356, "width": 360, "height": 170,
      "angle": 0, "strokeColor": "#475569", "backgroundColor": "#e2e8f0",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_r2a_t",
      "type": "text",
      "x": 76, "y": 368, "width": 328, "height": 146,
      "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "128-BIT UUID\n\nSolves uniqueness. Breaks sortability and blows past the 64-bit budget Twitter needed to stay compact.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "128-BIT UUID\n\nSolves uniqueness. Breaks sortability and blows past the 64-bit budget Twitter needed to stay compact.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r2b",
      "type": "rectangle",
      "x": 450, "y": 356, "width": 360, "height": 170,
      "angle": 0, "strokeColor": "#475569", "backgroundColor": "#e2e8f0",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_r2b_t",
      "type": "text",
      "x": 466, "y": 368, "width": 328, "height": 146,
      "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "FLICKR-STYLE TICKET SERVER\n\nA MySQL box dedicated to handing out sequential ids. Keeps ordering — but reintroduces a resync routine and a single write bottleneck.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "FLICKR-STYLE TICKET SERVER\n\nA MySQL box dedicated to handing out sequential ids. Keeps ordering — but reintroduces a resync routine and a single write bottleneck.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r2c",
      "type": "rectangle",
      "x": 840, "y": 356, "width": 360, "height": 170,
      "angle": 0, "strokeColor": "#475569", "backgroundColor": "#e2e8f0",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_r2c_t",
      "type": "text",
      "x": 856, "y": 368, "width": 328, "height": 146,
      "angle": 0, "strokeColor": "#1e293b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "ZOOKEEPER SEQUENTIAL ZNODES\n\nCan coordinate id assignment across machines. Performance fell short, and a coordinated scheme risked availability for no real gain.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "ZOOKEEPER SEQUENTIAL ZNODES\n\nCan coordinate id assignment across machines. Performance fell short, and a coordinated scheme risked availability for no real gain.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r3_label",
      "type": "text",
      "x": 60, "y": 546, "width": 900, "height": 20,
      "angle": 0, "strokeColor": "#15803d", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "SNOWFLAKE: THREE UNCOORDINATED PIECES, ONE ID",
      "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "SNOWFLAKE: THREE UNCOORDINATED PIECES, ONE ID",
      "lineHeight": 1.25
    },

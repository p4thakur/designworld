    {
      "id": "e_title",
      "type": "text",
      "x": 30, "y": 18, "width": 1140, "height": 50,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "Twitter's Tweet IDs Used to Be a MySQL Auto-Increment Column. Then Cassandra Showed Up.",
      "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Twitter's Tweet IDs Used to Be a MySQL Auto-Increment Column. Then Cassandra Showed Up.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30, "y": 68, "width": 1140, "height": 20,
      "angle": 0, "strokeColor": "#555555", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "Twitter's own 2010 Snowflake spec: why auto-increment couldn't survive sharding, three rejected fixes, and the uncoordinated id scheme that replaced all of them",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Twitter's own 2010 Snowflake spec: why auto-increment couldn't survive sharding, three rejected fixes, and the uncoordinated id scheme that replaced all of them",
      "lineHeight": 1.25
    },
    {
      "id": "e_r1_label",
      "type": "text",
      "x": 60, "y": 106, "width": 900, "height": 20,
      "angle": 0, "strokeColor": "#1e3a8a", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "THE OLD PATH: ONE TABLE, ONE COUNTER",
      "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "originalText": "THE OLD PATH: ONE TABLE, ONE COUNTER",
      "lineHeight": 1.25
    },
    {
      "id": "e_r1b1",
      "type": "rectangle",
      "x": 60, "y": 136, "width": 350, "height": 170,
      "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "#dbeafe",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_r1b1_t",
      "type": "text",
      "x": 76, "y": 148, "width": 318, "height": 146,
      "angle": 0, "strokeColor": "#1e3a8a", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "TWEET CREATED\n\nA client posts a new tweet. Something needs to hand it a unique, sortable id before it can be written and read back.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "TWEET CREATED\n\nA client posts a new tweet. Something needs to hand it a unique, sortable id before it can be written and read back.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r1a1",
      "type": "arrow",
      "x": 410, "y": 221.0, "width": 30, "height": 0,
      "angle": 0, "strokeColor": "#78716c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 2 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "points": [[0, 0], [30, 0]], "lastCommittedPoint": [30, 0],
      "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle"
    },
    {
      "id": "e_r1b2",
      "type": "rectangle",
      "x": 440, "y": 136, "width": 350, "height": 170,
      "angle": 0, "strokeColor": "#c2410c", "backgroundColor": "#fed7aa",
      "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_r1b2_t",
      "type": "text",
      "x": 456, "y": 148, "width": 318, "height": 146,
      "angle": 0, "strokeColor": "#7c2d12", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "FAILURE POINT — ONE AUTO-INCREMENT COLUMN\n\nOne MySQL table hands out the next id, always increasing. Works perfectly — as long as there is only one table to increment against.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "FAILURE POINT — ONE AUTO-INCREMENT COLUMN\n\nOne MySQL table hands out the next id, always increasing. Works perfectly — as long as there is only one table to increment against.",
      "lineHeight": 1.3
    },
    {
      "id": "e_r1a2",
      "type": "arrow",
      "x": 790, "y": 221.0, "width": 30, "height": 0,
      "angle": 0, "strokeColor": "#78716c", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 2 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "points": [[0, 0], [30, 0]], "lastCommittedPoint": [30, 0],
      "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle"
    },
    {

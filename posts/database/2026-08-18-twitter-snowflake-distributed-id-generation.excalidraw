    {
      "id": "e_r3res",
      "type": "rectangle",
      "x": 820, "y": 576, "width": 380, "height": 140,
      "angle": 0, "strokeColor": "#166534", "backgroundColor": "#bbf7d0",
      "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_r3res_t",
      "type": "text",
      "x": 836, "y": 588, "width": 348, "height": 116,
      "angle": 0, "strokeColor": "#14532d", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "ONE 64-BIT ID\n\nMinimum 10,000 ids/sec/process. 2ms response time. Ordering k-sorted within a promised 1 second.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "ONE 64-BIT ID\n\nMinimum 10,000 ids/sec/process. 2ms response time. Ordering k-sorted within a promised 1 second.",
      "lineHeight": 1.3
    },
    {
      "id": "e_footer",
      "type": "rectangle",
      "x": 60, "y": 736, "width": 1140, "height": 130,
      "angle": 0, "strokeColor": "#1f2937", "backgroundColor": "#e5e7eb",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_footer_t",
      "type": "text",
      "x": 74, "y": 744, "width": 1112, "height": 114,
      "angle": 0, "strokeColor": "#111827", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "Snowflake's one undesignable dependency: time. If NTP steps the clock backward, it refuses to generate ids until the clock passes the last timestamp it already used — stalling rather than breaking order. Fourteen years later, Discord ships the same idea with a different split: 42-bit timestamp / 5-bit worker / 5-bit process / 12-bit increment, its own 2015 epoch. The shape survived. The bits didn't have to match.",
      "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Snowflake's one undesignable dependency: time. If NTP steps the clock backward, it refuses to generate ids until the clock passes the last timestamp it already used — stalling rather than breaking order. Fourteen years later, Discord ships the same idea with a different split: 42-bit timestamp / 5-bit worker / 5-bit process / 12-bit increment, its own 2015 epoch. The shape survived. The bits didn't have to match.",
      "lineHeight": 1.3
    }
  ],

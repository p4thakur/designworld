      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": { "type": 3 }, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false
    },
    {
      "id": "e_r3c3_t",
      "type": "text",
      "x": 554, "y": 588, "width": 192, "height": 116,
      "angle": 0, "strokeColor": "#14532d", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1787040000000, "link": null, "locked": false,
      "text": "12-BIT SEQUENCE\n\nRolls over every 4,096 ids per machine per millisecond.",
      "fontSize": 11, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top",
      "containerId": null,
      "originalText": "12-BIT SEQUENCE\n\nRolls over every 4,096 ids per machine per millisecond.",

      "updated": 1,
      "link": null,
      "locked": false,
      "text": "LinkedIn Killed the Lambda Architecture by Deleting One of Its Two Databases",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LinkedIn Killed the Lambda Architecture by Deleting One of Its Two Databases",
      "lineHeight": 1.25
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 40,
      "y": 68,
      "width": 1120,
      "height": 26,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "LinkedIn Engineering blog, Venice series (2017-2022) — one database replacing a batch store plus a streaming store",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LinkedIn Engineering blog, Venice series (2017-2022) — one database replacing a batch store plus a streaming store",
      "lineHeight": 1.25
    },
    {

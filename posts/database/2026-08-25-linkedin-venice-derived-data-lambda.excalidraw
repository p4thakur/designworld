      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE LAMBDA ARCHITECTURE TAX",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",

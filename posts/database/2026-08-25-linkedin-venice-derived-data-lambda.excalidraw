    {
      "id": "results-text",
      "type": "text",
      "x": 60,
      "y": 616,
      "width": 1080,
      "height": 68,
      "angle": 0,
      "strokeColor": "#0f5750",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "25TB+ ingested per day · 100K+ QPS per data center · 1,800+ datasets · 300+ applications. The storage\nengine itself was swapped BDB-JE to RocksDB with zero app intervention — the interface those 300\napplications depend on never changed.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "25TB+ ingested per day · 100K+ QPS per data center · 1,800+ datasets · 300+ applications. The storage\nengine itself was swapped BDB-JE to RocksDB with zero app intervention — the interface those 300\napplications depend on never changed.",
      "lineHeight": 1.3
    },

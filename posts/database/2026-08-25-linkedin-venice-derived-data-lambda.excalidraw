    {
      "id": "footer-text",
      "type": "text",
      "x": 60,
      "y": 728,
      "width": 1080,
      "height": 72,
      "angle": 0,
      "strokeColor": "#4c1d95",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Lambda architecture isn't wrong. It's a tax collected at the wrong layer — paid by every application, on\nevery read, forever. LinkedIn moved that tax into the log once, and every team downstream stopped paying it.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lambda architecture isn't wrong. It's a tax collected at the wrong layer — paid by every application, on\nevery read, forever. LinkedIn moved that tax into the log once, and every team downstream stopped paying it.",
      "lineHeight": 1.3
    }

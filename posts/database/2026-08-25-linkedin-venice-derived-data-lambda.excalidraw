    {
      "id": "right-text",
      "type": "text",
      "x": 660,
      "y": 250,
      "width": 480,
      "height": 170,
      "angle": 0,
      "strokeColor": "#0f5750",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ONE database. Every write —\nHadoop batch job or Samza\nstreaming job — funnels through\nKafka first. Storage nodes just\nconsume the log. Reconciliation\nis a property of the log, not a\nper-read decision the app makes.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ONE database. Every write —\nHadoop batch job or Samza\nstreaming job — funnels through\nKafka first. Storage nodes just\nconsume the log. Reconciliation\nis a property of the log, not a\nper-read decision the app makes.",
      "lineHeight": 1.3
    },

    {
      "id": "convergence-text",
      "type": "text",
      "x": 60,
      "y": 494,
      "width": 1080,
      "height": 64,
      "angle": 0,
      "strokeColor": "#7a4d0b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE SINGLE ENTRY POINT — Kafka's log unifies both write paths. A hybrid mode layers continuous streaming\nupdates on top of the batch push: datasets go from stale-a-day to fresh-to-the-minute, with zero changes\non the application read path.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE SINGLE ENTRY POINT — Kafka's log unifies both write paths. A hybrid mode layers continuous streaming\nupdates on top of the batch push: datasets go from stale-a-day to fresh-to-the-minute, with zero changes\non the application read path.",
      "lineHeight": 1.3
    },

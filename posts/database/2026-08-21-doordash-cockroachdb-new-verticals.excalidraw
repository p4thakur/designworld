      "link": null,
      "locked": false,
      "text": "THE CEILING\n\nstore_items nears DoorDash's own 500GB single-table limit. Writer CPU tops 80% at peak. Bulk-upsert latency doubles.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE CEILING\n\nstore_items nears DoorDash's own 500GB single-table limit. Writer CPU tops 80% at peak. Bulk-upsert latency doubles.",
      "lineHeight": 1.3
    },
    {

      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787000000000,
      "link": null,
      "locked": false,
      "text": "The single-writer Postgres cluster wasn't a bad design. It was the right one for a single-vertical,\nsingle-region business. A database's ceiling is often a description of the business it was built for,\nnot a flaw in the database. When the business changes shape, the datastore has to change shape with it.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The single-writer Postgres cluster wasn't a bad design. It was the right one for a single-vertical, single-region business. A database's ceiling is often a description of the business it was built for, not a flaw in the database. When the business changes shape, the datastore has to change shape with it.",
      "lineHeight": 1.3
    }

      "link": null,
      "locked": false,
      "text": "DoorDash's Database Rule: No Table Over 500GB. One Table Broke It in Months.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DoorDash's Database Rule: No Table Over 500GB. One Table Broke It in Months.",
      "lineHeight": 1.25
    },

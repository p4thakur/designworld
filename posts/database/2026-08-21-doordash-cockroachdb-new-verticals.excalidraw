      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787000000000,
      "link": null,
      "locked": false,
      "text": "ORIGINAL DESIGN\n\nAurora Postgres. Single writer, multiple read replicas, writer pinned to one AZ. Fine for years of single-vertical delivery.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ORIGINAL DESIGN\n\nAurora Postgres. Single writer, multiple read replicas, writer pinned to one AZ. Fine for years of single-vertical delivery.",
      "lineHeight": 1.3
    },
    {

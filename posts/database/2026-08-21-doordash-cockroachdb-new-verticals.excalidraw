      "updated": 1787000000000,
      "link": null,
      "locked": false,
      "text": "500GB table limit, breached in months → CPU 80%+, latency 2x → CockroachDB + hash-sharded indexes → ~10x faster queries",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "500GB table limit, breached in months → CPU 80%+, latency 2x → CockroachDB + hash-sharded indexes → ~10x faster queries",
      "lineHeight": 1.25
    },

      "boundElements": null,
      "updated": 1787000000000,
      "link": null,
      "locked": false,
      "text": "NEW VERTICALS ARRIVE\n\nGrocery, convenience, retail launch. store_items — catalog, inventory, and pricing for every item at every store — grows non-linearly.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NEW VERTICALS ARRIVE\n\nGrocery, convenience, retail launch. store_items — catalog, inventory, and pricing for every item at every store — grows non-linearly.",
      "lineHeight": 1.3
    },

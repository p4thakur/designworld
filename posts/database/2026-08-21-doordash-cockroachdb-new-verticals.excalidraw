      "boundElements": null,
      "updated": 1787000000000,
      "link": null,
      "locked": false,
      "text": "DoorDash Engineering blog, Jan 2025 — the fulfillment backend outgrew single-writer Aurora Postgres and moved to distributed CockroachDB",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DoorDash Engineering blog, Jan 2025 — the fulfillment backend outgrew single-writer Aurora Postgres and moved to distributed CockroachDB",
      "lineHeight": 1.25
    },

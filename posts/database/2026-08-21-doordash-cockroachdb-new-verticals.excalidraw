    {
      "id": "e_footer_t",
      "type": "text",
      "x": 76,
      "y": 548,
      "width": 1058,
      "height": 86,
      "angle": 0,
      "strokeColor": "#5b21b6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

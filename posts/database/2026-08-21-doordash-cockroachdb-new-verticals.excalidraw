      "isDeleted": false,
      "boundElements": null,
      "updated": 1787000000000,
      "link": null,
      "locked": false,
      "text": "THE MOVE\n\nCockroachDB: distributed, shared-nothing, no single writer. Hash-sharded indexes added to avoid range hotspots on sequential keys.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE MOVE\n\nCockroachDB: distributed, shared-nothing, no single writer. Hash-sharded indexes added to avoid range hotspots on sequential keys.",
      "lineHeight": 1.3
    },

    {
      "id": "t_5",
      "type": "text",
      "x": 50,
      "y": 565,
      "width": 1040,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752624000000,
      "link": null,
      "locked": false,
      "text": "RESULT: ~73x lower query latency · ~14x higher throughput vs HBase\nODS: ~450 qps at launch → Gorilla: 5,000+ steady-state qps, peaks past 40,000\nProlonged outage: WAL replay can't keep up → Gorilla keeps the last ~1 minute, drops the rest, stays fast",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "RESULT: ~73x lower query latency · ~14x higher throughput vs HBase\nODS: ~450 qps at launch → Gorilla: 5,000+ steady-state qps, peaks past 40,000\nProlonged outage: WAL replay can't keep up → Gorilla keeps the last ~1 minute, drops the rest, stays fast",
      "lineHeight": 1.2
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 675,
      "width": 1140,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752624000000,
      "link": null,
      "locked": false,
      "text": "The architecture wasn't the trick. Making a full day of every metric on the fleet fit in RAM was — and the\ncompression that did it just mirrors the shape of the signal: fixed interval, barely changing, read as a recent range.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The architecture wasn't the trick. Making a full day of every metric on the fleet fit in RAM was — and the\ncompression that did it just mirrors the shape of the signal: fixed interval, barely changing, read as a recent range.",
      "lineHeight": 1.2
    }

      "boundElements": null,
      "updated": 1752624000000,
      "link": null,
      "locked": false,
      "text": "THE MISMATCH\n\nAn incident query scans the\nfreshest, least-compacted\ndata across thousands of\nseries at once — exactly\nwhen everyone else queries\ntoo. More HBase just widens\nthe same fan-out.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "THE MISMATCH\n\nAn incident query scans the\nfreshest, least-compacted\ndata across thousands of\nseries at once — exactly\nwhen everyone else queries\ntoo. More HBase just widens\nthe same fan-out.",
      "lineHeight": 1.2
    },

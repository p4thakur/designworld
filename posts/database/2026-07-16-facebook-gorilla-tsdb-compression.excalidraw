      "updated": 1752624000000,
      "link": null,
      "locked": false,
      "text": "GORILLA: THE FIX\n\nIn-memory only, sharded per\nhost, holds the most recent\n26 hours as a write-through\ncache in front of HBase.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "GORILLA: THE FIX\n\nIn-memory only, sharded per\nhost, holds the most recent\n26 hours as a write-through\ncache in front of HBase.",
      "lineHeight": 1.2
    },

      "locked": false
    },
    {
      "id": "t_s2",
      "type": "text",
      "x": 316,
      "y": 124,
      "width": 218,
      "height": 182,
      "angle": 0,
      "strokeColor": "#1e3a8a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751587200000,
      "link": null,
      "locked": false,
      "text": "The catch\nMhBtree is a MySQL storage\nplugin \u2014 ~15k lines of C++\nwrapped around the MySQL\nhandler interface. Changing it\nmeans knowing InnoDB\ninternals, not just Manhattan.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_s2",
      "originalText": "The catch\nMhBtree is a MySQL storage\nplugin \u2014 ~15k lines of C++\nwrapped around the MySQL\nhandler interface. Changing it\nmeans knowing InnoDB\ninternals, not just Manhattan.",
      "lineHeight": 1.3
    },

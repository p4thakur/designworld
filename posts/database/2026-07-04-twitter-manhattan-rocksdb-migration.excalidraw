      "text": "Twitter's Manhattan: Retiring the Homegrown Storage Engines",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Twitter's Manhattan: Retiring the Homegrown Storage Engines",

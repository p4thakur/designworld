    {
      "id": "t_s3",
      "type": "text",
      "x": 586,
      "y": 124,
      "width": 218,
      "height": 182,
      "angle": 0,
      "strokeColor": "#78350f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751587200000,
      "link": null,
      "locked": false,
      "text": "2018 \u2014 The call\nInstead of a third custom\nengine, the team adopts\nRocksDB, Facebook's open-\nsource LSM engine, as\nManhattan's one and only\nstorage engine.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_s3",
      "originalText": "2018 \u2014 The call\nInstead of a third custom\nengine, the team adopts\nRocksDB, Facebook's open-\nsource LSM engine, as\nManhattan's one and only\nstorage engine.",
      "lineHeight": 1.3
    },

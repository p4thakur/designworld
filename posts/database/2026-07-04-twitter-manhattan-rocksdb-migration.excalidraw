      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751587200000,
      "link": null,
      "locked": false,
      "text": "2018\u20132021 \u2014 Migration\nTweets, User profiles, Direct\nMessages move cluster by\ncluster. Trillions of keys.\nPetabytes of data. Three\nyears, start to finish.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_s4",
      "originalText": "2018\u20132021 \u2014 Migration\nTweets, User profiles, Direct\nMessages move cluster by\ncluster. Trillions of keys.\nPetabytes of data. Three\nyears, start to finish.",
      "lineHeight": 1.3
    },

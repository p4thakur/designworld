      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751587200000,
      "link": null,
      "locked": false,
      "text": "2014 \u2014 Launch\nTwo in-house engines: SSTable\n(LSM, write-optimized) +\nMhBtree (B-tree, read-\noptimized). Most production\ntraffic runs on MhBtree.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_s1",
      "originalText": "2014 \u2014 Launch\nTwo in-house engines: SSTable\n(LSM, write-optimized) +\nMhBtree (B-tree, read-\noptimized). Most production\ntraffic runs on MhBtree.",
      "lineHeight": 1.3
    },
    {
      "id": "b_s2",
      "type": "rectangle",
      "x": 300,
      "y": 110,
      "width": 250,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e40af",
      "backgroundColor": "#eff6ff",
      "fillStyle": "solid",

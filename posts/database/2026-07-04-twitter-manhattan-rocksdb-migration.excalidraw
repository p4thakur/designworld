    {
      "id": "t_result",
      "type": "text",
      "x": 46,
      "y": 362,
      "width": 1028,
      "height": 86,
      "angle": 0,
      "strokeColor": "#4c1d95",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751587200000,
      "link": null,
      "locked": false,
      "text": "Result: same or better latency than the engines it replaced. Lower CPU utilization.\n~50% less disk space per node. Twitter deleted about a third of its storage-engine\ncode and close to 10% of Manhattan's entire codebase.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "b_result",
      "originalText": "Result: same or better latency than the engines it replaced. Lower CPU utilization.\n~50% less disk space per node. Twitter deleted about a third of its storage-engine\ncode and close to 10% of Manhattan's entire codebase.",
      "lineHeight": 1.35
    }

    {"id":"e_footer_t","type":"text","x":74,"y":624,"width":1072,"height":64,"angle":0,"strokeColor":"#1e293b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"Sometimes the right architecture isn't a new database. It's a strict, deterministic consistency layer wrapped around the boring storage engine you already trust — until connection scaling becomes the next boring problem to solve.","fontSize":12,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Sometimes the right architecture isn't a new database. It's a strict, deterministic consistency layer wrapped around the boring storage engine you already trust — until connection scaling becomes the next boring problem to solve.","lineHeight":1.25}

    {"id":"e_r_label","type":"text","x":615,"y":102,"width":545,"height":20,"angle":0,"strokeColor":"#0f766e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"WHAT LINKEDIN BUILT: ESPRESSO ON MYSQL","fontSize":13,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"WHAT LINKEDIN BUILT: ESPRESSO ON MYSQL","lineHeight":1.25},
    {"id":"e_l1","type":"rectangle","x":60,"y":132,"width":545,"height":86,"angle":0,"strokeColor":"#6d28d9","backgroundColor":"#ede9fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":{"type":3},"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false},
    {"id":"e_l1_t","type":"text","x":72,"y":140,"width":521,"height":70,"angle":0,"strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"Cassandra-style multi-master: any of a partition's replicas can accept a write for the same key.","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Cassandra-style multi-master: any of a partition's replicas can accept a write for the same key.","lineHeight":1.25},

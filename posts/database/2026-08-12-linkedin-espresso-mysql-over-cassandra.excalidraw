    {"id":"e_l2","type":"rectangle","x":60,"y":250,"width":545,"height":86,"angle":0,"strokeColor":"#6d28d9","backgroundColor":"#ede9fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":{"type":3},"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false},
    {"id":"e_l2_t","type":"text","x":72,"y":258,"width":521,"height":70,"angle":0,"strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"Conflicts between concurrent writes get resolved later, after the fact. Fast, near-infinite horizontal scale.","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Conflicts between concurrent writes get resolved later, after the fact. Fast, near-infinite horizontal scale.","lineHeight":1.25},
    {"id":"e_la2","type":"arrow","x":332,"y":336,"width":0,"height":28,"angle":0,"strokeColor":"#6d28d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":{"type":2},"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"points":[[0,0],[0,28]],"lastCommittedPoint":[0,28],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"triangle"},
    {"id":"e_l3","type":"rectangle","x":60,"y":368,"width":545,"height":78,"angle":0,"strokeColor":"#6d28d9","backgroundColor":"#f5f3ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":{"type":3},"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false},
    {"id":"e_l3_t","type":"text","x":72,"y":376,"width":521,"height":62,"angle":0,"strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"No guaranteed read-your-own-writes. Bad when a member needs their own InMail or profile edit to show up immediately.","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"No guaranteed read-your-own-writes. Bad when a member needs their own InMail or profile edit to show up immediately.","lineHeight":1.25},
    {"id":"e_r1","type":"rectangle","x":615,"y":132,"width":545,"height":86,"angle":0,"strokeColor":"#0f766e","backgroundColor":"#ccfbf1","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":{"type":3},"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false},
    {"id":"e_r1_t","type":"text","x":627,"y":140,"width":521,"height":70,"angle":0,"strokeColor":"#134e4a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"Espresso: exactly one master per partition. Every write for that partition goes through it, in order.","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Espresso: exactly one master per partition. Every write for that partition goes through it, in order.","lineHeight":1.25},
    {"id":"e_ra1","type":"arrow","x":887,"y":218,"width":0,"height":28,"angle":0,"strokeColor":"#0f766e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":{"type":2},"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"points":[[0,0],[0,28]],"lastCommittedPoint":[0,28],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"triangle"},
    {"id":"e_r2","type":"rectangle","x":615,"y":250,"width":545,"height":86,"angle":0,"strokeColor":"#0f766e","backgroundColor":"#ccfbf1","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":{"type":3},"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false},
    {"id":"e_r2_t","type":"text","x":627,"y":258,"width":521,"height":70,"angle":0,"strokeColor":"#134e4a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"Storage underneath is plain MySQL InnoDB — disk I/O, buffer pools, crash recovery already solved. Buffer pool lives outside the JVM heap, dodging Java GC pauses.","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Storage underneath is plain MySQL InnoDB — disk I/O, buffer pools, crash recovery already solved. Buffer pool lives outside the JVM heap, dodging Java GC pauses.","lineHeight":1.25},

    {"id":"e_title","type":"text","x":30,"y":18,"width":1140,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"LinkedIn Rejected Multi-Master NoSQL. They Built a Database on Top of MySQL Instead.","fontSize":16,"fontFamily":1,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"LinkedIn Rejected Multi-Master NoSQL. They Built a Database on Top of MySQL Instead.","lineHeight":1.25},
    {"id":"e_sub","type":"text","x":30,"y":68,"width":1140,"height":20,"angle":0,"strokeColor":"#555555","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"roundness":null,"isDeleted":false,"boundElements":null,"updated":1786240000000,"link":null,"locked":false,"text":"2011: Espresso traded Cassandra's multi-master model for one master per partition on plain MySQL/InnoDB","fontSize":13,"fontFamily":1,"textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"2011: Espresso traded Cassandra's multi-master model for one master per partition on plain MySQL/InnoDB","lineHeight":1.25},

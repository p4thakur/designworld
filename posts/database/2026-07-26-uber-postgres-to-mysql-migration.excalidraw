      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "July 26, 2016 (ten years to this post) — why Uber Engineering moved its core trip data off Postgres and onto MySQL",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "July 26, 2016 (ten years to this post) — why Uber Engineering moved its core trip data off Postgres and onto MySQL",
      "lineHeight": 1.25
    },

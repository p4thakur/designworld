    {
      "id": "t_3",
      "type": "text",
      "x": 645,
      "y": 112,
      "width": 240,
      "height": 155,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "DURING A ROUTINE UPGRADE\n9.2 BUG CORRUPTS REPLICAS\n\nA Postgres 9.2 bug corrupted\nindex pages on upgrade.\nPhysical replication replayed\nit onto every standby. New\nmaster was clean; replicas\nweren't.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "DURING A ROUTINE UPGRADE\n9.2 BUG CORRUPTS REPLICAS\n\nA Postgres 9.2 bug corrupted\nindex pages on upgrade.\nPhysical replication replayed\nit onto every standby. New\nmaster was clean; replicas\nweren't.",
      "lineHeight": 1.25
    },

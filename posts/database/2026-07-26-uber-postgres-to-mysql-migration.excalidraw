    {
      "id": "t_4",
      "type": "text",
      "x": 945,
      "y": 112,
      "width": 210,
      "height": 155,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "EARLY 2014 → OCT 2014\nSCHEMALESS GOES LIVE\n\nRan out of room on Postgres\ntrip tables. Built an append-\nonly, sharded datastore on\nplain MySQL — live in\nproduction by October 2014.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "EARLY 2014 → OCT 2014\nSCHEMALESS GOES LIVE\n\nRan out of room on Postgres\ntrip tables. Built an append-\nonly, sharded datastore on\nplain MySQL — live in\nproduction by October 2014.",
      "lineHeight": 1.25
    },
    {
      "id": "b_callout",
      "type": "rectangle",
      "x": 30,
      "y": 310,
      "width": 1140,
      "height": 120,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "#f8fafc",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 3 },
      "isDeleted": false,
      "boundElements": [{ "id": "t_callout", "type": "text" }],
      "updated": 1753574400000,
      "link": null,
      "locked": false
    },
    {
      "id": "t_callout",
      "type": "text",
      "x": 50,
      "y": 322,
      "width": 1100,
      "height": 96,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "THE ONE-HOP DIFFERENCE\nPostgres secondary indexes point straight at a row's physical location on disk — fast to read, expensive to write,\nbecause every index on a row must be rewritten on any update. MySQL/InnoDB secondary indexes point at the primary\nkey instead. One extra lookup hop at read time buys back most of that write cost, and means a row's physical move\nonly touches the clustered primary index.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "THE ONE-HOP DIFFERENCE\nPostgres secondary indexes point straight at a row's physical location on disk — fast to read, expensive to write,\nbecause every index on a row must be rewritten on any update. MySQL/InnoDB secondary indexes point at the primary\nkey instead. One extra lookup hop at read time buys back most of that write cost, and means a row's physical move\nonly touches the clustered primary index.",
      "lineHeight": 1.3
    },
    {
      "id": "b_changed",
      "type": "rectangle",
      "x": 30,
      "y": 450,
      "width": 1140,
      "height": 110,
      "angle": 0,
      "strokeColor": "#3730a3",
      "backgroundColor": "#eef2ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 3 },
      "isDeleted": false,
      "boundElements": [{ "id": "t_changed", "type": "text" }],
      "updated": 1753574400000,
      "link": null,
      "locked": false
    },
    {
      "id": "t_changed",
      "type": "text",
      "x": 50,
      "y": 465,
      "width": 1100,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "WHAT CHANGED\nResynced every corrupted replica from a fresh master snapshot by hand. Built Schemaless: cells are pure\nINSERT-only JSON blobs, keyed by UUID plus an auto-incrementing added_id, running on ordinary MySQL/InnoDB —\nno in-place updates, no index rewrite storm, no full-table vacuum scans.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "WHAT CHANGED\nResynced every corrupted replica from a fresh master snapshot by hand. Built Schemaless: cells are pure\nINSERT-only JSON blobs, keyed by UUID plus an auto-incrementing added_id, running on ordinary MySQL/InnoDB —\nno in-place updates, no index rewrite storm, no full-table vacuum scans.",
      "lineHeight": 1.3
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 590,
      "width": 1140,
      "height": 50,
      "angle": 0,
      "strokeColor": "#0f766e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "Postgres wasn't the wrong database in 2011. It was the wrong database for what Uber became by 2015. Most\n\"we regret our database\" stories are growth stories wearing a technology costume.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Postgres wasn't the wrong database in 2011. It was the wrong database for what Uber became by 2015. Most\n\"we regret our database\" stories are growth stories wearing a technology costume.",
      "lineHeight": 1.2
    }
  ],

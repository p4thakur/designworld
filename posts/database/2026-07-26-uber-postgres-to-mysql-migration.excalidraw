      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753574400000,
      "link": null,
      "locked": false,
      "text": "AS TRIPS SCALED UP\nWRITE AMPLIFICATION BINDS\n\nIndexes point at a row's\nphysical offset — one column\nupdate rewrites every index.\nAutovacuum needs a full\ntable scan to find garbage.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "AS TRIPS SCALED UP\nWRITE AMPLIFICATION BINDS\n\nIndexes point at a row's\nphysical offset — one column\nupdate rewrites every index.\nAutovacuum needs a full\ntable scan to find garbage.",
      "lineHeight": 1.25
    },

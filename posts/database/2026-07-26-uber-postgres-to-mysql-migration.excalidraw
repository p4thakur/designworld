      "link": null,
      "locked": false,
      "text": "Postgres's Indexes Point at a Disk Address. That One Design Choice Cost Uber a Two-Year Migration.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Postgres's Indexes Point at a Disk Address. That One Design Choice Cost Uber a Two-Year Migration.",
      "lineHeight": 1.25
    },

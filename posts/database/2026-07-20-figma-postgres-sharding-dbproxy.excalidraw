    {
      "id": "t2",
      "type": "text",
      "x": 332,
      "y": 126,
      "width": 236,
      "height": 164,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

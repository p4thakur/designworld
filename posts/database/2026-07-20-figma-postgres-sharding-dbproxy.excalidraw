      "text": "2020: 1 primary, AWS's largest instance  \u00b7  2022: 12 vertically partitioned DBs  \u00b7  Sept 2023: first shards live  \u00b7  ~100x growth",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2020: 1 primary, AWS's largest instance  \u00b7  2022: 12 vertically partitioned DBs  \u00b7  Sept 2023: first shards live  \u00b7  ~100x growth",
      "lineHeight": 1.3
    },

      "updated": 1784544000000,
      "link": null,
      "locked": false,
      "text": "2020 \u2014 ONE PRIMARY\n\nOne Postgres primary, already on AWS's largest physical instance. As Figma grew, some tables reached several terabytes and billions of rows.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "b1",
      "originalText": "2020 \u2014 ONE PRIMARY\n\nOne Postgres primary, already on AWS's largest physical instance. As Figma grew, some tables reached several terabytes and billions of rows.",
      "lineHeight": 1.3
    },

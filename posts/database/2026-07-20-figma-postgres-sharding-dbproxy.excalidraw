    {
      "id": "t3",
      "type": "text",
      "x": 622,
      "y": 126,
      "width": 236,
      "height": 164,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784544000000,
      "link": null,
      "locked": false,
      "text": "2020\u20132022 \u2014 VERTICAL PARTITION\n\nMove whole tables onto their own databases. Logical replication was slow rebuilding indexes row-by-row, so they dropped indexes, bulk-copied, rebuilt after. A dozen DBs by end of 2022.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "b3",
      "originalText": "2020\u20132022 \u2014 VERTICAL PARTITION\n\nMove whole tables onto their own databases. Logical replication was slow rebuilding indexes row-by-row, so they dropped indexes, bulk-copied, rebuilt after. A dozen DBs by end of 2022.",
      "lineHeight": 1.3
    },

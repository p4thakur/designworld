      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784544000000,
      "link": null,
      "locked": false,
      "text": "THE VACUUM CEILING\n\nPostgres never updates rows in place \u2014 every UPDATE/DELETE leaves a dead tuple. Autovacuum must reclaim them before transaction IDs wrap, and that walk costs time proportional to table size.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "b2",
      "originalText": "THE VACUUM CEILING\n\nPostgres never updates rows in place \u2014 every UPDATE/DELETE leaves a dead tuple. Autovacuum must reclaim them before transaction IDs wrap, and that walk costs time proportional to table size.",
      "lineHeight": 1.3
    },

      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Vitess didn't retire the hot-shard problem. It moved what could trigger one — from a customer's size to a job's blast radius.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vitess didn't retire the hot-shard problem. It moved what could trigger one — from a customer's size to a job's blast radius.",

      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2022\n\n\"The Query\nStrikes Again\"\n\nMass user-delete\nwrite storm crashes\na shard's primary.\nNew cause, same\nold shape.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "2022\n\n\"The Query\nStrikes Again\"\n\nMass user-delete\nwrite storm crashes\na shard's primary.\nNew cause, same\nold shape.",
      "lineHeight": 1.25

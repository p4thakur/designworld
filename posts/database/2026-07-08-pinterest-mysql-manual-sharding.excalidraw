      "boundElements": null,
      "updated": 1751932800000,
      "link": null,
      "locked": false,
      "text": "2012 RESULT: 88 sharded MySQL servers · 22M monthly users · 40 engineers\nSame scheme, per Pinterest’s own account, still the core of their datastore years later",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "2012 RESULT: 88 sharded MySQL servers · 22M monthly users · 40 engineers\nSame scheme, per Pinterest’s own account, still the core of their datastore years later",
      "lineHeight": 1.2
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 655,
      "width": 1140,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751932800000,
      "link": null,
      "locked": false,
      "text": "The fashionable fix made rebalancing invisible. The one that survived made failure slow, visible, and\nsomeone’s decision to make. Automation isn’t the goal — a failure mode you can reason about at 3am is.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The fashionable fix made rebalancing invisible. The one that survived made failure slow, visible, and\nsomeone’s decision to make. Automation isn’t the goal — a failure mode you can reason about at 3am is.",
      "lineHeight": 1.2
    }
  ],

    {
      "id": "t_2",
      "type": "text",
      "x": 407,
      "y": 125,
      "width": 311,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

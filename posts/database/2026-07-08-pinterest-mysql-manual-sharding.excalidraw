      "link": null,
      "locked": false,
      "text": "2011: THE BET\n\nAuto-clustering + rebalancing\nlayered on MySQL (Cassandra,\nMembase evaluated). Growth\nshould manage itself.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "2011: THE BET\n\nAuto-clustering + rebalancing\nlayered on MySQL (Cassandra,\nMembase evaluated). Growth\nshould manage itself.",
      "lineHeight": 1.2
    },

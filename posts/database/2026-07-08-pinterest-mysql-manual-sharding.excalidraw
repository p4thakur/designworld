      "x": 772,
      "y": 115,
      "width": 326,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751932800000,
      "link": null,
      "locked": false,
      "text": "2012: THE DECISION\n\nRip out the clustering layer.\nPlain MySQL, sharded by hand.\nNo automatic failover, ever —\na human promotes a replica\nand rebuilds the box.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "2012: THE DECISION\n\nRip out the clustering layer.\nPlain MySQL, sharded by hand.\nNo automatic failover, ever —\na human promotes a replica\nand rebuilds the box.",
      "lineHeight": 1.2
    },
    {
      "id": "e_row2_label",
      "type": "text",
      "x": 30,
      "y": 340,
      "width": 1080,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751932800000,
      "link": null,
      "locked": false,
      "text": "The screenshottable part: a deterministic 64-bit ID replaces any lookup service",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The screenshottable part: a deterministic 64-bit ID replaces any lookup service",
      "lineHeight": 1.2
    },
    {
      "id": "b_4",
      "type": "rectangle",
      "x": 30,
      "y": 370,
      "width": 1080,
      "height": 150,
      "angle": 0,

      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jan 2012: 11.7M monthly users, 6 engineers  ·  Oct 2012: ~22M monthly users, 40 engineers, 88 sharded MySQL boxes",
      "lineHeight": 1.25
    },

      "locked": false
    },
    {
      "id": "t_4",
      "type": "text",
      "x": 50,
      "y": 385,
      "width": 1040,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751932800000,
      "link": null,
      "locked": false,
      "text": "64-BIT OBJECT ID\n\n| 16 bits: shard ID  |  10 bits: type ID  |  36 bits: local ID |\nID = (shard_id << 46) | (type_id << 36) | local_id\n\n4,096 shards live at launch — headroom to 65,536 without re-deriving a single existing ID",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "64-BIT OBJECT ID\n\n| 16 bits: shard ID  |  10 bits: type ID  |  36 bits: local ID |\nID = (shard_id << 46) | (type_id << 36) | local_id\n\n4,096 shards live at launch — headroom to 65,536 without re-deriving a single existing ID",
      "lineHeight": 1.35
    },
    {

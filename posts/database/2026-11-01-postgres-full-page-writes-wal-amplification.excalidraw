   "y": 365,
   "width": 563,
   "height": 20.0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "and row-level WAL records cannot repair a page in unknown state.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",

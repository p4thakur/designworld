   "y": 340,
   "width": 712,
   "height": 20.0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "text": "Why: disk writes 512-byte sectors, page is 8kB. A crash mid-write tears the page,",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 16,
   "containerId": null,
   "originalText": "Why: disk writes 512-byte sectors, page is 8kB. A crash mid-write tears the page,",
   "lineHeight": 1.25
  },
  {

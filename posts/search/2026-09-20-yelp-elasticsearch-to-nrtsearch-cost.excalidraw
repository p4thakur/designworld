      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Not a new architecture - the pre-2017 primary/replica-on-Lucene shape again, with gRPC segments and EBS reattach instead of full S3 snapshots.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",

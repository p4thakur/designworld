      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Rolled out via 1% -> 100% dark launch: 30-50% cut in p50/p95/p99 latency, up to 40% lower\ninfra cost on some workloads, 90%+ of Elasticsearch traffic migrated to Nrtsearch.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rolled out via 1% -> 100% dark launch: 30-50% cut in p50/p95/p99 latency, up to 40% lower\ninfra cost on some workloads, 90%+ of Elasticsearch traffic migrated to Nrtsearch.",
      "lineHeight": 1.25
    },

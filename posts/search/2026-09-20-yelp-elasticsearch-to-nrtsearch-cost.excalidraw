      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Sept 2021\n\nNrtsearch:\n1 primary indexes,\nreplicas just read\n\nsegments on EBS -\ndead replica just\nreattaches volume\n\ngRPC ships new\nsegments, not docs",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sept 2021\n\nNrtsearch:\n1 primary indexes,\nreplicas just read\n\nsegments on EBS -\ndead replica just\nreattaches volume\n\ngRPC ships new\nsegments, not docs",
      "lineHeight": 1.25
    },

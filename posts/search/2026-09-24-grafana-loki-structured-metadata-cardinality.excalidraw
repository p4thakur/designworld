      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The footgun that survived the fix: a Promtail pipeline that materializes a field as a label before\ndemoting it to structured metadata sends it to Loki as a real label -- recreating the exact cardinality\nexplosion structured metadata was built to prevent. (GitHub issue #13229, filed against Loki 3.0.0)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "The footgun that survived the fix: a Promtail pipeline that materializes a field as a label before\ndemoting it to structured metadata sends it to Loki as a real label -- recreating the exact cardinality\nexplosion structured metadata was built to prevent. (GitHub issue #13229, filed against Loki 3.0.0)",
      "lineHeight": 1.3
    }

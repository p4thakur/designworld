      "id": "t33",
      "type": "text",
      "seed": 34,
      "x": 60,
      "y": 405,
      "width": 574,
      "height": 67,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "text": "Otherwise the biggest segment is rewritten again and again\ninto one that is barely bigger: O(N^2) merging.\nException: biggest segment already past 20% deletes.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Otherwise the biggest segment is rewritten again and again\ninto one that is barely bigger: O(N^2) merging.\nException: biggest segment already past 20% deletes.",
      "lineHeight": 1.25
    },

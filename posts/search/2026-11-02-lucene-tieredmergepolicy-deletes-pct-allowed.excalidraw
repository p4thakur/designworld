      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "text": "Merges fire constantly, rewrite nearly\nall segments, degenerate singleton merges\nJavadoc: \"a dark forest\"",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
      "originalText": "Merges fire constantly, rewrite nearly\nall segments, degenerate singleton merges\nJavadoc: \"a dark forest\"",

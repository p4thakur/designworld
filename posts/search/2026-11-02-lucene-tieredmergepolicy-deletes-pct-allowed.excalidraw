      "height": 25,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "text": "Guard rule: skip a merge unless output >= 1.5x the biggest input",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 20,
      "containerId": null,
      "originalText": "Guard rule: skip a merge unless output >= 1.5x the biggest input",
      "lineHeight": 1.25
    },

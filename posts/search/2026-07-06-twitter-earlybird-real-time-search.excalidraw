      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "2008\nTwitter buys Summize\nfor real-time tweet\nsearch. Rails + MySQL,\nB-tree index doing\ndouble duty as\ninverted index.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_1",
      "originalText": "2008\nTwitter buys Summize\nfor real-time tweet\nsearch. Rails + MySQL,\nB-tree index doing\ndouble duty as\ninverted index.",
      "lineHeight": 1.2
    },

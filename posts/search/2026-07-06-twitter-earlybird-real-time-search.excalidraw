      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "Nobody misdesigned Earlybird in 2010 \u2014 it beat MySQL badly on the numbers that mattered then.\nThe system built to escape one era's staleness spent the next decade quietly becoming the source of the next one.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nobody misdesigned Earlybird in 2010 \u2014 it beat MySQL badly on the numbers that mattered then.\nThe system built to escape one era's staleness spent the next decade quietly becoming the source of the next one.",
      "lineHeight": 1.25
    },

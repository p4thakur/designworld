      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "2020\nUnrolled linked lists\nreplaced with skip\nlists \u2014 insertion works\nanywhere. Indexing\nlatency: -90%+, ~1s.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_5",
      "originalText": "2020\nUnrolled linked lists\nreplaced with skip\nlists \u2014 insertion works\nanywhere. Indexing\nlatency: -90%+, ~1s.",
      "lineHeight": 1.2
    },
    {

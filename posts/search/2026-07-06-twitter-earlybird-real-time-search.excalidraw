      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "2012 \u2014 AT SCALE\n~500M tweets/day\ningested. 2B+ queries/\nday, ~50ms avg latency.\n17K QPS on a 16M-tweet\nsegment. Doc IDs: 27-bit\ntimestamp + 4-bit\ncounter (16/\u00b5s cap).",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_3",
      "originalText": "2012 \u2014 AT SCALE\n~500M tweets/day\ningested. 2B+ queries/\nday, ~50ms avg latency.\n17K QPS on a 16M-tweet\nsegment. Doc IDs: 27-bit\ntimestamp + 4-bit\ncounter (16/\u00b5s cap).",
      "lineHeight": 1.2
    },

      "link": null,
      "locked": false,
      "text": "2B+ queries/day  \u00b7  2019: tweets took up to 15s to become searchable  \u00b7  2020: skip lists cut that to ~1s",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2B+ queries/day  \u00b7  2019: tweets took up to 15s to become searchable  \u00b7  2020: skip lists cut that to ~1s",
      "lineHeight": 1.25
    },

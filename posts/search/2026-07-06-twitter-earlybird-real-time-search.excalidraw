      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "2010\nMySQL can't keep up.\nRebuilds search on\nLucene, rewriting\nposting lists to update\nin place. Ships as\n\"Earlybird.\"",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_2",
      "originalText": "2010\nMySQL can't keep up.\nRebuilds search on\nLucene, rewriting\nposting lists to update\nin place. Ships as\n\"Earlybird.\"",
      "lineHeight": 1.2
    },

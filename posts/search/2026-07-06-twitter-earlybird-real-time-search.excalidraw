      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "2019\nOrdering assumption\ncracks. New tweets take\nup to 15s to become\nsearchable \u2014 named for\nbeing early, now behind.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_4",
      "originalText": "2019\nOrdering assumption\ncracks. New tweets take\nup to 15s to become\nsearchable \u2014 named for\nbeing early, now behind.",
      "lineHeight": 1.2
    },

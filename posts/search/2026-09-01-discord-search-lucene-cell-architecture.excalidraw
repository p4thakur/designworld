      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2025\nCELL ARCHITECTURE\n\nMany small clusters,\ngrouped into logical\ncells (guild-messages,\nuser-dm-messages)\n\nMoved to Kubernetes:\nsafer upgrades,\nzone resilience\n\nRedis → Pub/Sub:\nguaranteed delivery\n\nBFGs get custom\nmulti-shard indexes\n— split before the wall",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2025\nCELL ARCHITECTURE\n\nMany small clusters,\ngrouped into logical\ncells (guild-messages,\nuser-dm-messages)\n\nMoved to Kubernetes:\nsafer upgrades,\nzone resilience\n\nRedis → Pub/Sub:\nguaranteed delivery\n\nBFGs get custom\nmulti-shard indexes\n— split before the wall",
      "lineHeight": 1.25
    },
    {
      "id": "footnote",
      "type": "text",
      "x": 40,
      "y": 420,
      "width": 1160,
      "height": 44,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The 2017 design wasn't wrong — it was right for the scale it was built for. The failure mode was arithmetic catching up with growth, one guild at a time.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The 2017 design wasn't wrong — it was right for the scale it was built for. The failure mode was arithmetic catching up with growth, one guild at a time.",
      "lineHeight": 1.25
    }

      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2017–2024\nMONOLITHIC CLUSTERS\n\nElasticsearch, sharded\nby guild or by DM\n\n200+ nodes/cluster\n\nMaster nodes OOM\ntracking cluster state\n\nRedis queue drops\nmessages under load\n\n1 node dies →\n~40% of bulk index\nops fail platform-wide",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2017–2024\nMONOLITHIC CLUSTERS\n\nElasticsearch, sharded\nby guild or by DM\n\n200+ nodes/cluster\n\nMaster nodes OOM\ntracking cluster state\n\nRedis queue drops\nmessages under load\n\n1 node dies →\n~40% of bulk index\nops fail platform-wide",
      "lineHeight": 1.25
    },

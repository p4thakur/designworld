    {
      "id": "t_mech",
      "type": "text",
      "x": 50,
      "y": 492,
      "width": 1090,
      "height": 88,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

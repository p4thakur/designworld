      "updated": 1752710400000,
      "link": null,
      "locked": false,
      "text": "QUEUE OVERFLOWS\n\nSpike arrives faster\nthan segments can be\nwritten + merged. ES\nrejects writes. Clients\nretry → feedback loop.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "QUEUE OVERFLOWS\n\nSpike arrives faster\nthan segments can be\nwritten + merged. ES\nrejects writes. Clients\nretry → feedback loop.",
      "lineHeight": 1.2
    },

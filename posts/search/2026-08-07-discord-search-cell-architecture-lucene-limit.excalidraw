    {
      "id": "e_foot_t",
      "type": "text",
      "x": 76,
      "y": 680,
      "width": 1050,
      "height": 54,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785979775708,
      "link": null,
      "locked": false,
      "text": "Underneath both flows sits a separate, fixed ceiling: a Lucene shard's internal document IDs are 32-bit integers, capping any single shard near 2.1 billion documents \u2014 unrelated to RAM, disk, or node count. Oversized guilds (\"Big Freaking Guilds\") now get dedicated multi-shard indices so they never hit it.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Underneath both flows sits a separate, fixed ceiling: a Lucene shard's internal document IDs are 32-bit integers, capping any single shard near 2.1 billion documents \u2014 unrelated to RAM, disk, or node count. Oversized guilds (\"Big Freaking Guilds\") now get dedicated multi-shard indices so they never hit it.",
      "lineHeight": 1.25
    }

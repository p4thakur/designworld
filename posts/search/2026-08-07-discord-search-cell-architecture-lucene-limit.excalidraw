      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2017 \u2192 2025 \u2014 how a 50-message bulk batch on a 200+ node Elasticsearch cluster turned one bad node into a silent search outage",
      "lineHeight": 1.25
    },

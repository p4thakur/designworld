      "isDeleted": false,
      "boundElements": null,
      "updated": 1753142400000,
      "link": null,
      "locked": false,
      "text": "STILL TOO SLOW\n\nPruning stops helping — exact search degrades back toward visiting nearly the whole tree anyway.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b4",
      "originalText": "STILL TOO SLOW\n\nPruning stops helping — exact search degrades back toward visiting nearly the whole tree anyway.",
      "lineHeight": 1.3
    },
    {

      "link": null,
      "locked": false,
      "text": "THE VECTORS\n\nMatrix factorization on listening data turns every track/user into a vector in f-dimensional space — commonly 40 numbers.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b1",
      "originalText": "THE VECTORS\n\nMatrix factorization on listening data turns every track/user into a vector in f-dimensional space — commonly 40 numbers.",
      "lineHeight": 1.3
    },

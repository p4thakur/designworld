      "updated": 1753142400000,
      "link": null,
      "locked": false,
      "text": "BRUTE FORCE\n\nCompare the query to all ~5M+ others, every request. Linear in catalog size — gets worse exactly as the catalog grows.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b2",
      "originalText": "BRUTE FORCE\n\nCompare the query to all ~5M+ others, every request. Linear in catalog size — gets worse exactly as the catalog grows.",
      "lineHeight": 1.3
    },

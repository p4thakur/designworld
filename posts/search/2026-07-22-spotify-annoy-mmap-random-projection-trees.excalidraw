      "updated": 1753142400000,
      "link": null,
      "locked": false,
      "text": "ROW 2 — THE MEMORY PROBLEM NO ALGORITHMS TEXTBOOK COVERS",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW 2 — THE MEMORY PROBLEM NO ALGORITHMS TEXTBOOK COVERS",
      "lineHeight": 1.2
    },
    {
      "id": "r2_b1",
      "type": "rectangle",
      "x": 30,
      "y": 323,
      "width": 520,

      "link": null,
      "locked": false,
      "text": "Spotify's Annoy: Why a Nearest-Neighbor Index Is a File, Not a Data Structure",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spotify's Annoy: Why a Nearest-Neighbor Index Is a File, Not a Data Structure",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 54,
      "width": 1140,
      "height": 20,

      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753142400000,
      "link": null,
      "locked": false,
      "text": "5M items × 40 floats × 4 bytes = 800MB  ·  built in a Spotify Hack Week, 2013  ·  still mmap'd into every worker",

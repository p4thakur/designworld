      "updated": 1753142400000,
      "link": null,
      "locked": false,
      "text": "KD-TREE (EXACT)\n\nPrunes well only in low dimensions. At 40 dims, a query sits close to a split boundary on almost every axis.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b3",
      "originalText": "KD-TREE (EXACT)\n\nPrunes well only in low dimensions. At 40 dims, a query sits close to a split boundary on almost every axis.",
      "lineHeight": 1.3
    },

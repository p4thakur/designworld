    {
      "id": "callout-text-1",
      "type": "text",
      "x": 65,
      "y": 486,
      "width": 1030,
      "height": 100,
      "angle": 0,
      "strokeColor": "#8a3a00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "↓  rebuilt as a Spark-native pipeline on Airflow, using Elasticsearch's own snapshot format  ↓",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "↓  rebuilt as a Spark-native pipeline on Airflow, using Elasticsearch's own snapshot format  ↓",
      "lineHeight": 1.25
    },
    {

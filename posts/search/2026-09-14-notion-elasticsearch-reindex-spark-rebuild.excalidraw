      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The part most \"we moved to Spark\" posts skip: the old catchup pipeline didn't just run slowly.\nEdits it couldn't reconcile were silently dropped as \"unmatched\" blocks - no alert, no record.\nThis wasn't only a speed fix. It was a caught correctness bug.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The part most \"we moved to Spark\" posts skip: the old catchup pipeline didn't just run slowly.\nEdits it couldn't reconcile were silently dropped as \"unmatched\" blocks - no alert, no record.\nThis wasn't only a speed fix. It was a caught correctness bug.",
      "lineHeight": 1.3
    },

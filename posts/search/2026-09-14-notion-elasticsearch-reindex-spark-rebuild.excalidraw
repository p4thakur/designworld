      "type": "text",
      "x": 65,
      "y": 105,
      "width": 1030,
      "height": 120,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Before: custom pipeline on ECS, rebuilt once a quarter\nFull rebuild: 2+ weeks, babysitting OOM crashes and worker-coordination failures\nSeparate ECS \"catchup\" pipeline replays the Kafka backlog after the build finishes -> 2 more\ndays, same OOM/coordination issues, before the index is actually current",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before: custom pipeline on ECS, rebuilt once a quarter\nFull rebuild: 2+ weeks, babysitting OOM crashes and worker-coordination failures\nSeparate ECS \"catchup\" pipeline replays the Kafka backlog after the build finishes -> 2 more\ndays, same OOM/coordination issues, before the index is actually current",
      "lineHeight": 1.3
    },
    {
      "id": "divider-text-1",
      "type": "text",
      "x": 40,
      "y": 250,
      "width": 1080,
      "height": 30,

      "updated": 1751414400000,
      "link": null,
      "locked": false,
      "text": "The last, hardest leg: moving ~10PB and\nbillions of files out of S3 with zero downtime.\n\nCustom tooling ran bucket listings in parallel —\na multi-day job became ~30 minutes.\n\nWhen AWS saw the account was really leaving,\nit waived a $250,000 egress fee on the way out.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "b_s3",
      "originalText": "The last, hardest leg: moving ~10PB and\nbillions of files out of S3 with zero downtime.\n\nCustom tooling ran bucket listings in parallel —\na multi-day job became ~30 minutes.\n\nWhen AWS saw the account was really leaving,\nit waived a $250,000 egress fee on the way out.",
      "lineHeight": 1.3
    },

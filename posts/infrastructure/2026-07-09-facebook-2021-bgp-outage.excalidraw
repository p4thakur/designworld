      "boundElements": null,
      "updated": 1783670400000,
      "link": null,
      "locked": false,
      "text": "THE IRONY: DNS servers can't reach the data center network → they correctly diagnose\nthemselves as unhealthy → they withdraw their own BGP advertisements. The address book\nunlists itself. Facebook, Instagram, WhatsApp, Messenger, Oculus: all unreachable — no server crashed.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_dns",
      "originalText": "THE IRONY: DNS servers can't reach the data center network → they correctly diagnose\nthemselves as unhealthy → they withdraw their own BGP advertisements. The address book\nunlists itself. Facebook, Instagram, WhatsApp, Messenger, Oculus: all unreachable — no server crashed.",
      "lineHeight": 1.3
    },

      "isDeleted": false,
      "boundElements": null,
      "updated": 1783670400000,
      "link": null,
      "locked": false,
      "text": "KNOCK-ON: PHYSICAL ACCESS\nBadge readers on data center doors run\non the same backbone. Engineers need\nphysical tools to force their way in.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_badge",
      "originalText": "KNOCK-ON: PHYSICAL ACCESS\nBadge readers on data center doors run\non the same backbone. Engineers need\nphysical tools to force their way in.",

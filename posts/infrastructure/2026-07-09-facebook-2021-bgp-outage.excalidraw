    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 795,
      "width": 1040,
      "height": 40,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783670400000,
      "link": null,
      "locked": false,
      "text": "No one made an obviously bad call — every safeguard was reasonable alone.\nStacked together, they locked the fixers out of the thing they needed to fix.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No one made an obviously bad call — every safeguard was reasonable alone.\nStacked together, they locked the fixers out of the thing they needed to fix.",

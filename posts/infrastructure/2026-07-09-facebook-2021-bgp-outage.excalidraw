      "boundElements": null,
      "updated": 1783670400000,
      "link": null,
      "locked": false,
      "text": "KNOCK-ON: TOOLING\nThe tools engineers would normally use\nto diagnose and fix a network outage\nalso depend on the same internal DNS.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_tool",
      "originalText": "KNOCK-ON: TOOLING\nThe tools engineers would normally use\nto diagnose and fix a network outage\nalso depend on the same internal DNS.",
      "lineHeight": 1.2
    },

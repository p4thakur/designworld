    {
      "id": "text_right",
      "type": "text",
      "x": 680,
      "y": 105,
      "width": 520,
      "height": 220,
      "angle": 0,
      "strokeColor": "#4c2889",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2015 — WHAT NETFLIX BUILT INSTEAD\n\nTitus, on Apache Mesos\n\nMetadata-proxy on every agent VM: each container gets only its own declared IAM role\n\nLegacy apps run unchanged\n\nBy 2018: millions of containers/week, 1,000+ workloads, 3 AWS regions",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2015 — WHAT NETFLIX BUILT INSTEAD\n\nTitus, on Apache Mesos\n\nMetadata-proxy on every agent VM: each container gets only its own declared IAM role\n\nLegacy apps run unchanged\n\nBy 2018: millions of containers/week, 1,000+ workloads, 3 AWS regions",
      "lineHeight": 1.3
    },

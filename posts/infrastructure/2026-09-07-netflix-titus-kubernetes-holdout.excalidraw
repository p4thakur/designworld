    {
      "id": "banner_text",
      "type": "text",
      "x": 60,
      "y": 415,
      "width": 1140,
      "height": 120,
      "angle": 0,
      "strokeColor": "#d9480f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2026 — THE TWIST\n\nNetflix guts CMB (its own 2018 batch layer on Titus) and adopts Kueue — an open-source, Kubernetes-native queueing system.\nBut it picks Kueue specifically because, unlike YuniKorn or Volcano, it doesn't replace pod scheduling. Existing Titus scheduling logic stays intact.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2026 — THE TWIST\n\nNetflix guts CMB (its own 2018 batch layer on Titus) and adopts Kueue — an open-source, Kubernetes-native queueing system.\nBut it picks Kueue specifically because, unlike YuniKorn or Volcano, it doesn't replace pod scheduling. Existing Titus scheduling logic stays intact.",
      "lineHeight": 1.3
    },
    {
      "id": "footnote",
      "type": "text",
      "x": 40,
      "y": 570,
      "width": 1180,
      "height": 40,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The constraint that made Kubernetes wrong for Netflix in 2015 — coarse, node-level identity for a decade of existing apps — was gone by 2026.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The constraint that made Kubernetes wrong for Netflix in 2015 — coarse, node-level identity for a decade of existing apps — was gone by 2026.",
      "lineHeight": 1.25
    }

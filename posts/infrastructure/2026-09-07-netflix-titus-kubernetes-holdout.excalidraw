      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2015 — THE \"OBVIOUS\" PATH\n\nKubernetes & Docker Swarm racing to become the default container orchestrator\n\nBuilt for greenfield apps\nBuilt for node-level AWS permissions\n\n\"Just adopt whatever the ecosystem is converging on.\"",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2015 — THE \"OBVIOUS\" PATH\n\nKubernetes & Docker Swarm racing to become the default container orchestrator\n\nBuilt for greenfield apps\nBuilt for node-level AWS permissions\n\n\"Just adopt whatever the ecosystem is converging on.\"",
      "lineHeight": 1.3
    },

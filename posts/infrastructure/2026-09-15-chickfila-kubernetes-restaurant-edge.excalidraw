      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WHAT CHICK-FIL-A BUILT\n(2018-- , 'Redundant Restaurant\nCompute' -> Kubernetes / K3s)\n\nPOS terminal\n   -> In-restaurant K8s cluster\n   -> Kitchen equipment (local)\n\nCluster buffers, compresses, and\ndecides -- syncs to cloud only\nwhen the link is up.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHAT CHICK-FIL-A BUILT\n(2018-- , 'Redundant Restaurant\nCompute' -> Kubernetes / K3s)\n\nPOS terminal\n   -> In-restaurant K8s cluster\n   -> Kitchen equipment (local)\n\nCluster buffers, compresses, and\ndecides -- syncs to cloud only\nwhen the link is up.",
      "lineHeight": 1.3
    },

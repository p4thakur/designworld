      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One dropped link at lunch rush = no orders,\nno fryer timing, no card payments.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One dropped link at lunch rush = no orders,\nno fryer timing, no card payments.",
      "lineHeight": 1.25

      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE DEFAULT ARCHITECTURE\n(thin edge, fat cloud)\n\nPOS terminal\n   -> Internet\n   -> Centralized cloud order pipeline\n   -> Internet\n   -> Kitchen equipment (fryer, KDS)\n\nEvery order round-trips a link\nbetween the register and a\ndata center, twice.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE DEFAULT ARCHITECTURE\n(thin edge, fat cloud)\n\nPOS terminal\n   -> Internet\n   -> Centralized cloud order pipeline\n   -> Internet\n   -> Kitchen equipment (fryer, KDS)\n\nEvery order round-trips a link\nbetween the register and a\ndata center, twice.",
      "lineHeight": 1.3
    },
    {
      "id": "leftFailure",
      "type": "text",
      "x": 60,
      "y": 330,
      "width": 480,
      "height": 40,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",

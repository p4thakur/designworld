      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "THE RECOVERY\n\n~90 minutes fully unusable, roughly 7:00–8:30am PST. Around 8:15am PST provision-service recovers and healthy instances start entering service.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b3",
      "originalText": "THE RECOVERY\n\n~90 minutes fully unusable, roughly 7:00–8:30am PST. Around 8:15am PST provision-service recovers and healthy instances start entering service.",
      "lineHeight": 1.3
    },

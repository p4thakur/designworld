      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "ROW 1 — THE CASCADE: HOW A COLD-CACHE MORNING BECAME A NETWORK OUTAGE",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW 1 — THE CASCADE: HOW A COLD-CACHE MORNING BECAME A NETWORK OUTAGE",
      "lineHeight": 1.2
    },
    {
      "id": "r1_b1",
      "type": "rectangle",
      "x": 30,
      "y": 113,
      "width": 260,
      "height": 170,
      "angle": 0,

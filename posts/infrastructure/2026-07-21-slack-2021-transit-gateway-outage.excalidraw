      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "THE FIX\n\nAfterward, AWS moves Slack off a shared Transit Gateway onto a dedicated one, and grows cross-boundary capacity for that attachment.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b4",
      "originalText": "THE FIX\n\nAfterward, AWS moves Slack off a shared Transit Gateway onto a dedicated one, and grows cross-boundary capacity for that attachment.",
      "lineHeight": 1.3
    },

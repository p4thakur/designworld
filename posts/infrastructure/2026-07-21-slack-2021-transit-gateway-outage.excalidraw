    {
      "id": "r1_t2",
      "type": "text",
      "x": 332,
      "y": 126,
      "width": 236,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "THE SATURATION\n\nTraffic outruns how fast the Transit Gateway's control plane can provision more forwarding capacity for the attachment. Packets queue, then drop, between backend servers.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b2",
      "originalText": "THE SATURATION\n\nTraffic outruns how fast the Transit Gateway's control plane can provision more forwarding capacity for the attachment. Packets queue, then drop, between backend servers.",
      "lineHeight": 1.3
    },
    {
      "id": "r1_a2",
      "type": "arrow",
      "x": 580,
      "y": 198,
      "width": 30,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 2 },
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,

    {
      "id": "r2_t2",
      "type": "text",
      "x": 332,
      "y": 341,
      "width": 236,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "THE SECOND FAILURE\n\nProvisioning 1,200 instances in a 15-minute window drives provision-service into a Linux open-file-descriptor limit nobody had sized for a burst that size.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b2",
      "originalText": "THE SECOND FAILURE\n\nProvisioning 1,200 instances in a 15-minute window drives provision-service into a Linux open-file-descriptor limit nobody had sized for a burst that size.",
      "lineHeight": 1.3
    },
    {

      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "THE RECONNECT STORM\n\nTwo quiet holiday weeks end at once. Cold client caches mean full resyncs, not deltas. Cross-VPC traffic through Slack's shared AWS Transit Gateway spikes past a normal Monday.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b1",
      "originalText": "THE RECONNECT STORM\n\nTwo quiet holiday weeks end at once. Cold client caches mean full resyncs, not deltas. Cross-VPC traffic through Slack's shared AWS Transit Gateway spikes past a normal Monday.",
      "lineHeight": 1.3
    },
    {
      "id": "r1_a1",
      "type": "arrow",
      "x": 290,
      "y": 198,
      "width": 30,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 2 },
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,

    {
      "id": "r1_t4",
      "type": "text",
      "x": 912,
      "y": 126,
      "width": 236,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "THE DOWNSCALE\n\nBefore 7:00am PST, the autoscaler reads low CPU as spare capacity and scales the web tier DOWN — removing capacity in the middle of the degradation.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b4",
      "originalText": "THE DOWNSCALE\n\nBefore 7:00am PST, the autoscaler reads low CPU as spare capacity and scales the web tier DOWN — removing capacity in the middle of the degradation.",
      "lineHeight": 1.3
    },
    {
      "id": "e_row2_label",
      "type": "text",
      "x": 30,
      "y": 303,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#065f46",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "ROW 2 — THE OVERCORRECTION, THE SECOND FAILURE, AND THE FIX",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW 2 — THE OVERCORRECTION, THE SECOND FAILURE, AND THE FIX",
      "lineHeight": 1.2
    },
    {
      "id": "r2_b1",
      "type": "rectangle",
      "x": 30,
      "y": 328,
      "width": 260,
      "height": 170,
      "angle": 0,
      "strokeColor": "#b91c1c",
      "backgroundColor": "#fee2e2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 3 },
      "isDeleted": false,
      "boundElements": [{ "id": "r2_t1", "type": "text" }],
      "updated": 1753084620000,
      "link": null,
      "locked": false
    },
    {
      "id": "r2_t1",
      "type": "text",
      "x": 42,
      "y": 341,
      "width": 236,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "THE OVERCORRECTION\n\nApache worker-thread utilization — the other autoscaling signal — catches up and spikes. 7:01–7:15am PST: Slack tries to add 1,200 servers at once.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b1",
      "originalText": "THE OVERCORRECTION\n\nApache worker-thread utilization — the other autoscaling signal — catches up and spikes. 7:01–7:15am PST: Slack tries to add 1,200 servers at once.",
      "lineHeight": 1.3
    },
    {
      "id": "r2_a1",
      "type": "arrow",
      "x": 290,
      "y": 413,
      "width": 30,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 2 },
      "isDeleted": false,
      "boundElements": null,

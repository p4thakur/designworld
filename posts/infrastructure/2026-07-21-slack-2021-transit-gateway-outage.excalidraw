    {
      "id": "r1_t3",
      "type": "text",
      "x": 622,
      "y": 126,
      "width": 236,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "THE WRONG SIGNAL\n\nPacket loss → TCP retransmits → threads blocked waiting on the network, not computing. CPU utilization reads low right when the service is most saturated.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b3",
      "originalText": "THE WRONG SIGNAL\n\nPacket loss → TCP retransmits → threads blocked waiting on the network, not computing. CPU utilization reads low right when the service is most saturated.",
      "lineHeight": 1.3
    },
    {
      "id": "r1_a3",
      "type": "arrow",
      "x": 870,
      "y": 198,
      "width": 30,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 2 },
      "isDeleted": false,
      "boundElements": null,

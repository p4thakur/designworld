      "text": "Slack's January 4th 2021 Outage: When the Autoscaler Read the Wrong Number",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Slack's January 4th 2021 Outage: When the Autoscaler Read the Wrong Number",
      "lineHeight": 1.25
    },
    {

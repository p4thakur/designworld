      "boundElements": null,
      "updated": 1753084620000,
      "link": null,
      "locked": false,
      "text": "99% success rate at 6:57am PST (normal: >99.999%)  ·  1,200 servers requested in 15 min  ·  ~90 min fully down",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "99% success rate at 6:57am PST (normal: >99.999%)  ·  1,200 servers requested in 15 min  ·  ~90 min fully down",
      "lineHeight": 1.25
    },
    {

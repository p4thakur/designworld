      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "THE UNIFIED FIX: PELOTON, BUILT ON MESOS",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE UNIFIED FIX: PELOTON, BUILT ON MESOS",
      "lineHeight": 1.25
    },
    {
      "id": "e_fix",
      "type": "rectangle",
      "x": 60,
      "y": 538,
      "width": 1090,
      "height": 120,
      "angle": 0,
      "strokeColor": "#6d28d9",
      "backgroundColor": "#ede9fe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 3 },
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false
    },
    {
      "id": "e_fix_t",
      "type": "text",
      "x": 76,
      "y": 550,
      "width": 1058,
      "height": 96,
      "angle": 0,
      "strokeColor": "#6d28d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "One scheduler, one shared pool, modeled loosely on Google's internal Borg (never made public). Four cooperating\ndaemons: Job Manager (lifecycle) • Resource Manager (hierarchical max-min fairness between teams) • Placement\nEngine (maps tasks to hosts) • Host Manager (abstracts Mesos). Overcommit + preemption let batch and ML jobs\nsoak up whatever stateless services aren't using.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One scheduler, one shared pool, modeled loosely on Google's internal Borg (never made public). Four cooperating daemons: Job Manager (lifecycle) • Resource Manager (hierarchical max-min fairness between teams) • Placement Engine (maps tasks to hosts) • Host Manager (abstracts Mesos). Overcommit + preemption let batch and ML jobs soak up whatever stateless services aren't using.",
      "lineHeight": 1.3
    },

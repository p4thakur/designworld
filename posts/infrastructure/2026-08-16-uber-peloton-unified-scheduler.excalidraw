    {
      "id": "e_result_t",
      "type": "text",
      "x": 76,
      "y": 410,
      "width": 1058,
      "height": 56,
      "angle": 0,
      "strokeColor": "#be123c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,

      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "Uber Engineering blog, Oct 2018 — three siloed schedulers replaced by Peloton, a unified scheduler built on Mesos instead of adopting Kubernetes",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uber Engineering blog, Oct 2018 — three siloed schedulers replaced by Peloton, a unified scheduler built on Mesos instead of adopting Kubernetes",
      "lineHeight": 1.25
    },

      "text": "Uber's Fix for Cluster Sprawl Wasn't Kubernetes. It Was Refusing to Use It.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uber's Fix for Cluster Sprawl Wasn't Kubernetes. It Was Refusing to Use It.",

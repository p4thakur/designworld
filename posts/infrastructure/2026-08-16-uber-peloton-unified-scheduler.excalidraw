      "isDeleted": false,
      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "THE REAL COST — Uber wasn't rejecting Kubernetes out of stubbornness. It didn't fit workloads shaped like theirs:\nthree scheduling problems fighting over the same idle hardware on opposite shifts. Building Peloton cost a\ndedicated infra team more than a year — a price worth paying only when the shared-scheduler math pays for itself.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE REAL COST — Uber wasn't rejecting Kubernetes out of stubbornness. It didn't fit workloads shaped like theirs: three scheduling problems fighting over the same idle hardware on opposite shifts. Building Peloton cost a dedicated infra team more than a year — a price worth paying only when the shared-scheduler math pays for itself.",
      "lineHeight": 1.3
    }

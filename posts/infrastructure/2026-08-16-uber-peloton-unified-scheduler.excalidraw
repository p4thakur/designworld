      "boundElements": null,
      "updated": 1786650000000,
      "link": null,
      "locked": false,
      "text": "BATCH / HADOOP\n\nRun on YARN, which has almost no support for anything that isn't a batch job. Its own static cluster too.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BATCH / HADOOP\n\nRun on YARN, which has almost no support for anything that isn't a batch job. Its own static cluster too.",
      "lineHeight": 1.3
    },

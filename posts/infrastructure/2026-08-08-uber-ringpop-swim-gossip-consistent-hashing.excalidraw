      "boundElements": null,
      "updated": 1785979775708,
      "link": null,
      "locked": false,
      "text": "FarmHash + red-black tree ring, O(log n). A node joining/leaving remaps only\nits own slice. Client can hit ANY node (blue) \u2014 wrong node forwards to the\nreal owner (amber), never rejects.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FarmHash + red-black tree ring, O(log n). A node joining/leaving remaps only\nits own slice. Client can hit ANY node (blue) \u2014 wrong node forwards to the\nreal owner (amber), never rejects.",
      "lineHeight": 1.25
    },

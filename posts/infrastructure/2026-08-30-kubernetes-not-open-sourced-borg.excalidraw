      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Kubernetes Isn't Open-Sourced Borg. It's Google's Third Rewrite Of The Same Idea.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kubernetes Isn't Open-Sourced Borg. It's Google's Third Rewrite Of The Same Idea.",
      "lineHeight": 1.25
    },
    {
      "id": "l1",
      "type": "text",
      "x": 40,
      "y": 100,
      "width": 280,
      "height": 28,
      "angle": 0,
      "strokeColor": "#991b1b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE ASSUMPTION",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE ASSUMPTION",
      "lineHeight": 1.25
    },
    {
      "id": "box1",
      "type": "rectangle",
      "x": 40,
      "y": 135,
      "width": 280,
      "height": 280,

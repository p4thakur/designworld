    {
      "id": "t1",
      "type": "text",
      "x": 58,
      "y": 151,
      "width": 244,
      "height": 248,
      "angle": 0,
      "strokeColor": "#991b1b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\"Google took its\ninternal weapon, Borg,\nand open-sourced it.\"\nThe line everyone\nrepeats at conferences\nand in blog posts about\nKubernetes' origin.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Google took its\ninternal weapon, Borg,\nand open-sourced it.\"\nThe line everyone\nrepeats at conferences\nand in blog posts about\nKubernetes' origin.",
      "lineHeight": 1.25
    },
    {
      "id": "l2",
      "type": "text",
      "x": 355,
      "y": 100,
      "width": 280,
      "height": 28,
      "angle": 0,
      "strokeColor": "#1d4ed8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WHY YOU CAN'T JUST SHIP IT",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHY YOU CAN'T JUST SHIP IT",
      "lineHeight": 1.25
    },
    {
      "id": "box2",
      "type": "rectangle",
      "x": 355,
      "y": 135,
      "width": 280,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1d4ed8",
      "backgroundColor": "#dbeafe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": { "type": 3 },
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "t2",
      "type": "text",
      "x": 373,
      "y": 151,
      "width": 244,
      "height": 248,
      "angle": 0,
      "strokeColor": "#1d4ed8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Borg's task identity ran\nthrough Chubby (lock\nservice). Storage\nassumed Colossus\n(cluster filesystem).\nJob specs were written\nin BCL, Google's own\nconfig language.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Borg's task identity ran\nthrough Chubby (lock\nservice). Storage\nassumed Colossus\n(cluster filesystem).\nJob specs were written\nin BCL, Google's own\nconfig language.",
      "lineHeight": 1.25
    },
    {
      "id": "l3",
      "type": "text",
      "x": 670,
      "y": 100,
      "width": 280,
      "height": 28,
      "angle": 0,
      "strokeColor": "#6d28d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE ACTUAL REWRITE",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE ACTUAL REWRITE",
      "lineHeight": 1.25
    },

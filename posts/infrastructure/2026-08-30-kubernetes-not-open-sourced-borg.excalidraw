    {
      "id": "t3",
      "type": "text",
      "x": 688,
      "y": 151,
      "width": 244,
      "height": 248,
      "angle": 0,
      "strokeColor": "#6d28d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "3 engineers (Beda,\nMcLuckie, Burns) wrote\nit from scratch in Go —\na language Borg never\nran in — on purpose, for\nzero code-level tie to\nBorg. Codename:\nProject Seven.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3 engineers (Beda,\nMcLuckie, Burns) wrote\nit from scratch in Go —\na language Borg never\nran in — on purpose, for\nzero code-level tie to\nBorg. Codename:\nProject Seven.",
      "lineHeight": 1.25
    },
    {
      "id": "l4",
      "type": "text",
      "x": 985,
      "y": 100,
      "width": 280,
      "height": 28,
      "angle": 0,
      "strokeColor": "#15803d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ONE IDEA, THREE NAMES",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ONE IDEA, THREE NAMES",
      "lineHeight": 1.25
    },
    {
      "id": "box4",
      "type": "rectangle",
      "x": 985,
      "y": 135,
      "width": 280,
      "height": 280,
      "angle": 0,
      "strokeColor": "#15803d",
      "backgroundColor": "#dcfce7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",

    },
    {
      "id": "t4",
      "type": "text",
      "x": 1003,
      "y": 151,
      "width": 244,
      "height": 248,
      "angle": 0,
      "strokeColor": "#15803d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Borg's \"alloc\" (shared\nwrapper for sidecar\ntasks) became Omega's\n\"SUnit,\" then\nKubernetes' \"Pod.\"\nSame concept, rebuilt\nfrom scratch three\ntimes.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Borg's \"alloc\" (shared\nwrapper for sidecar\ntasks) became Omega's\n\"SUnit,\" then\nKubernetes' \"Pod.\"\nSame concept, rebuilt\nfrom scratch three\ntimes.",
      "lineHeight": 1.25
    },

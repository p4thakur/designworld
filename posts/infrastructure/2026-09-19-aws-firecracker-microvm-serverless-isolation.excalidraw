      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Containers alone\n\nshared host kernel\nfast boot, low overhead\n\nrisk: one syscall escape\ncrosses tenants\n\nnot enough for strangers'\ncode by itself",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Containers alone\n\nshared host kernel\nfast boot, low overhead\n\nrisk: one syscall escape\ncrosses tenants\n\nnot enough for strangers'\ncode by itself",
      "lineHeight": 1.25
    },

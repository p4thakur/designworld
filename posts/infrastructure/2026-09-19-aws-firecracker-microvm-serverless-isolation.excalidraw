      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Full VM per task\n(pre-2018 Fargate)\n\nfull BIOS + device tree\ndozens of emulated devices\n\nboot: seconds\n1 dedicated EC2 VM\nper container task",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Full VM per task\n(pre-2018 Fargate)\n\nfull BIOS + device tree\ndozens of emulated devices\n\nboot: seconds\n1 dedicated EC2 VM\nper container task",
      "lineHeight": 1.25
    },

      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Result: up to 150 microVMs launched per second on a single host, thousands packed onto one\nmachine. Lambda and Fargate both moved onto it - Fargate retiring its one-EC2-VM-per-task\nworkaround in the process.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Result: up to 150 microVMs launched per second on a single host, thousands packed onto one\nmachine. Lambda and Fargate both moved onto it - Fargate retiring its one-EC2-VM-per-task\nworkaround in the process.",
      "lineHeight": 1.25
    },

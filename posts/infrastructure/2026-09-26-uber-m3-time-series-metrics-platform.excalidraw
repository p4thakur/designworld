      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TODAY\n6.6B time series\n\n500M metrics/sec\ningested\n\n20M/sec persisted,\nquorum write to\n3 replicas\n\n2,500 queries/sec\n~8.5B datapoints/sec\nout",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TODAY\n6.6B time series\n\n500M metrics/sec\ningested\n\n20M/sec persisted,\nquorum write to\n3 replicas\n\n2,500 queries/sec\n~8.5B datapoints/sec\nout",
      "lineHeight": 1.25
    },

      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "THE ASSUMPTION\n\nDistributed Erlang: sending to a\nremote PID looks exactly like a\nlocal send/2. Location transparency\nby design \u2014 the network is hidden\nfrom the code.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_1",
      "originalText": "THE ASSUMPTION\n\nDistributed Erlang: sending to a\nremote PID looks exactly like a\nlocal send/2. Location transparency\nby design \u2014 the network is hidden\nfrom the code.",
      "lineHeight": 1.2
    },
    {

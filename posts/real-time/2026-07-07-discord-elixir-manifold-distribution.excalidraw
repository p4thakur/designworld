    {
      "id": "t_2",
      "type": "text",
      "x": 407,
      "y": 130,
      "width": 311,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "AT SCALE (2017)\n\nGuild GenServer loops send/2 over\n~100K session PIDs across dozens\nof nodes. Each remote call: ~70\u00b5s.\nMailbox falls behind its own\nmessage queue.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_2",
      "originalText": "AT SCALE (2017)\n\nGuild GenServer loops send/2 over\n~100K session PIDs across dozens\nof nodes. Each remote call: ~70\u00b5s.\nMailbox falls behind its own\nmessage queue.",
      "lineHeight": 1.2
    },

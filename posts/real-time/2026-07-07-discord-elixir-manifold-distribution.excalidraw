      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "Discord vs. Distributed Erlang's Free Lunch",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Discord vs. Distributed Erlang's Free Lunch",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 58,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "5M concurrent users \u00b7 up to 30K in one guild (r/Overwatch) \u00b7 ~100K session PIDs per busy guild process",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5M concurrent users \u00b7 up to 30K in one guild (r/Overwatch) \u00b7 ~100K session PIDs per busy guild process",
      "lineHeight": 1.25
    },
    {
      "id": "b_1",
      "type": "rectangle",

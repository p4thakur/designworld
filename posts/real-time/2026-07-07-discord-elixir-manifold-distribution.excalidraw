    {
      "id": "t_3",
      "type": "text",
      "x": 772,
      "y": 115,
      "width": 326,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "MANIFOLD\n\nGroup target PIDs by remote node.\nSend one batched message per node\nto a local Manifold.Partitioner,\nwhich fans out from there.\n\nResult: packets/sec drop by half,\nimmediately.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_3",
      "originalText": "MANIFOLD\n\nGroup target PIDs by remote node.\nSend one batched message per node\nto a local Manifold.Partitioner,\nwhich fans out from there.\n\nResult: packets/sec drop by half,\nimmediately.",
      "lineHeight": 1.2
    },
    {
      "id": "e_row2_label",
      "type": "text",
      "x": 30,
      "y": 345,
      "width": 1080,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "The same fix, twice: the consistent-hash ring that finds which node owns a guild",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The same fix, twice: the consistent-hash ring that finds which node owns a guild",
      "lineHeight": 1.25
    },

      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "Ring lookup: ~12\u00b5s each.\nFine \u2014 until a crash forces a mass\nreconnect storm.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_4",
      "originalText": "Ring lookup: ~12\u00b5s each.\nFine \u2014 until a crash forces a mass\nreconnect storm.",
      "lineHeight": 1.2
    },

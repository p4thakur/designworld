    {
      "id": "t_1",
      "type": "text",
      "x": 42,
      "y": 130,
      "width": 311,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

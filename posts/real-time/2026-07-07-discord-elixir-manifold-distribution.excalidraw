      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "Fix: ring rewritten in pure Elixir,\ncopied continuously into ETS \u2014\nno single owner process to queue behind.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_6",
      "originalText": "Fix: ring rewritten in pure Elixir,\ncopied continuously into ETS \u2014\nno single owner process to queue behind.",
      "lineHeight": 1.2
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 30,
      "y": 500,
      "width": 1140,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "Location transparency didn't get removed either time. Discord just stopped paying its cost by accident, once per\nPID, and started paying it on purpose, once per node.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Location transparency didn't get removed either time. Discord just stopped paying its cost by accident, once per\nPID, and started paying it on purpose, once per node.",
      "lineHeight": 1.25
    }

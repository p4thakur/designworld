      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1751673600000,
      "link": null,
      "locked": false,
      "text": "Re-running that lookup for every\nreconnecting session: ~30s of pure\nlookup cost, on top of the outage.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b_5",
      "originalText": "Re-running that lookup for every\nreconnecting session: ~30s of pure\nlookup cost, on top of the outage.",
      "lineHeight": 1.2
    },

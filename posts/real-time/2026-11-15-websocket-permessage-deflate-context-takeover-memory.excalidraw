   "text": "10 / 3  ->  37 KiB, but +70% size        no context takeover  ->  14 KiB, but +350% size",
   "originalText": "10 / 3  ->  37 KiB, but +70% size        no context takeover  ->  14 KiB, but +350% size",
   "fontSize": 16,
   "fontFamily": 1,

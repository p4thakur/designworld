   "roundness": null,
   "seed": 147,
   "version": 1,
   "versionNonce": 21,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The asymmetry: a server can shrink the window it COMPRESSES with on its own.\nShrinking the window it DECOMPRESSES with needs the client to support client_max_window_bits.\nIf not, the server still holds a 32K inflate window for that socket.",
   "originalText": "The asymmetry: a server can shrink the window it COMPRESSES with on its own.\nShrinking the window it DECOMPRESSES with needs the client to support client_max_window_bits.\nIf not, the server still holds a 32K inflate window for that socket.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 16,
   "containerId": null,
   "lineHeight": 1.25
  },

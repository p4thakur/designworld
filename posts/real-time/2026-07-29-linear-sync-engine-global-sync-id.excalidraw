      "type": "text",
      "x": 45,
      "y": 940,
      "width": 1110,
      "height": 70,
      "angle": 0,
      "strokeColor": "#065f46",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

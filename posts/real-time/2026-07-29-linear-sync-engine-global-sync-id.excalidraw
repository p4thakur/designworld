      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "SCALING FIX: bootstrap cost tracks workspace STRUCTURE (labels, states, projects \u2014 bounded), not workspace SIZE\n(issues, comments \u2014 unbounded, lazy-hydrated per view). A 10,000-issue workspace boots about as fast as a 100-issue one.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCALING FIX: bootstrap cost tracks workspace STRUCTURE (labels, states, projects \u2014 bounded), not workspace SIZE\n(issues, comments \u2014 unbounded, lazy-hydrated per view). A 10,000-issue workspace boots about as fast as a 100-issue one.",
      "lineHeight": 1.25
    },

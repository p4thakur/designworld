    {
      "id": "mech_t",
      "type": "text",
      "x": 45,
      "y": 830,
      "width": 1110,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "MECHANISM: a sync id is a client-side LSN; IndexedDB is the replica. Total order (not CRDT partial order) is enough\nbecause the only question is \"did I receive every change since my checkpoint\" \u2014 the same question a Postgres replica asks.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MECHANISM: a sync id is a client-side LSN; IndexedDB is the replica. Total order (not CRDT partial order) is enough\nbecause the only question is \"did I receive every change since my checkpoint\" \u2014 the same question a Postgres replica asks.",
      "lineHeight": 1.25
    },
    {

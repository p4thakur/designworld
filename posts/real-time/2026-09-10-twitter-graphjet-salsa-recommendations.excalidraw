      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "GRAPHJET (2016)\nLive, one JVM server\n\nFull interaction graph in memory,\nsliding window of recent hours.\n\n1,000,000 edges/sec ingested\n500 recs/sec served\n= millions of edge reads/sec\n\nRanks with personalized SALSA:\na forward-backward random walk\n(user > tweet > user), not PageRank's\none-way walk — built for a\nbipartite graph, not a web graph.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GRAPHJET (2016)\nLive, one JVM server\n\nFull interaction graph in memory,\nsliding window of recent hours.\n\n1,000,000 edges/sec ingested\n500 recs/sec served\n= millions of edge reads/sec\n\nRanks with personalized SALSA:\na forward-backward random walk\n(user > tweet > user), not PageRank's\none-way walk — built for a\nbipartite graph, not a web graph.",
      "lineHeight": 1.25
    }

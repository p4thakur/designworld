      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786240000000, "link": null, "locked": false,
      "text": "Discord Fixed Its Global Voice Latency Problem. The Real Bugs Showed Up After the Fix Was Right.",
      "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Discord Fixed Its Global Voice Latency Problem. The Real Bugs Showed Up After the Fix Was Right.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30, "y": 68, "width": 1140, "height": 20,
      "angle": 0, "strokeColor": "#555555", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0,
      "opacity": 100, "groupIds": [], "roundness": null, "isDeleted": false,
      "boundElements": null, "updated": 1786240000000, "link": null, "locked": false,
      "text": "Discord's and Cloudflare's own postmortems: moving voice onto a 300-PoP edge network fixed the geography problem, then surfaced an ISP transit bottleneck and a kernel-level CPU contention bug",
      "fontSize": 13, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top",
      "containerId": null,
      "originalText": "Discord's and Cloudflare's own postmortems: moving voice onto a 300-PoP edge network fixed the geography problem, then surfaced an ISP transit bottleneck and a kernel-level CPU contention bug",
      "lineHeight": 1.25
    },

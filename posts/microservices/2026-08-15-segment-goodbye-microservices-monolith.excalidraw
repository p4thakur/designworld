      "link": null,
      "locked": false,
      "text": "Centrifuge: one router\nreplaces every queue,\nfeeds all destinations\ninto one monolith with\na shared worker pool.\n\n1 year. Their 2 most\nsenior engineers.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Centrifuge: one router\nreplaces every queue,\nfeeds all destinations\ninto one monolith with\na shared worker pool.\n\n1 year. Their 2 most\nsenior engineers.",
      "lineHeight": 1.3
    },

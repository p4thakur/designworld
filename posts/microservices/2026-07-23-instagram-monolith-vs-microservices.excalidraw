      "link": null,
      "locked": false,
      "text": "WHAT THEY BUILT\n\nStateless Django + Gunicorn behind Amazon's ELB. No session pinned to any box — any of N identical processes can answer any request.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b2",
      "originalText": "WHAT THEY BUILT\n\nStateless Django + Gunicorn behind Amazon's ELB. No session pinned to any box — any of N identical processes can answer any request.",
      "lineHeight": 1.3
    },

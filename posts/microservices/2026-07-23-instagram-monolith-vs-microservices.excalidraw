      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "WHY IT DOESN'T FIT 3 ENGINEERS\n\nEvery service boundary becomes a network call, a serialization format, a versioned contract, its own on-call rotation. Coordination cost outgrows a 3-person team before the user base does.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b1",
      "originalText": "WHY IT DOESN'T FIT 3 ENGINEERS\n\nEvery service boundary becomes a network call, a serialization format, a versioned contract, its own on-call rotation. Coordination cost outgrows a 3-person team before the user base does.",
      "lineHeight": 1.3
    },
    {
      "id": "r2_b2",
      "type": "rectangle",
      "x": 340,
      "y": 293,
      "width": 330,
      "height": 170,
      "angle": 0,
      "strokeColor": "#0f766e",
      "backgroundColor": "#f0fdfa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": { "type": 3 },
      "isDeleted": false,
      "boundElements": [{ "id": "r2_t2", "type": "text" }],
      "updated": 1753228800000,
      "link": null,
      "locked": false
    },
    {
      "id": "r2_t2",
      "type": "text",
      "x": 352,
      "y": 306,
      "width": 306,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "WHERE SCALING ACTUALLY HAPPENED\n\nScaling out = clone the process. A handful of app boxes grew to 25+ Amazon High-CPU XL instances — zero service-boundary decisions, zero new failure modes.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r2_b2",
      "originalText": "WHERE SCALING ACTUALLY HAPPENED\n\nScaling out = clone the process. A handful of app boxes grew to 25+ Amazon High-CPU XL instances — zero service-boundary decisions, zero new failure modes.",
      "lineHeight": 1.3
    },
    {
      "id": "e_row2_label",
      "type": "text",
      "x": 30,
      "y": 483,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "ROW 2 — WHERE THE REAL COMPLEXITY WENT",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROW 2 — WHERE THE REAL COMPLEXITY WENT",
      "lineHeight": 1.2
    },
    {
      "id": "r3_b1",
      "type": "rectangle",
      "x": 30,
      "y": 508,
      "width": 1140,

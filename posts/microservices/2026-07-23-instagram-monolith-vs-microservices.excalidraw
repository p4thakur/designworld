      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "THE \"OBVIOUS\" FIX\n\nCarve photos, feed, comments, and auth into independently deployed services, so each can scale and be staffed on its own.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r1_b1",
      "originalText": "THE \"OBVIOUS\" FIX\n\nCarve photos, feed, comments, and auth into independently deployed services, so each can scale and be staffed on its own.",
      "lineHeight": 1.3
    },

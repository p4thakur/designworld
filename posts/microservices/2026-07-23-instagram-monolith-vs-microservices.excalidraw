    {
      "id": "r2_t1",
      "type": "text",
      "x": 42,
      "y": 306,
      "width": 236,
      "height": 144,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,

      "boundElements": null,
      "updated": 1752364800000,
      "link": null,
      "locked": false,
      "text": "Every language: its own retry logic, its own stats. ELB/CloudWatch can't show p50/p99. Devs avoid critical-path service calls \u2014 nobody can tell why a call failed.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every language: its own retry logic, its own stats. ELB/CloudWatch can't show p50/p99. Devs avoid critical-path service calls \u2014 nobody can tell why a call failed.",
      "lineHeight": 1.25
    },

      "updated": 1752364800000,
      "link": null,
      "locked": false,
      "text": "Same sidecar regardless of app language. A struggling downstream degrades \u2014 Envoy caps concurrent retries into it \u2014 instead of every caller's retry storm taking it fully down.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same sidecar regardless of app language. A struggling downstream degrades \u2014 Envoy caps concurrent retries into it \u2014 instead of every caller's retry storm taking it fully down.",

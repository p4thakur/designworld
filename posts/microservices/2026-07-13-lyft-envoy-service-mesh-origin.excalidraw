      "updated": 1752364800000,
      "link": null,
      "locked": false,
      "text": "Lyft Had 30 Microservices and Was Already Afraid of Its Own Network. That Fear Built Envoy.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lyft Had 30 Microservices and Was Already Afraid of Its Own Network. That Fear Built Envoy.",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 54,
      "width": 1040,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1752364800000,
      "link": null,
      "locked": false,
      "text": "Before Envoy: a black-box network and a client library per language. After: one sidecar, uniform everywhere, retries capped before they cascade.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before Envoy: a black-box network and a client library per language. After: one sidecar, uniform everywhere, retries capped before they cascade.",
      "lineHeight": 1.25
    },

      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "PHASE 1 (2013 \u2192 2017): THE THREAD BOTTLENECK",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PHASE 1 (2013 \u2192 2017): THE THREAD BOTTLENECK",
      "lineHeight": 1.25
    },
    {
      "id": "r1",
      "type": "rectangle",
      "x": 30,
      "y": 118,
      "width": 350,
      "height": 150,
      "angle": 0,
      "strokeColor": "#b91c1c",
      "backgroundColor": "#fef2f2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

    {
      "id": "r2",
      "type": "rectangle",
      "x": 470,
      "y": 118,
      "width": 350,
      "height": 150,
      "angle": 0,
      "strokeColor": "#0f766e",
      "backgroundColor": "#f0fdfa",
      "fillStyle": "solid",

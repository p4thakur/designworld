          "id": "r3_t",
          "type": "text"
        }
      ],
      "updated": 1753228800000,
      "link": null,
      "locked": false
    },
    {
      "id": "r3_t",
      "type": "text",
      "x": 855,
      "y": 128,
      "width": 300,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e3a8a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "Measured result (I/O-bound cluster)\n\nLogging pipeline: +25% throughput,\n\u221225% CPU\n\nAPI cluster (CPU-heavy per-request\nwork): 0% gain \u2014 event loop only\nwins when the wait is I/O.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Measured result (I/O-bound cluster)\n\nLogging pipeline: +25% throughput,\n\u221225% CPU\n\nAPI cluster (CPU-heavy per-request\nwork): 0% gain \u2014 event loop only\nwins when the wait is I/O.",
      "lineHeight": 1.25
    },
    {
      "id": "row2_h",
      "type": "text",
      "x": 30,
      "y": 300,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "PHASE 2 (2017 \u2192 2023): THE CONNECTION BOTTLENECK",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PHASE 2 (2017 \u2192 2023): THE CONNECTION BOTTLENECK",
      "lineHeight": 1.25
    },
    {
      "id": "r4",
      "type": "rectangle",
      "x": 30,
      "y": 328,
      "width": 520,
      "height": 130,
      "angle": 0,
      "strokeColor": "#b45309",
      "backgroundColor": "#fffbeb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": {
        "type": 3
      },
      "isDeleted": false,
      "boundElements": [
        {
          "id": "r4_t",
          "type": "text"
        }
      ],
      "updated": 1753228800000,
      "link": null,
      "locked": false
    },
    {
      "id": "r4_t",
      "type": "text",
      "x": 45,
      "y": 338,
      "width": 490,
      "height": 110,
      "angle": 0,
      "strokeColor": "#78350f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "The event loop fixed threads, but each\nevent loop keeps its own per-host pool.\n\ninstances \u00d7 event loops \u00d7 backend hosts\nmultiplies fast \u2014 worsened by autoscaling\nopening/closing connections constantly.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The event loop fixed threads, but each\nevent loop keeps its own per-host pool.\n\ninstances \u00d7 event loops \u00d7 backend hosts\nmultiplies fast \u2014 worsened by autoscaling\nopening/closing connections constantly.",
      "lineHeight": 1.25
    },
    {
      "id": "a2",
      "type": "arrow",
      "x": 560,
      "y": 393,
      "width": 60,
      "height": 0,

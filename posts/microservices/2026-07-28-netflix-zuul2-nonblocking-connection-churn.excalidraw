      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "2013: thread-per-connection \u00b7 2017: event-loop rewrite (Zuul 2) \u00b7 2023: connection-churn fix \u2014 same gateway, two ceilings",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2013: thread-per-connection \u00b7 2017: event-loop rewrite (Zuul 2) \u00b7 2023: connection-churn fix \u2014 same gateway, two ceilings",
      "lineHeight": 1.25
    },
    {
      "id": "row1_h",
      "type": "text",
      "x": 30,

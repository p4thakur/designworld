      "locked": false
    },
    {
      "id": "r5_t",
      "type": "text",
      "x": 645,
      "y": 338,
      "width": 510,
      "height": 110,
      "angle": 0,
      "strokeColor": "#4c1d95",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "Fix: HTTP/2 multiplexing (many logical\nrequests share one TCP connection) +\nsubsetting (each instance only connects\nto a bounded slice of backend hosts).\n\nPeak connections: \u221210x across all 3 regions,\nsome shards cut by up to 13M connections.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fix: HTTP/2 multiplexing (many logical\nrequests share one TCP connection) +\nsubsetting (each instance only connects\nto a bounded slice of backend hosts).\n\nPeak connections: \u221210x across all 3 regions,\nsome shards cut by up to 13M connections.",
      "lineHeight": 1.25
    },
    {
      "id": "r6",
      "type": "rectangle",
      "x": 30,
      "y": 490,
      "width": 1140,
      "height": 90,
      "angle": 0,
      "strokeColor": "#475569",
      "backgroundColor": "#f8fafc",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": {
        "type": 3
      },
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false
    },
    {
      "id": "r6_t",
      "type": "text",
      "x": 50,
      "y": 502,
      "width": 1100,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1753228800000,
      "link": null,
      "locked": false,
      "text": "The mechanism match: the primitive that scales with traffic is whatever you multiply requests by. Thread-per-connection\nmultiplies by concurrent slow waits \u2014 an event loop fixes that by holding waits as callback state, not threads. But the\nfix introduces a new multiplication (instances \u00d7 loops \u00d7 hosts), which is why the same gateway needed a second rewrite.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The mechanism match: the primitive that scales with traffic is whatever you multiply requests by. Thread-per-connection\nmultiplies by concurrent slow waits \u2014 an event loop fixes that by holding waits as callback state, not threads. But the\nfix introduces a new multiplication (instances \u00d7 loops \u00d7 hosts), which is why the same gateway needed a second rewrite.",
      "lineHeight": 1.25
    },

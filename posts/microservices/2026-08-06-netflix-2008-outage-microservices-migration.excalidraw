      "updated": 1785979775708,
      "link": null,
      "locked": false,
      "text": "Hystrix bulkhead:\nthread pool full, fails fast",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hystrix bulkhead:\nthread pool full, fails fast",
      "lineHeight": 1.25
    },
    {
      "id": "e_micro_caption",
      "type": "text",
      "x": 640,
      "y": 545,
      "width": 530,
      "height": 40,
      "angle": 0,
      "strokeColor": "#312e81",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785979775708,
      "link": null,
      "locked": false,
      "text": "1 service fails. The bulkhead caps the blast radius at its\nown thread pool — the other three don't even notice.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 service fails. The bulkhead caps the blast radius at its\nown thread pool — the other three don't even notice.",
      "lineHeight": 1.3
    },
    {
      "id": "e_footnote",
      "type": "text",
      "x": 40,
      "y": 605,
      "width": 1120,
      "height": 55,
      "angle": 0,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785979775708,
      "link": null,
      "locked": false,
      "text": "No shared schema means no single corruption event can cross domains. No shared thread pool means one slow\ndependency can't starve the others. Different mechanism, same shape of fix: shrink the blast radius to one box.\nAdrian Cockcroft, Netflix cloud architect: \"we had a single data center, which meant we had a single point of failure.\"",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No shared schema means no single corruption event can cross domains. No shared thread pool means one slow\ndependency can't starve the others. Different mechanism, same shape of fix: shrink the blast radius to one box.\nAdrian Cockcroft, Netflix cloud architect: \"we had a single data center, which meant we had a single point of failure.\"",
      "lineHeight": 1.3
    }
  ],

      "text": "Netflix Looked at a 3-Day Outage and Deleted the Idea of Having One Datacenter",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Netflix Looked at a 3-Day Outage and Deleted the Idea of Having One Datacenter",
      "lineHeight": 1.25
    },
    {
      "id": "e_sub",
      "type": "text",
      "x": 30,
      "y": 54,
      "width": 1140,
      "height": 20,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785979775708,
      "link": null,
      "locked": false,
      "text": "Aug 2008 - Jan 2016 — how one corrupted Oracle database pushed Netflix off a single datacenter and onto hundreds of independently-failing microservices",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aug 2008 - Jan 2016 — how one corrupted Oracle database pushed Netflix off a single datacenter and onto hundreds of independently-failing microservices",
      "lineHeight": 1.25
    },

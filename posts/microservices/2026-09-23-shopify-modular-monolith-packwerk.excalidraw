      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What most retellings skip: Packwerk enforces TWO checks -- dependency AND privacy.\nPrivacy was never meant to be the main feature. Years later, Shopify's own retrospective\nadmits the tech debt from privacy checking still isn't close to paid off.",
      "fontSize": 12.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What most retellings skip: Packwerk enforces TWO checks -- dependency AND privacy.\nPrivacy was never meant to be the main feature. Years later, Shopify's own retrospective\nadmits the tech debt from privacy checking still isn't close to paid off.",
      "lineHeight": 1.3
    },

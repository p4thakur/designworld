      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "BEFORE — 2006-2010\nRAILS BACKEND\n\nRuby MRI: one\nthread runs Ruby\ncode at a time\n(GIL)\n\n~200-300\nreq/s per host\n\nThe Fail Whale.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BEFORE — 2006-2010\nRAILS BACKEND\n\nRuby MRI: one\nthread runs Ruby\ncode at a time\n(GIL)\n\n~200-300\nreq/s per host\n\nThe Fail Whale.",
      "lineHeight": 1.25
    },

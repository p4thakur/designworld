      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE REAL DIAGNOSIS\n(Twitter, 2011)\n\n\"Dozens of network\nservices speaking\nmany different\nprotocols\"\n\n\"Poor interaction\nbetween components\nin the presence\nof failures\"\n\nNot a speed\nproblem. A failure-\ninteraction problem.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE REAL DIAGNOSIS\n(Twitter, 2011)\n\n\"Dozens of network\nservices speaking\nmany different\nprotocols\"\n\n\"Poor interaction\nbetween components\nin the presence\nof failures\"\n\nNot a speed\nproblem. A failure-\ninteraction problem.",
      "lineHeight": 1.25
    },

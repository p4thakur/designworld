      "width": 230,
      "height": 210,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "RESULT — 2011+\nOPEN SOURCED\n\n~10,000-20,000\nreq/s per host\n\nShipped first in\nURL crawler +\nHTTP proxy\n\nFailure-handling\nreused across\nevery service.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RESULT — 2011+\nOPEN SOURCED\n\n~10,000-20,000\nreq/s per host\n\nShipped first in\nURL crawler +\nHTTP proxy\n\nFailure-handling\nreused across\nevery service.",
      "lineHeight": 1.25
    },
    {
      "id": "footnote",
      "type": "text",
      "x": 40,
      "y": 380,
      "width": 1278,
      "height": 40,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Twitter didn't rewrite the slow server. It made client and server the same abstraction, so retries, timeouts, and pooling became one Filter instead of one per team.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Twitter didn't rewrite the slow server. It made client and server the same abstraction, so retries, timeouts, and pooling became one Filter instead of one per team.",
      "lineHeight": 1.25
    }

      "locked": false,
      "text": "Twitter Finagle: Fixing How Services Fail Together, Not How Fast One Runs",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Twitter Finagle: Fixing How Services Fail Together, Not How Fast One Runs",

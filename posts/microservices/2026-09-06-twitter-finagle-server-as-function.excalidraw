      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE DECISION — 2010\nFINAGLE\n\nService = Request\n=> Future[Response]\n\nClient and server:\nthe same function\n\nRetry/timeout/pool\n= a reusable Filter,\nwritten once.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE DECISION — 2010\nFINAGLE\n\nService = Request\n=> Future[Response]\n\nClient and server:\nthe same function\n\nRetry/timeout/pool\n= a reusable Filter,\nwritten once.",
      "lineHeight": 1.25
    },
